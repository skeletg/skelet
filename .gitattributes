# Lock line endings to LF for every text file, regardless of OS-level
# git config (Windows defaults to core.autocrlf=true which would otherwise
# convert LF→CRLF on checkout in WSL/Linux working trees).
* text=auto eol=lf

# Explicit bins/configs that must stay LF + executable in containers.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.go        text eol=lf
*.sql       text eol=lf
*.graphqls  text eol=lf
*.graphql   text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf

# Binary assets - never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
