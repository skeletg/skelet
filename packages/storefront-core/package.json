{
  "name": "@skelet/storefront-core",
  "version": "0.0.0",
  "description": "A Skelet storefront's logic with no framework in it: the GraphQL client, every operation with its types, and the reads and actions behind each page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeletg/skelet.git",
    "directory": "packages/storefront-core"
  },
  "homepage": "https://github.com/skeletg/skelet/tree/main/packages/storefront-core#readme",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../publish.mjs build",
    "prepack": "node ../publish.mjs build",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@conform-to/zod": "^1.21.1",
    "@graphql-typed-document-node/core": "catalog:",
    "graphql": "catalog:",
    "libphonenumber-js": "^1.13.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/near-operation-file-preset": "^5.2.2",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  }
}
