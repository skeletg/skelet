{
  "name": "@skelet/storefront-next",
  "version": "0.0.0",
  "description": "The Next.js adapter over @skelet/storefront-core - server reads and actions for an App Router storefront",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeletg/skelet.git",
    "directory": "packages/storefront-next"
  },
  "homepage": "https://github.com/skeletg/skelet/tree/main/packages/storefront-next#readme",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node ../publish.mjs build",
    "prepack": "node ../publish.mjs build",
    "test": "vitest run"
  },
  "dependencies": {
    "@skelet/storefront-core": "workspace:*",
    "graphql": "catalog:",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  }
}
