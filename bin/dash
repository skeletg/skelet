#!/usr/bin/env bash
# pnpm inside the dashboard container - bin/dash install / run codegen / run lint
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib

if [ ! -f apps/dashboard/package.json ]; then
    echo "apps/dashboard is not in this checkout (removed by ./skelet setup app selection)." >&2
    echo "Bring it back with: ./skelet setup --all (or --apps ...)" >&2
    exit 1
fi

# Host pnpm when this clone has a host install - the container keeps node_modules in its own volume,
# and running the gates against a different tree than the dev server is how the two silently diverge
# (host_tree in bin/_lib says why an empty node_modules counts as no install)
if [ -z "${SKELET_FORCE_DOCKER:-}" ]; then
    case "$(host_tree apps/dashboard)" in
        npm)  npm_tree_hint apps/dashboard; exit 1 ;;
        pnpm) if command -v pnpm >/dev/null 2>&1; then cd apps/dashboard && exec pnpm "$@"; fi ;;
    esac
fi

tty_flag=()
[ -t 0 ] && tty_flag=(-it)

if docker compose ps --status running | grep -q "skelet-dashboard"; then
    docker compose exec "${tty_flag[@]}" "${USER_FLAG[@]}" dashboard pnpm "$@"
else
    docker compose run --rm "${tty_flag[@]}" "${USER_FLAG[@]}" dashboard pnpm "$@"
fi
