#!/usr/bin/env bash
# Copies the email send log from the signals database into the commerce one, for an install that
# predates the move. Run it AFTER the commerce migration creates the table and BEFORE the signals
# migration drops the source, i.e. between `migrate up` and `migrate-signals up`.
#
# Re-runnable: rows already present are skipped on the primary key, so a partial run resumes.
# Copying nothing is survivable - the log is engagement history, and the pixel/click path only
# ever reads the last 90 days.
set -euo pipefail
cd "$(dirname "$(dirname "$0")")"

docker compose exec -T app sh -c '
    test -n "$DATABASE_URL"    || { echo "DATABASE_URL unset" >&2; exit 1; }
    test -n "$SIGNALS_DB_URL"  || { echo "SIGNALS_DB_URL unset" >&2; exit 1; }

    if ! psql "$SIGNALS_DB_URL" -tAc "SELECT to_regclass('"'"'public.email_sends'"'"')" | grep -q email_sends; then
        echo "no email_sends in the signals database - nothing to move"
        exit 0
    fi

    before=$(psql "$SIGNALS_DB_URL" -tAc "SELECT count(*) FROM email_sends")
    echo "copying $before rows"

    # Streamed rather than dumped: the source is partitioned and pg_dump would carry its month
    # partitions across, where the destination makes its own
    psql "$SIGNALS_DB_URL" -c "COPY (SELECT id, channel_id, source, customer_id, email, campaign_id,
            recipient_id, variant, flow_id, flow_run_id, flow_node_id, message_key, order_id,
            sent_at, first_open_at, first_click_at FROM email_sends) TO STDOUT" \
      | psql "$DATABASE_URL" -c "COPY email_sends (id, channel_id, source, customer_id, email, campaign_id,
            recipient_id, variant, flow_id, flow_run_id, flow_node_id, message_key, order_id,
            sent_at, first_open_at, first_click_at) FROM STDIN"

    after=$(psql "$DATABASE_URL" -tAc "SELECT count(*) FROM email_sends")
    echo "commerce email_sends now holds $after rows"
'
