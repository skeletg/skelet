#!/usr/bin/env bash
# Search the ClickHouse log store (the `logs` profile) - everything after the
# script name is a WHERE clause; no argument tails the last 50 lines
#
#   bin/logs-query                                  # recent everything
#   bin/logs-query "level = 'error'"
#   bin/logs-query "container = 'skelet-app-1' AND message ILIKE '%checkout%'"
#   bin/logs-query "timestamp > now() - INTERVAL 15 MINUTE AND level != 'info'"
#
# `bin/logs` still tails live containers - this is for history, which survives
# the json-file rotation cap that would otherwise be the retention policy
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib

WHERE="${*:-1}"
docker compose exec -T clickhouse clickhouse-client \
    --user="${CLICKHOUSE_USER:-skelet}" --password="${CLICKHOUSE_PASSWORD:-skelet}" \
    --query "SELECT timestamp, container, level, source, message
             FROM logs.container_logs
             WHERE ${WHERE}
             ORDER BY timestamp DESC
             LIMIT ${LOGS_LIMIT:-50}
             FORMAT PrettyCompact"
