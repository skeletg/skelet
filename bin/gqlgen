#!/usr/bin/env bash
# gqlgen inside the app container - bin/codegen drives it, this is for a single config
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib

# No arguments means both surfaces, as bin/codegen runs them
if [ $# -eq 0 ]; then
    "$0" generate --config gqlgen.admin.yml
    exec "$0" generate --config gqlgen.front.yml
fi

if docker compose ps --status running | grep -q "skelet-app"; then
    docker compose exec "${USER_FLAG[@]}" app go tool github.com/99designs/gqlgen "$@"
else
    docker compose run --rm --no-deps "${USER_FLAG[@]}" app go tool github.com/99designs/gqlgen "$@"
fi
