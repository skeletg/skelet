#!/usr/bin/env bash
# Chown root-owned strays under apps/ back to you. bin/fixperms [--all]
set -e
cd "$(dirname "$(dirname "$0")")"

uid=$(id -u)
gid=$(id -g)
mode="${1:-scan}"

case "$mode" in
    scan|--scan|"")
        # Scan first - only ask for sudo when there's actually something to fix
        echo "==> Scanning apps/ for files not owned by $(id -un)…"
        offenders=()
        while IFS= read -r f; do offenders+=("$f"); done < <(find apps ! -user "$uid" 2>/dev/null)
        if [ "${#offenders[@]}" -eq 0 ]; then
            echo "    All clean."
            exit 0
        fi
        echo "    Found ${#offenders[@]} entries (showing first 20):"
        printf '    %s\n' "${offenders[@]:0:20}"
        echo
        echo "==> Repairing ownership (sudo)…"
        sudo find apps -not -user "$uid" -exec chown "$uid:$gid" {} +
        echo "    Done."
        ;;
    --all|all)
        echo "==> Blanket chown apps/ → $(id -un):$(id -gn) (sudo)…"
        sudo chown -R "$uid:$gid" apps
        echo "    Done."
        ;;
    -h|--help|help)
        awk 'NR == 1 { next } /^set / { exit } /^#/ { sub(/^#[ ]?/, ""); print }' "$0"
        ;;
    *)
        echo "Unknown mode: $mode" >&2
        echo "Run 'bin/fixperms --help' for usage." >&2
        exit 2
        ;;
esac
