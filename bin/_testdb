#!/usr/bin/env bash
# Disposable test databases, shared by bin/test and bin/test-e2e - sourced, not run
#
# testdb.Require refuses any database without the skelet.e2e marker, because database-backed tests write
# real rows, and the dev databases never carry it. So a suite that wants those tests to run brings its own
# database: created here, marked here, and the dev ones re-unmarked so a stray go test against dev refuses

# psql as the instance superuser against the always-present maintenance DB, so
# we can CREATE/DROP the target - ON_ERROR_STOP so a failure isn't swallowed
admin_sql() { # <service> <sql>
    docker compose exec -T "$1" psql -U skelet -d postgres -v ON_ERROR_STOP=1 -tAc "$2"
}

db_exists() { # <service> <dbname>
    [ "$(admin_sql "$1" "SELECT 1 FROM pg_database WHERE datname='$2'")" = "1" ]
}

ensure_pg_db() { # <service> <dbname> <fresh: true|false>
    if $3 && db_exists "$1" "$2"; then
        echo "==> dropping $2"
        admin_sql "$1" "DROP DATABASE $2 WITH (FORCE)" >/dev/null
    fi
    if ! db_exists "$1" "$2"; then
        echo "==> creating $2"
        admin_sql "$1" "CREATE DATABASE $2" >/dev/null
    fi
    # The disposable marker testdb.Require gates on - takes effect on new connections, so it's set before migrate/test connect
    admin_sql "$1" "ALTER DATABASE $2 SET skelet.e2e = 'allowed'" >/dev/null
}

ch_sql() { docker compose exec -T clickhouse clickhouse-client --user=skelet --password=skelet --query "$1"; }

ensure_ch_db() { # <dbname> <fresh: true|false>
    if $2; then
        ch_sql "DROP DATABASE IF EXISTS $1" >/dev/null
    fi
    ch_sql "CREATE DATABASE IF NOT EXISTS $1" >/dev/null
    ch_sql "ALTER DATABASE $1 MODIFY COMMENT 'skelet.e2e=allowed'" >/dev/null
}

drop_ch_clones() { # <template>
    local names
    names="$(ch_sql "SELECT name FROM system.databases WHERE startsWith(name, '${1}__pkg')")"
    [ -n "$names" ] || return 0
    docker compose exec -T clickhouse clickhouse-client --user=skelet --password=skelet --multiquery \
        --query "$(printf 'DROP DATABASE IF EXISTS `%s`;' $names)" >/dev/null
}

# Keep the dev DBs unmarked so a stray `go test` against dev refuses instead of writing test rows
unmark_dev_dbs() {
    admin_sql db "ALTER DATABASE skelet RESET skelet.e2e" >/dev/null || true
    admin_sql signals-db "ALTER DATABASE skelet_signals RESET skelet.e2e" >/dev/null || true
}

# The per-package clones testdb makes from a template - throwaways of a throwaway, swept before every run
# One psql for the lot, fed on stdin so each DROP runs on its own as it must - an exec per clone was most of setup
drop_clones() { # <service> <template>
    local names
    names="$(admin_sql "$1" "SELECT datname FROM pg_database WHERE datname LIKE '${2}\_\_pkg%'")"
    [ -n "$names" ] || return 0
    printf 'DROP DATABASE "%s" WITH (FORCE);\n' $names | docker compose exec -T "$1" psql -U skelet -d postgres -v ON_ERROR_STOP=1 -q >/dev/null
}

service_running() { # <service>
    docker compose ps --status running --services 2>/dev/null | grep -qx "$1"
}

# One run per suite and checkout, or a second run's DROP ... WITH (FORCE) pulls the databases from under the first - mkdir is the atomic lock
acquire_test_lock() { # <suite>
    TESTDB_LOCK="${TMPDIR:-/tmp}/skelet-$1-$(printf '%s' "$PWD" | cksum | cut -d' ' -f1).lock"
    if ! mkdir "$TESTDB_LOCK" 2>/dev/null; then
        local holder
        holder="$(cat "$TESTDB_LOCK/pid" 2>/dev/null || true)"
        if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
            echo "another $1 run (pid $holder) is using the test databases - wait for it to finish" >&2
            exit 1
        fi
        mkdir "$TESTDB_LOCK.takeover" 2>/dev/null || { echo "another $1 run just started - wait for it to finish" >&2; exit 1; }
        if [ "$(cat "$TESTDB_LOCK/pid" 2>/dev/null || true)" != "$holder" ]; then
            rmdir "$TESTDB_LOCK.takeover"
            echo "another $1 run just started - wait for it to finish" >&2
            exit 1
        fi
        rm -rf "$TESTDB_LOCK"
        mkdir "$TESTDB_LOCK"
        rmdir "$TESTDB_LOCK.takeover"
    fi
    echo "$$" > "$TESTDB_LOCK/pid"
}

release_test_lock() {
    [ -n "${TESTDB_LOCK:-}" ] && rm -rf "$TESTDB_LOCK"
    return 0
}
