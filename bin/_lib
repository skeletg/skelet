#!/usr/bin/env bash
# Shared env for every bin/* wrapper - compose files, profiles, uid, locale
export LC_ALL=C.UTF-8 LANG=C.UTF-8

# No COMPOSE_FILE needed - docker-compose.yml is the whole dev stack and compose auto-merges
# docker-compose.override.yml, where your own git-ignored services live
_skelet_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Which apps run IN DOCKER - .skelet-apps if there is one, else NONE The frontends default to the host, where the dev server and the gates share one node_modules - two installs from one lockfile drift silently, and the container adds nothing Node needs
if [ -f "$_skelet_root/.skelet-apps" ]; then
    SKELET_APPS="$(tr -d '[:space:]' < "$_skelet_root/.skelet-apps")"
else
    SKELET_APPS=""
fi

# Sidecar profiles - bin/dev --lean empties SKELET_SIDECARS
_skelet_sidecars="${SKELET_SIDECARS-search,tracing}"
_skelet_profiles="$_skelet_sidecars"
if [ -n "$SKELET_APPS" ]; then
    _skelet_profiles="${_skelet_profiles:+$_skelet_profiles,}$SKELET_APPS"
fi

# The Signals process follows core's switch - SIGNALS_ENABLED lives in the backend env and unset
# means on, as the backend reads it. A sidecar, so --lean drops it with the others
if [ -n "$_skelet_sidecars" ] && ! grep -qiE '^[[:space:]]*SIGNALS_ENABLED[[:space:]]*=[[:space:]]*(false|0|f|no|off)[[:space:]]*$' "$_skelet_root/env/go.env" 2>/dev/null; then
    _skelet_profiles="${_skelet_profiles:+$_skelet_profiles,}signals"
fi

export COMPOSE_PROFILES="${COMPOSE_PROFILES-$_skelet_profiles}"

# exec/run flags - pin the locale (exec env inheritance is flaky on Desktop)
# SKELET_NO_USER_MAP=1 runs as root for the odd apt-get moment
if [ -n "${SKELET_NO_USER_MAP:-}" ]; then
    USER_FLAG=(-u 0:0 -e LC_ALL=C.UTF-8 -e LANG=C.UTF-8)
else
    USER_FLAG=(-e LC_ALL=C.UTF-8 -e LANG=C.UTF-8)
fi

# The uid containers run as (compose user:)
# Rootless engines stick with 0 - container root already IS you there
if [ -z "${SKELET_UID:-}" ]; then
    if docker info -f '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then
        export SKELET_UID=0 SKELET_GID=0
    else
        export SKELET_UID="$(id -u)" SKELET_GID="$(id -g)"
    fi
fi

# What a frontend's node_modules on the HOST holds: none, pnpm, or npm - the last a tree from
# before the switch to pnpm, which pnpm refuses to take over without a TTY to confirm the wipe
#
# An EMPTY directory is none: the container mounts its named volume at node_modules, and because
# the parent is a bind mount that leaves an empty directory on the host - testing -d alone would
# send every later install to a host tree the dev server never reads
host_tree() { # host_tree <app dir>
    if [ -z "$(ls -A "$1/node_modules" 2>/dev/null)" ]; then
        echo none
    elif [ -f "$1/node_modules/.modules.yaml" ]; then
        echo pnpm
    else
        echo npm
    fi
}

# Why pnpm can't run this app, or nothing when it can. Asked from inside the app, where pnpm
# switches itself to packageManager's version - the switch is what breaks, so asking from the
# root would pass on a pnpm the app can't run
pnpm_problem() { # pnpm_problem <app dir>
    local want have
    want="$(grep -oE '"packageManager": *"pnpm@[0-9.]+' "$1/package.json" 2>/dev/null | sed 's/.*@//')"
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "no pnpm on PATH - corepack enable, or npm install -g pnpm@${want:-<version>}"
        return
    fi
    [ -n "$want" ] || return 0
    have="$(cd "$1" && pnpm --version 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+$')" || true
    [ "$have" = "$want" ] \
        || echo "pnpm in $1 answers ${have:-nothing}, the app pins $want - pnpm self-update $want"
}

npm_tree_hint() { # npm_tree_hint <app dir>
    echo "$1/node_modules is an npm install from before the switch to pnpm - replace it:" >&2
    echo "    rm -rf $1/node_modules && (cd $1 && pnpm install)" >&2
}

# env/signals.env from its template, with the two secrets it must share with core copied from env/go.env
sync_signals_env() {
    local go="$_skelet_root/env/go.env" sig="$_skelet_root/env/signals.env" key val tmp
    [ -f "$go" ] || return 0
    if [ ! -f "$sig" ]; then
        cp "$_skelet_root/env/signals.env.example" "$sig"
        echo "==> wrote env/signals.env from its template"
    fi
    for key in JWT_SECRET SIGNALS_SERVICE_SECRET; do
        val="$(grep -E "^${key}=" "$go" | head -1 | cut -d= -f2-)"
        [ -n "$val" ] || continue
        tmp="$sig.tmp.$$"
        _k="$key" _v="$val" awk 'BEGIN { k = ENVIRON["_k"]; v = ENVIRON["_v"] }
            index($0, k "=") == 1 { print k "=" v; done = 1; next } { print }
            END { if (!done) print k "=" v }' "$sig" > "$tmp" && cat "$tmp" > "$sig"
        rm -f "$tmp"
    done
}
