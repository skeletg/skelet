#!/usr/bin/env bash
# A frontend dev server on the HOST: bin/serve [dashboard|<channel>] [-- npm args]
#
# Exists so the channel id lives in ONE place. Next reads .env files from its own directory and
# will not look up at the repo root, so without this the storefront needs a second copy of
# STOREFRONT_CHANNEL_ID in apps/channels/<name>/.env.local - which then drifts from the root .env
# compose reads
set -e
cd "$(dirname "$(dirname "$0")")"

app="${1:-}"
[ $# -gt 0 ] && shift

usage() {
    echo "usage: bin/serve <app> [npm args]" >&2
    echo "  dashboard$(for d in apps/channels/*/package.json; do [ -f "$d" ] && printf ', %s' "$(basename "$(dirname "$d")")"; done)" >&2
    exit 2
}

case "$app" in
    dashboard) dir="apps/dashboard"; port=5173 ;;
    "")        usage ;;
    *)         dir="apps/channels/$app"; port=3000
               [ -d "$dir" ] || { echo "No such app: $app" >&2; usage; } ;;
esac
[ -f "$dir/package.json" ] || { echo "$dir has no package.json - see bin/setup" >&2; exit 1; }

# The root .env is where compose reads these from, so the host reads the same file
set -a
# shellcheck disable=SC1091
[ -f .env ] && . ./.env
set +a

# Dev defaults matching the compose service, applied only when the root .env is silent
: "${NEXT_PUBLIC_BACKEND_URL:=http://localhost:8080}"
: "${STOREFRONT_REVALIDATE_SECRET:=dev-revalidate-secret-change-me}"
export NEXT_PUBLIC_BACKEND_URL STOREFRONT_REVALIDATE_SECRET

# A container on the same port is the confusing failure - the dev server picks another and nothing
# tells you why the page you opened is stale
if docker compose ps --services --status running 2>/dev/null | grep -qx "$app"; then
    echo "The $app container is running and holds port $port - stop it first: docker compose stop $app" >&2
    exit 1
fi

[ -d "$dir/node_modules" ] || { echo "==> installing $app deps"; (cd "$dir" && npm ci); }

echo "==> $app on the host (http://localhost:$port)"
cd "$dir" && exec npm run dev -- "$@"
