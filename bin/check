#!/usr/bin/env bash
# Every gate that can fail your commit, in one command. This is what the pre-commit
# hook and CI both run, so "bin/check passes" is the whole contract
#
# About a second, no running backend - only contract-check's proto step uses the app container (skipped when down); codegen staleness is --codegen
usage() {
    cat <<'EOF'
bin/check [--codegen] [--list]

  (no flags)  the three fast gates - what the pre-commit hook and CI run
  --codegen   also regenerate and diff (needs the container; add the backend for the TS half)
  --list      print what each gate is for and exit

Each gate is also runnable on its own - see docs/scripts.md.
EOF
}

# name|what it protects|the script
GATES=(
    "pins|one version per pin across the compose files, Dockerfiles and workflows|bin/pin-check"
    "structure|bin/* parse and are executable, env templates exist|bin/repo-check"
    "contracts|the SYNC sentinels: lists that must agree across backend, dashboard and storefront|bin/contract-check"
)

codegen=0
for arg in "$@"; do
    case "$arg" in
        --codegen) codegen=1 ;;
        --list)
            for g in "${GATES[@]}"; do
                IFS='|' read -r name what script <<< "$g"
                printf '  %-10s %-19s %s\n' "$name" "$script" "$what"
            done
            printf '  %-10s %-19s %s\n' "codegen" "bin/codegen" "generated files match their sources (--codegen only)"
            exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown flag: $arg"; usage; exit 2 ;;
    esac
done

cd "$(dirname "$(dirname "$0")")"

failed=()
for g in "${GATES[@]}"; do
    IFS='|' read -r name what script <<< "$g"
    printf '\n>>> %s (%s)\n' "$name" "$what"
    "$script" || failed+=("$script")
done

# Last because it's the slow one, and because a stale-codegen failure is the only one
# here you fix by running a command rather than editing a file
if [ "$codegen" = 1 ]; then
    printf '\n>>> codegen (generated files match their sources)\n'
    bin/codegen --check || failed+=("bin/codegen --check")
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
    echo "bin/check: all gates passed"
    exit 0
fi
echo "bin/check: ${#failed[@]} gate(s) failed - ${failed[*]}"
echo "Each prints what to change; rerun the single one while you fix it."
exit 1
