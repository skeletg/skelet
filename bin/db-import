#!/usr/bin/env bash
# Restore a dump over the dev DB - OVERWRITES it. bin/db-import [-y] <file.dump|file.sql>
set -e
orig_pwd="$PWD"
cd "$(dirname "$(dirname "$0")")"

force=
if [ "$1" = "-y" ] || [ "$1" = "--yes" ]; then force=1; shift; fi

file="$1"
if [ -z "$file" ]; then
    echo "usage: bin/db-import [-y] <file.dump|file.sql>" >&2
    exit 1
fi
case "$file" in /*) ;; *) file="$orig_pwd/$file" ;; esac
if [ ! -f "$file" ]; then
    echo "no such file: $file" >&2
    exit 1
fi

if [ -z "$force" ]; then
    if [ -e /dev/tty ]; then
        printf 'This OVERWRITES the dev database (skelet) with %s. Continue? [y/N] ' "$file"
        read -r ans < /dev/tty
        case "$ans" in y | Y | yes | YES) ;; *) echo "aborted"; exit 1 ;; esac
    else
        echo "refusing to overwrite without a terminal - re-run with -y to confirm" >&2
        exit 1
    fi
fi

case "$file" in
    *.sql) docker compose exec -T db psql -U skelet -d skelet < "$file" ;;
    *)     docker compose exec -T db pg_restore -U skelet -d skelet --clean --if-exists --no-owner < "$file" ;;
esac
echo "imported ← $file"
