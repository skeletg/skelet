#!/usr/bin/env bash
# The changelog - one file per release under changelog/, CHANGELOG.md as their index, and pending
# entries as fragments in changelog/unreleased/ so two branches never edit the same lines
#
#   bin/changelog                           the pending entries, assembled as the next release would print them
#   bin/changelog check                     fragments are well-formed and the index matches the release files
#   bin/changelog release <version> [date]  write changelog/<version>.md, list it, delete the fragments
#
# A fragment is changelog/unreleased/<slug>.<section>.md holding one or more "- " entries, where section is
# added, changed, deprecated, removed, fixed or security - or summary, a paragraph that opens the release
set -euo pipefail
cd "$(dirname "$(dirname "$0")")"

dir=changelog/unreleased
releases=changelog
index=CHANGELOG.md
repo=https://github.com/skeletg/skelet
# Keep a Changelog's order, which is the order a release prints them in
sections="added changed deprecated removed fixed security"

title() { printf '%s' "$(printf '%.1s' "$1" | tr '[:lower:]' '[:upper:]')${1#?}"; }

fragments() { # fragments SECTION - the section's files, sorted, one per line
    local f
    for f in "$dir"/*."$1".md; do
        [ -f "$f" ] && printf '%s\n' "$f"
    done
    return 0
}

trimmed() { sed -e '/./,$!d' "$1" | awk '{ l[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print l[i] }'; }

assemble() {
    local s f out="" body
    while IFS= read -r f; do
        [ -n "$f" ] && out="$out$(trimmed "$f")"$'\n\n'
    done <<< "$(fragments summary)"
    for s in $sections; do
        body=""
        while IFS= read -r f; do
            [ -n "$f" ] && body="$body$(trimmed "$f")"$'\n\n'
        done <<< "$(fragments "$s")"
        [ -n "$body" ] && out="$out### $(title "$s")"$'\n\n'"$body"
    done
    printf '%s' "$out"
}

listed() { grep -oE '^- \[[0-9]+\.[0-9]+\.[0-9]+\]\(changelog/[0-9.]+\.md\)' "$index" | sed -E 's/^- \[([0-9.]+)\].*/\1/'; }

check() {
    local fail=0 f base sec v
    bad() { fail=1; printf '  FAIL  %s\n' "$1"; }
    for f in "$dir"/*; do
        [ -e "$f" ] || continue
        base="$(basename "$f")"
        [ "$base" = README.md ] && continue
        if ! printf '%s' "$base" | grep -qE '^[a-z0-9][a-z0-9-]*\.[a-z]+\.md$'; then
            bad "$f - name it <slug>.<section>.md, e.g. filesystem-storage.added.md"
            continue
        fi
        sec="${base%.md}"; sec="${sec##*.}"
        case " $sections summary " in
            *" $sec "*) ;;
            *) bad "$f - \"$sec\" is not one of: $sections summary"; continue ;;
        esac
        if grep -qE '^#' "$f"; then
            bad "$f - no headings, the section comes from the file name"
        elif [ "$sec" != summary ] && [ "$(grep -m1 . "$f" | cut -c1-2)" != "- " ]; then
            bad "$f - must start with a \"- \" entry"
        fi
    done
    # Anything written straight into the index brings back the merge conflicts fragments exist to remove
    if awk '/^## \[Unreleased\]/ { on = 1; next } /^## / { on = 0 } on && (/^### / || /^- /) { found = 1 } END { exit !found }' "$index"; then
        bad "$index has entries under [Unreleased] - move them into $dir/"
    fi
    for f in "$releases"/*.md; do
        [ -e "$f" ] || continue
        v="$(basename "$f" .md)"
        listed | grep -qxF "$v" || bad "$f is not listed under Releases in $index"
    done
    for v in $(listed); do
        [ -f "$releases/$v.md" ] || bad "$index lists $v, but $releases/$v.md does not exist"
    done
    [ "$fail" -eq 0 ] && printf '  ok    %s fragments well-formed, %s releases listed, Unreleased empty\n' \
        "$(find "$dir" -name '*.md' ! -name README.md | wc -l | tr -d ' ')" "$(listed | wc -l | tr -d ' ')"
    return "$fail"
}

release() {
    local version="${1:-}" date="${2:-$(date +%Y-%m-%d)}" body prev out tmp s f
    printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "bin/changelog release <x.y.z> [YYYY-MM-DD]" >&2; exit 2; }
    out="$releases/$version.md"
    [ -e "$out" ] && { echo "$out already exists" >&2; exit 1; }
    check > /dev/null || { check; exit 1; }
    body="$(assemble)"
    [ -n "$body" ] || { echo "no fragments in $dir/ - nothing to release" >&2; exit 1; }
    prev="$(listed | head -1)"
    {
        printf '# [%s] - %s\n\n%s\n\n' "$version" "$date" "$body"
        if [ -n "$prev" ]; then
            printf '[%s]: %s/compare/v%s...v%s\n' "$version" "$repo" "$prev" "$version"
        else
            printf '[%s]: %s/releases/tag/v%s\n' "$version" "$repo" "$version"
        fi
    } > "$out"
    tmp="$index.tmp.$$"
    awk -v v="$version" -v d="$date" -v repo="$repo" '
        /^## Releases/ { print; getline; print; print "- [" v "](changelog/" v ".md) - " d; next }
        /^\[Unreleased\]: / { print "[Unreleased]: " repo "/compare/v" v "...develop"; next }
        { print }
    ' "$index" > "$tmp"
    cat "$tmp" > "$index" && rm -f "$tmp"
    git add "$out" 2>/dev/null || true
    for s in summary $sections; do
        while IFS= read -r f; do
            [ -n "$f" ] && { git rm -q "$f" 2>/dev/null || rm -f "$f"; }
        done <<< "$(fragments "$s")"
    done
    echo "$out written and listed in $index, fragments removed - review the diff, then commit"
}

case "${1:-}" in
    ""|preview)
        out="$(assemble)"
        if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "(no pending entries in $dir/)"; fi ;;
    check)   echo "==> changelog"; check ;;
    release) shift; release "$@" ;;
    -h|--help) awk 'NR == 1 { next } /^set / { exit } { sub(/^#[ ]?/, ""); print }' "$0" ;;
    *) echo "bin/changelog [preview | check | release <version> [date]]" >&2; exit 2 ;;
esac
