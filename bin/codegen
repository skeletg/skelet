#!/usr/bin/env bash
export LC_ALL=C.UTF-8 LANG=C.UTF-8
# Regen everything: sqlc -> buf -> gqlgen -> plugin bridge -> TS docs (backend must be up) --check bails on stale output;
# --no-frontend drops the two steps that need a live backend, which is the half CI can run - same flag name as bin/test
set -e
cd "$(dirname "$(dirname "$0")")"

mode="generate"
frontend=1
while [ $# -gt 0 ]; do
    case "$1" in
        --check) mode="check" ;;
        --no-frontend) frontend=0 ;;
        *) echo "Unknown flag: $1 (try --check, --no-frontend)"; exit 2 ;;
    esac
    shift
done

# What --check diffs - files mixing hand-written code (*.resolvers.go *.gql.ts) stay out
GENERATED_PATHS=(
    'apps/backend/core/plugins/firstparty/'
    'apps/backend/core/graph/admin/plugin_resolvers.go'
    'apps/backend/core/graph/front/plugin_resolvers.go'
    'apps/backend/core/internal/db/sqlc/'
    'apps/backend/signals/internal/db/sqlc/'
    'apps/backend/core/signalsapi/v1/'
    'apps/backend/core/graph/admin/generated.go'
    'apps/backend/core/graph/admin/model/'
    'apps/backend/core/graph/front/generated.go'
    'apps/backend/core/graph/front/model/'
    'apps/backend/core/internal/remoteprovider/contract/'
    'apps/dashboard/nginx.conf.template'
    'deploy/caddy/Caddyfile'
    'docs/permissions.md'
    'docs/webhooks.md'
    'docs/settings.md'
    'apps/dashboard/src/graphql/schema.types.ts'
    'apps/dashboard/src/'
    # Every storefront, not the demo by name - --check compares this diff before
    # and against after, so a broad pathspec costs nothing and can't go stale
    'apps/channels/'
)
if [ "$mode" = "check" ]; then
    pre_hash=$(git diff -- "${GENERATED_PATHS[@]}" | sha256sum | cut -d' ' -f1)
fi

# The core-to-Signals wire contract, before anything that might use its types
echo "==> buf (signals grpc contract)"
bin/buf lint /var/www/proto
bin/buf generate --template /var/www/proto/buf.gen.yaml /var/www/proto

# Before gqlgen: the enabled set in plugins/plugins.json decides which plugins compile in, and is where the
# SDL list should be driven from too, instead of gqlgen globbing every directory under plugins/
echo "==> plugin set"
(cd apps/backend/core && go run ./cmd/plugingen)

echo "==> sqlc generate"
bin/sqlc generate

# Prune pass BEFORE gqlgen: a removed or disabled plugin leaves delegation files referencing model types its SDL took with it, and gqlgen type-checks the graph package before plugingraph would clean them - plugingraph itself only parses syntax, so it can run against the stale tree; the post-gqlgen run below then regenerates everything from the fresh schema
echo "==> plugin graph (prune)"
(cd apps/backend/core && go run ./cmd/plugingraph)

echo "==> gqlgen admin"
bin/gqlgen generate --config gqlgen.admin.yml

echo "==> gqlgen front"
bin/gqlgen generate --config gqlgen.front.yml

# Plugin SDL is merged by the globs in both gqlgen configs above. gqlgen stubs each plugin field; this turns those stubs into delegation through the runtime registry and writes the matching interfaces, so a plugin author writes SDL and a resolver in their own package and touches no core Go at all
echo "==> plugin graph"
(cd apps/backend/core && go run ./cmd/plugingraph)

# The published remote-provider contract, read out of the adapter structs themselves - a
# renamed payload type fails here instead of silently leaving integrators a stale schema
echo "==> remote provider contract"
(cd apps/backend/core && go run ./cmd/providerschema)

# The generated reference tables in docs/ - permissions, webhook events, settings - read back out of the code-defined
# registries after every domain init() has run, so each published list is whatever the server actually honours
echo "==> docs reference tables"
(cd apps/backend/core && go run ./cmd/docsref)

# The nginx and Caddy copies of the CSP and Permissions-Policy, rewritten from the constants in lib/httpx/securityheaders.go
# bin/contract-check re-verifies the same equality with plain greps, so a hand-edited copy still fails CI's toolchain-free gate
echo "==> security headers"
(cd apps/backend/core && go run ./cmd/secheadgen)

# The TS steps introspect a running server, so CI stops here - everything above needs
# nothing but Go and a container, which is the half that can gate every push
if [ "$frontend" = 0 ]; then
    if [ "$mode" = "check" ]; then
        post_hash=$(git diff -- "${GENERATED_PATHS[@]}" | sha256sum | cut -d' ' -f1)
        if [ "$pre_hash" = "$post_hash" ]; then
            echo "==> codegen check: clean (backend-side only, --no-frontend)"
            exit 0
        fi
        echo "==> codegen check: STALE - generated files changed:"
        git diff --name-only -- "${GENERATED_PATHS[@]}"
        echo
        echo "Run \`bin/codegen\`, stage the regenerated files, and commit again."
        exit 1
    fi
    echo "==> codegen complete (backend-side only, --no-frontend)"
    exit 0
fi

echo "==> dashboard codegen"
# Probe the real GraphQL endpoint - /health says ok before gqlgen handlers rewire after an Air rebuild
# ADMIN_API_SLUG moves that endpoint, so the probe has to follow it or it waits 30s and skips every time
admin_gql_probe="http://localhost:8080/api/admin/graphql"
admin_slug="$(sed -n 's/^ADMIN_API_SLUG=//p' .env 2>/dev/null | tail -n 1 | tr -d '\r')"
[ -n "$admin_slug" ] && admin_gql_probe="http://localhost:8080/api/admin/$admin_slug/graphql"
backend_ready=0
for _ in $(seq 1 30); do
    if curl -fsS --max-time 1 \
            -X POST -H 'Content-Type: application/json' \
            -d '{"query":"{__typename}"}' \
            "$admin_gql_probe" >/dev/null 2>&1; then
        backend_ready=1
        break
    fi
    sleep 1
done
# Air sometimes queues a second rebuild mid-run - re-probe and retry once
run_ts_codegen() {
    label="$1"; shift
    if "$@"; then return 0; fi
    echo "    $label codegen hit a backend restart; re-probing and retrying once..."
    for _ in $(seq 1 30); do
        if curl -fsS --max-time 1 \
                -X POST -H 'Content-Type: application/json' \
                -d '{"query":"{__typename}"}' \
                "$admin_gql_probe" >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    "$@"
}

if [ "$backend_ready" = 1 ]; then
    # Keyed on the SOURCE being here, not on .skelet-apps - that file picks which app containers
    # compose starts, and an app run on the host still wants its bindings fresh
    if [ -f apps/dashboard/package.json ]; then
        run_ts_codegen dashboard bin/dash run codegen
    else
        echo "    (skipped - dashboard source not in this checkout; see bin/setup)"
    fi
    echo "==> storefront codegen"
    found_sf=0
    for sf in apps/channels/*/package.json; do
        [ -f "$sf" ] || continue
        found_sf=1
        name="$(basename "$(dirname "$sf")")"
        run_ts_codegen "$name" bin/channel "$name" run codegen
    done
    [ "$found_sf" = 1 ] || echo "    (no storefronts in this checkout; see bin/setup)"
else
    echo "    Backend not reachable at http://localhost:8080/health after 30s."
    echo "    Start it with \`bin/dev\` and re-run \`bin/codegen\`."
    if [ "$mode" = "check" ]; then
        exit 1   # stale TS bindings are exactly what --check must catch
    fi
    echo "    Skipping dashboard + storefront codegen."
fi

if [ "$mode" = "check" ]; then
    post_hash=$(git diff -- "${GENERATED_PATHS[@]}" | sha256sum | cut -d' ' -f1)
    if [ "$pre_hash" = "$post_hash" ]; then
        echo "==> codegen check: clean"
    else
        echo "==> codegen check: STALE - generated files changed:"
        git diff --name-only -- "${GENERATED_PATHS[@]}"
        echo
        echo "Run \`bin/codegen\`, stage the regenerated files, and commit again."
        exit 1
    fi
else
    echo "==> codegen complete"
fi
