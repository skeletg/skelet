#!/usr/bin/env bash
# Poke at the local OpenSearch cluster - bin/opensearch help for commands
# Index names mirror internal/search/{products,blog}.go - keep them in sync
set -euo pipefail
cd "$(dirname "$(dirname "$0")")"

# The host port follows OPENSEARCH_HOST_PORT in .env, which bin/dev writes when 9200 was taken
os_port="${OPENSEARCH_HOST_PORT:-$(grep -E '^OPENSEARCH_HOST_PORT=[0-9]+$' .env 2>/dev/null | tail -1 | cut -d= -f2 || true)}"
HOST="${OPENSEARCH_HOST_URL:-http://localhost:${os_port:-9200}}"
PRODUCT_INDEX="products_v1"
BLOG_INDEX="blog_posts_v1"

have_jq() { command -v jq >/dev/null 2>&1; }
have_column() { command -v column >/dev/null 2>&1; }

usage() {
  cat <<EOF
bin/opensearch - query and inspect the local OpenSearch cluster

Usage:
  bin/opensearch <command> [args]

Commands:
  status                       Cluster health + index list w/ doc counts
  products <query> [flags]     Search products (top 10 by default)
  blog <query> [flags]         Search blog posts (top 10 by default)
  show products <id>           Every (channel, locale) doc for one product
  show blog <id>               Every (channel, locale) doc for one blog post
  raw <METHOD> <path> [body]   Arbitrary REST against the cluster
  help                         This help

Flags (products | blog):
  -n, --limit N                Number of hits (default 10)
  --json                       Raw OpenSearch JSON response
  --channel SLUG-OR-UUID       Filter to one channel (slug resolved via psql)
  --locale CODE                Filter to one locale (e.g. en, de)

Environment:
  OPENSEARCH_HOST_URL          Cluster URL (default http://localhost:9200)

Examples:
  bin/opensearch status
  bin/opensearch products plant
  bin/opensearch products plant -n 25 --channel us --locale en
  bin/opensearch blog guide --json
  bin/opensearch show products 768c29f9-485a-4842-b874-dadf5f40df0b
  bin/opensearch raw GET /_cluster/health
EOF
}

# fetch <method> <path> [body]
fetch() {
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -sS -X "$method" "$HOST$path" \
      -H "Content-Type: application/json" \
      -d "$body"
  else
    curl -sS -X "$method" "$HOST$path"
  fi
}

# resolve_channel takes a UUID (passed through) or a slug (looked up in channels)
resolve_channel() {
  local input="$1"
  if [[ "$input" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    echo "$input"
    return 0
  fi
  if [[ ! "$input" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Error: invalid channel slug '$input' (letters, digits, _ -)" >&2
    return 1
  fi
  local id
  id=$(docker compose exec -T db psql -U skelet -d skelet -tA \
    -c "SELECT id FROM channels WHERE slug = '$input' LIMIT 1" \
    2>/dev/null | tr -d '\r\n')
  if [ -z "$id" ]; then
    echo "Error: no channel with slug '$input' (try a UUID or check bin/psql)" >&2
    return 1
  fi
  echo "$id"
}

# build_search_body <index> <query> <limit> <channel_uuid|""> <locale|"">
# Mirrors the storefront resolver's query shape so results match the live UI
build_search_body() {
  local index="$1" query="$2" limit="$3" channel="$4" locale="$5"
  local fields
  if [ "$index" = "$PRODUCT_INDEX" ]; then
    fields='"name^3","sku^2","description"'
  else
    fields='"title^3","excerpt^2","body"'
  fi
  local filters=""
  if [ -n "$channel" ]; then
    filters="${filters}{\"term\":{\"channel_id\":\"$channel\"}},"
  fi
  if [ -n "$locale" ]; then
    filters="${filters}{\"term\":{\"locale\":\"$locale\"}},"
  fi
  # Trim the trailing comma so the JSON stays valid with zero filters
  filters="${filters%,}"
  # jq escapes the query safely - quotes/backslashes would break the JSON
  local escaped_query
  if have_jq; then
    escaped_query=$(jq -nR --arg q "$query" '$q' | sed 's/^"//; s/"$//')
  else
    # No jq - naive escape covers the common cases
    escaped_query="${query//\\/\\\\}"
    escaped_query="${escaped_query//\"/\\\"}"
  fi
  cat <<EOF
{
  "size": $limit,
  "query": {
    "bool": {
      "must": [{
        "multi_match": {
          "query": "$escaped_query",
          "fields": [$fields],
          "fuzziness": "AUTO"
        }
      }],
      "filter": [$filters]
    }
  }
}
EOF
}

# Render hits as a table - jq + column when available, degrades gracefully
format_product_hits() {
  if ! have_jq; then
    echo "[jq not installed; raw JSON below]" >&2
    cat
    return
  fi
  local body
  body=$(cat)
  local total
  total=$(echo "$body" | jq -r '.hits.total.value // 0')
  local shown
  shown=$(echo "$body" | jq -r '.hits.hits | length')
  if [ "$total" = "0" ]; then
    echo "no hits"
    return
  fi
  echo "$body" | jq -r '
    .hits.hits[]
    | [
        ._source.sku,
        (._source.name // "-"),
        "channel:\(._source.channel_id | .[0:8])…",
        "locale:\(._source.locale)",
        (if ._source.is_published then "" else "[unpublished]" end)
      ]
    | @tsv
  ' | { if have_column; then column -t -s $'\t'; else cat; fi; }
  echo "- $shown of $total hits"
}

format_blog_hits() {
  if ! have_jq; then
    echo "[jq not installed; raw JSON below]" >&2
    cat
    return
  fi
  local body
  body=$(cat)
  local total
  total=$(echo "$body" | jq -r '.hits.total.value // 0')
  local shown
  shown=$(echo "$body" | jq -r '.hits.hits | length')
  if [ "$total" = "0" ]; then
    echo "no hits"
    return
  fi
  echo "$body" | jq -r '
    .hits.hits[]
    | [
        ._source.slug,
        (._source.title // "-"),
        "channel:\(._source.channel_id | .[0:8])…",
        "locale:\(._source.locale)",
        (if ._source.is_published then "" else "[unpublished]" end)
      ]
    | @tsv
  ' | { if have_column; then column -t -s $'\t'; else cat; fi; }
  echo "- $shown of $total hits"
}

cmd_status() {
  echo "=== cluster (${HOST}) ==="
  if have_jq; then
    fetch GET /_cluster/health | jq -r '
      "status:  \(.status)",
      "nodes:   \(.number_of_nodes)",
      "shards:  \(.active_shards) active, \(.unassigned_shards) unassigned"
    '
  else
    fetch GET /_cluster/health
  fi
  echo
  echo "=== indices ==="
  fetch GET "/_cat/indices?v&h=index,health,docs.count,store.size"
}

# Fills QUERY LIMIT JSON_OUT CHANNEL LOCALE from the args
parse_search_flags() {
  LIMIT=10
  JSON_OUT=0
  CHANNEL=""
  LOCALE=""
  QUERY=""
  local positional=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--limit)
        LIMIT="${2:-}"; shift 2
        ;;
      --json)
        JSON_OUT=1; shift
        ;;
      --channel)
        CHANNEL=$(resolve_channel "${2:-}"); shift 2
        ;;
      --locale)
        LOCALE="${2:-}"; shift 2
        ;;
      -h|--help)
        usage; exit 0
        ;;
      --)
        shift; positional+=("$@"); break
        ;;
      -*)
        echo "Error: unknown flag '$1'" >&2; usage; exit 1
        ;;
      *)
        positional+=("$1"); shift
        ;;
    esac
  done
  if [ ${#positional[@]} -eq 0 ]; then
    echo "Error: missing query" >&2; usage; exit 1
  fi
  QUERY="${positional[*]}"
}

cmd_products() {
  parse_search_flags "$@"
  local body
  body=$(build_search_body "$PRODUCT_INDEX" "$QUERY" "$LIMIT" "$CHANNEL" "$LOCALE")
  local response
  response=$(fetch POST "/$PRODUCT_INDEX/_search" "$body")
  if [ "$JSON_OUT" = "1" ]; then
    if have_jq; then echo "$response" | jq; else echo "$response"; fi
  else
    echo "$response" | format_product_hits
  fi
}

cmd_blog() {
  parse_search_flags "$@"
  local body
  body=$(build_search_body "$BLOG_INDEX" "$QUERY" "$LIMIT" "$CHANNEL" "$LOCALE")
  local response
  response=$(fetch POST "/$BLOG_INDEX/_search" "$body")
  if [ "$JSON_OUT" = "1" ]; then
    if have_jq; then echo "$response" | jq; else echo "$response"; fi
  else
    echo "$response" | format_blog_hits
  fi
}

# cmd_show <products|blog> <id>
cmd_show() {
  local kind="${1:-}" id="${2:-}"
  if [ -z "$kind" ] || [ -z "$id" ]; then
    echo "Error: usage: bin/opensearch show <products|blog> <id>" >&2
    exit 1
  fi
  local index field
  case "$kind" in
    products) index="$PRODUCT_INDEX"; field="product_id" ;;
    blog)     index="$BLOG_INDEX"; field="post_id" ;;
    *) echo "Error: kind must be 'products' or 'blog'" >&2; exit 1 ;;
  esac
  local body
  body=$(cat <<EOF
{
  "size": 100,
  "query": { "term": { "$field": "$id" } }
}
EOF
)
  local response
  response=$(fetch POST "/$index/_search" "$body")
  if have_jq; then
    echo "$response" | jq '.hits.hits[]._source'
  else
    echo "$response"
  fi
}

# cmd_raw <METHOD> <path> [body]
cmd_raw() {
  if [ $# -lt 2 ]; then
    echo "Error: usage: bin/opensearch raw <METHOD> <path> [body]" >&2
    exit 1
  fi
  local method="$1" path="$2" body="${3:-}"
  local response
  response=$(fetch "$method" "$path" "$body")
  if have_jq; then echo "$response" | jq; else echo "$response"; fi
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    help|-h|--help|"") usage ;;
    status)            shift; cmd_status "$@" ;;
    products)          shift; cmd_products "$@" ;;
    blog)              shift; cmd_blog "$@" ;;
    show)              shift; cmd_show "$@" ;;
    raw)               shift; cmd_raw "$@" ;;
    *)
      echo "Error: unknown command '$cmd'" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
