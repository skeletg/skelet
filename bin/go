#!/usr/bin/env bash
# go inside the app container - bin/go test ./internal/... , bin/go build ./...
# --signals or --sdk as the first argument runs in that module instead: bin/go --signals test ./...
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib

WORKDIR=(-w /var/www/backend/core)
case "${1:-}" in
    --signals) WORKDIR=(-w /var/www/backend/signals); shift ;;
    --sdk) WORKDIR=(-w /var/www/backend/sdk); shift ;;
esac

if docker compose ps --status running | grep -q "skelet-app"; then
    docker compose exec "${USER_FLAG[@]}" "${WORKDIR[@]}" app go "$@"
else
    docker compose run --rm "${USER_FLAG[@]}" "${WORKDIR[@]}" app go "$@"
fi
