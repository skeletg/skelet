#!/usr/bin/env bash
# sqlc for both modules that have queries, each from its own sqlc.yaml under apps/backend/<module>/ - no arguments means generate
# Pinned on purpose - 'latest' quietly rewrites every generated file's header
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib
[ $# -gt 0 ] || set -- generate
for mod in backend/core backend/signals; do
    echo "==> sqlc $* ($mod)"
    docker run --rm "${USER_FLAG[@]}" -v "$(pwd)/apps:/src" -w "/src/$mod" sqlc/sqlc:1.31.1 "$@"
done
