#!/usr/bin/env bash
# pnpm inside a channel's container: bin/channel [name] <args> - name optional if there's only one
set -e
cd "$(dirname "$(dirname "$0")")"
. bin/_lib

name=""
if [ -n "${1:-}" ] && [ -d "apps/channels/$1" ]; then
    name="$1"; shift
else
    for sf in apps/channels/*/package.json; do
        [ -f "$sf" ] || continue
        if [ -n "$name" ]; then
            echo "Multiple channels in this checkout - name one explicitly:" >&2
            for d in apps/channels/*/package.json; do
                [ -f "$d" ] && echo "    bin/channel $(basename "$(dirname "$d")") ${*:-<pnpm args>}" >&2
            done
            exit 2
        fi
        name="$(basename "$(dirname "$sf")")"
    done
fi

if [ -z "$name" ] || [ ! -f "apps/channels/$name/package.json" ]; then
    echo "No channel ${name:+\"$name\" }found under apps/channels/ in this checkout." >&2
    echo "Removed by bin/setup app selection? Bring it back with: bin/setup --all (or --apps ...)" >&2
    exit 1
fi

# Host pnpm when this clone has a host install - the container keeps node_modules in its own volume,
# and running the gates against a different tree than the dev server is how the two silently diverge
# (host_tree in bin/_lib says why an empty node_modules counts as no install)
if [ -z "${SKELET_FORCE_DOCKER:-}" ]; then
    case "$(host_tree "apps/channels/$name")" in
        npm)  npm_tree_hint "apps/channels/$name"; exit 1 ;;
        pnpm) if command -v pnpm >/dev/null 2>&1; then cd "apps/channels/$name" && exec pnpm "$@"; fi ;;
    esac
fi

tty_flag=()
[ -t 0 ] && tty_flag=(-it)

if docker compose ps --status running | grep -q "skelet-$name"; then
    docker compose exec "${tty_flag[@]}" "${USER_FLAG[@]}" "$name" pnpm "$@"
else
    docker compose run --rm "${tty_flag[@]}" "${USER_FLAG[@]}" "$name" pnpm "$@"
fi