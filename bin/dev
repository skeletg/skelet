#!/usr/bin/env bash
# Fire up the dev stack - safe to re-run. --lean skips opensearch/jaeger - URLs in docs/scripts.md
set -e
cd "$(dirname "$(dirname "$0")")"

if [ "${1:-}" = "--lean" ]; then
    shift
    export SKELET_SIDECARS=""   # only drops sidecars, your apps still start
fi

. bin/_lib

# The dev compose file env_files env/go.env and env/db.env, which only the `dev` target writes.
# Without this, a clone set up for small/prod fails with a raw "env file ... not found" from
# compose, which says nothing about the target being the reason
missing=()
for f in env/go.env env/db.env; do [ -f "$f" ] || missing+=("$f"); done
if [ ${#missing[@]} -gt 0 ]; then
    target=dev
    [ -f .skelet-profile ] && . .skelet-profile && target="${SKELET_TARGET:-dev}"
    echo "bin/dev needs ${missing[*]}, which this clone doesn't have." >&2
    if [ "$target" != dev ]; then
        echo "This clone is set up for the '$target' target - bin/dev runs the DEV stack." >&2
        echo "Re-run bin/setup and pick 'dev', or deploy with docker-compose.$target.yml (docs/deploying.md)." >&2
    else
        echo "Run bin/setup to write the env files." >&2
    fi
    exit 1
fi

docker compose up -d "$@"

# The frontends are host-first, so nothing above binds 5173/3000 unless .skelet-apps asks for it
if [ -z "$SKELET_APPS" ] && [ $# -eq 0 ]; then
    echo
    echo "Frontends are not in Docker (no .skelet-apps) - run them on the host:"
    [ -f apps/dashboard/package.json ] && echo "    ./skelet serve dashboard        → http://localhost:5173"
    for _sf in apps/channels/*/package.json; do
        [ -f "$_sf" ] || continue
        echo "    ./skelet serve $(basename "$(dirname "$_sf")")     → http://localhost:3000"
    done
    echo "To run them in Docker instead, put their names in .skelet-apps (bin/setup --apps ... --keep-code)"
    # Reconcile rather than just warn - a leftover container keeps the port, which reads as "my host
    # dev server won't start", and compose has started these back up on its own more than once
    # Every frontend this checkout could run, not the demo by name - a shop added by bin/new
    # leaves a leftover container holding its port exactly the same way
    _fronts="dashboard"
    for _sf in apps/channels/*/; do
        [ -d "$_sf" ] && _fronts="$_fronts $(basename "$_sf")"
    done
    for _c in $(docker ps --format '{{.Names}}' 2>/dev/null); do
        for _f in $_fronts; do
            case "$_c" in
                *-"$_f"-[0-9]*)
                    echo "    stopping the $_f container - not listed in .skelet-apps, and it holds the port"
                    docker compose --profile "$_f" stop "$_f" >/dev/null 2>&1 || true
                    break ;;
            esac
        done
    done
fi
