#!/usr/bin/env bash
# Build + push prod images: REGISTRY=... bin/push-images [tag] (default = git sha)
# PLATFORM defaults to linux/amd64 so a Mac doesn't ship arm64 to amd64 boxes
set -euo pipefail
cd "$(dirname "$(dirname "$0")")"

: "${REGISTRY:?set REGISTRY, e.g. REGISTRY=registry.digitalocean.com/<your-registry>}"
TAG="${1:-$(git rev-parse --short HEAD)}"
PLATFORM="${PLATFORM:-linux/amd64}"

# A build-time setting (UPLOAD_ORIGINS, the preview origins) comes from your shell, else the root .env
setting() {
  if [ -n "${!1:-}" ]; then printf '%s' "${!1}"; return; fi
  [ -f .env ] && sed -n "s/^$1=//p" .env | tail -1
}

build() { # <service> <context> [dockerfile relative to the context, default Dockerfile.prod]
  local svc="$1" ctx="$2" df="${3:-Dockerfile.prod}" ref="$REGISTRY/skelet-$1:$TAG" name val
  local args=()
  for name in $(sed -nE 's/^ARG ([A-Z][A-Z0-9_]*).*/\1/p' "$ctx/$df" | sort -u); do
    val="$(setting "$name" || true)"
    [ -n "$val" ] && args+=(--build-arg "$name=$val")
  done
  echo "==> build $ref  ($PLATFORM)"
  docker build --platform "$PLATFORM" ${args[@]+"${args[@]}"} -f "$ctx/$df" -t "$ref" "$ctx"
  echo "==> push  $ref"
  docker push "$ref"
}

# Both Go images build from apps/backend as a whole - the modules replace each other by relative path
build app        apps/backend core/Dockerfile.prod
build signals    apps/backend signals/Dockerfile.prod
build dashboard  apps/dashboard

# Storefronts are discovered, so a fork ships its own shop without editing this -
# the env var name is the directory upper-cased, which is what the compose files read
exports=""
for d in apps/channels/*/; do
  [ -f "$d/Dockerfile.prod" ] || continue
  name="$(basename "$d")"
  build "$name" "apps/channels/$name"
  var="$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')_IMAGE"
  exports="$exports  export $var=$REGISTRY/skelet-$name:$TAG"$'\n'
done

cat <<EOF

Pushed tag: $TAG
Deploy with (docker-compose.prod.yml reads these):
  export APP_IMAGE=$REGISTRY/skelet-app:$TAG
  export SIGNALS_IMAGE=$REGISTRY/skelet-signals:$TAG
  export DASHBOARD_IMAGE=$REGISTRY/skelet-dashboard:$TAG
${exports}  docker compose -f docker-compose.prod.yml up -d
EOF
