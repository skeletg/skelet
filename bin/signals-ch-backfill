#!/usr/bin/env bash
# Backfill the ClickHouse spine (analytics_events + analytics_identities) from the
# signals Postgres, using ClickHouse's native postgresql() table function - the
# server pulls directly, no dump files - run AFTER clickhouse-migrate has applied
# the schema; safe before or after flipping SIGNALS_ENGINE
#
# Re-running is safe: every column is copied verbatim (id, received_at and
# created_at included), so a second pass inserts identical rows and the
# ReplacingMergeTree collapses them - FINAL reads are correct even before the
# merge - preserving created_at is also what keeps the destination-forwarding
# cursors valid across the engine flip: anything not yet forwarded from Postgres
# still sorts after each destination's cursor and gets forwarded from ClickHouse
#
#   bin/signals-ch-backfill
#
# Defaults target the dev stack (signals-db + the clickhouse profile)
# Override for other layouts:
#   SIGNALS_PG_HOST/SIGNALS_PG_DB          # a non-default signals Postgres
#   SIGNALS_CH_USER/SIGNALS_CH_PASSWORD    # prod ClickHouse credentials
# The Postgres host is resolved FROM the clickhouse container, so use compose
# service names, not localhost
set -e
cd "$(dirname "$(dirname "$0")")"

PG_HOST="${SIGNALS_PG_HOST:-signals-db:5432}"
PG_DB="${SIGNALS_PG_DB:-skelet_signals}"
PG_USER="${SIGNALS_PG_USER:-skelet}"
PG_PASSWORD="${SIGNALS_PG_PASSWORD:-skelet}"
CH_USER="${SIGNALS_CH_USER:-skelet}"
CH_PASSWORD="${SIGNALS_CH_PASSWORD:-skelet}"
CH_DB="${SIGNALS_CH_DB:-signals}"
CH_SERVICE="${SIGNALS_CH_SERVICE:-clickhouse}"

ZERO="toUUID('00000000-0000-0000-0000-000000000000')"
PGSRC="'$PG_HOST', '$PG_DB'"
PGAUTH="'$PG_USER', '$PG_PASSWORD'"

ch() {
    docker compose exec -T "$CH_SERVICE" clickhouse-client \
        --user="$CH_USER" --password="$CH_PASSWORD" --database="$CH_DB" --query "$1"
}

echo "==> backfilling analytics_events from postgresql://$PG_HOST/$PG_DB"
ch "INSERT INTO analytics_events
        (id, event_name, occurred_at, received_at, channel_id, customer_id,
         anon_id, source, send_id, properties, dedupe_key, created_at)
    SELECT id, event_name, occurred_at, received_at,
           ifNull(channel_id, $ZERO), ifNull(customer_id, $ZERO),
           ifNull(anon_id, ''), source, ifNull(send_id, $ZERO),
           properties, dedupe_key, created_at
    FROM postgresql($PGSRC, 'analytics_events', $PGAUTH)"

echo "==> backfilling analytics_identities"
ch "INSERT INTO analytics_identities (anon_id, customer_id, channel_id, first_seen, last_seen)
    SELECT anon_id, customer_id, ifNull(channel_id, $ZERO), first_seen, last_seen
    FROM postgresql($PGSRC, 'analytics_identities', $PGAUTH)"

echo "==> reloading the identity dictionary"
ch "SYSTEM RELOAD DICTIONARY identity_map" || echo "    (skipped - it re-sources itself within its lifetime)"

echo "==> row parity (postgres vs clickhouse FINAL)"
ch "SELECT 'events    pg=' || toString((SELECT count() FROM postgresql($PGSRC, 'analytics_events', $PGAUTH)))
        || ' ch=' || toString((SELECT count() FROM analytics_events FINAL))
    UNION ALL
    SELECT 'identities pg=' || toString((SELECT count() FROM postgresql($PGSRC, 'analytics_identities', $PGAUTH)))
        || ' ch=' || toString((SELECT count() FROM analytics_identities FINAL))"
echo "signals spine backfilled into clickhouse"
