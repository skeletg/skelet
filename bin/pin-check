#!/usr/bin/env bash
# Each pin below lives in three to six files at once, and the comments around them
# only ask humans to keep them in step - CI disagreeing with a dev box is the cost
set -uo pipefail
cd "$(dirname "$(dirname "$0")")"

fail=0

# Storefront paths are globbed, not listed, so a forked storefront is covered the day it lands rather than the day someone remembers this file read into an array by hand rather than with mapfile, which bash 3.2 has no idea about
DOCKERFILES=()
while IFS= read -r f; do DOCKERFILES+=("$f"); done \
    < <(find apps -maxdepth 3 -name 'Dockerfile*' -not -path '*/node_modules/*' | sort)
COMPOSE=(docker-compose.yml docker-compose.small.yml docker-compose.prod.yml)
WORKFLOWS=(.github/workflows/ci.yml .github/workflows/security.yml)
PACKAGE_JSONS=()
while IFS= read -r f; do PACKAGE_JSONS+=("$f"); done \
    < <(find apps -maxdepth 3 -name package.json -not -path '*/node_modules/*' | sort)

# Normalizes every match down to a bare version, so the same pin written as an
# image tag, a go install path and a workflow input still compares equal
versions_of() { # versions_of <ere> <file>...
    grep -rhoE "$1" "${@:2}" 2>/dev/null \
        | sed -E 's/.*[@:][[:space:]]*v?//; s/-alpine.*$//; s/^alpine//' \
        | sort -u
}

pin() { # pin <label> <ere> <file>...
    local label="$1" pat="$2"
    shift 2
    local found n
    found=$(versions_of "$pat" "$@")
    n=$(printf '%s\n' "$found" | grep -c . || true)
    if [ "$n" -eq 0 ]; then
        printf '  FAIL  %-16s no pin found - did the pattern or the files move?\n' "$label"
        fail=1
    elif [ "$n" -gt 1 ]; then
        printf '  FAIL  %-16s %s\n' "$label" "$(printf '%s' "$found" | tr '\n' ' ')"
        grep -rnE "$pat" "$@" 2>/dev/null | sed 's/^/          /'
        fail=1
    else
        printf '  ok    %-16s %s\n' "$label" "$found"
    fi
}

echo "==> version pins agree across files"
pin postgres   'postgres:[0-9][0-9.]*(-alpine)?'                "${COMPOSE[@]}" "${WORKFLOWS[@]}"
pin clickhouse 'clickhouse/clickhouse-server:[0-9][0-9.]*'      "${COMPOSE[@]}" "${WORKFLOWS[@]}"
pin dbmate     'amacneil/dbmate/v2@v[0-9][0-9.]*' \
                                                                "${COMPOSE[@]}" "${WORKFLOWS[@]}" "${DOCKERFILES[@]}"
pin golangci   'golangci-lint@v[0-9][0-9.]*'                    "${WORKFLOWS[@]}" bin/lint
pin node       '(node:[0-9][0-9.]*(-alpine)?|node-version:[[:space:]]*[0-9][0-9.]*)' \
                                                                "${WORKFLOWS[@]}" "${DOCKERFILES[@]}"
pin alpine     'alpine3?[:.][0-9][0-9.]*'                       apps/backend/core/Dockerfile.prod
pin caddy      'caddy:[0-9][0-9.]*'                             "${COMPOSE[@]}"
# packageManager plus the images' `npm install -g` - an image on another pnpm than the host
# resolves under other defaults and writes a lockfile the host then rewrites
pin pnpm       'pnpm@[0-9][0-9.]*'                         "${PACKAGE_JSONS[@]}" "${DOCKERFILES[@]}"

# .nvmrc carries no prefix to match on, so it's compared rather than scanned. The workflows
# read it directly (node-version-file), so what this guards is the Dockerfiles agreeing with it
echo "==> .nvmrc matches the node pin"
nvmrc=$(tr -d '[:space:]' < .nvmrc)
node_pin=$(versions_of '(node:[0-9][0-9.]*(-alpine)?|node-version:[[:space:]]*[0-9][0-9.]*)' "${WORKFLOWS[@]}" "${DOCKERFILES[@]}" | head -1)
if [ "$nvmrc" = "$node_pin" ]; then
    printf '  ok    %-16s %s\n' ".nvmrc" "$nvmrc"
else
    printf '  FAIL  %-16s .nvmrc says %s, the images and workflows say %s\n' ".nvmrc" "$nvmrc" "$node_pin"
    fail=1
fi

# The toolchain that builds the images has to be the one go.mod declares, and CI
# reads go.mod directly - so a Dockerfile bump is the half that gets forgotten
echo "==> golang images match go.mod"
gomod=$(grep -oE '^go [0-9][0-9.]*' apps/backend/core/go.mod | cut -d' ' -f2)
images=$(grep -rhoE 'FROM golang:[0-9][0-9.]*' "${DOCKERFILES[@]}" | sed -E 's/.*://' | sort -u)
n=$(printf '%s\n' "$images" | grep -c . || true)
if [ "$n" -eq 1 ] && [ "$images" = "$gomod" ]; then
    printf '  ok    %-16s %s\n' "go" "$gomod"
else
    printf '  FAIL  %-16s go.mod says %s, golang images say %s\n' "go" "$gomod" "$(printf '%s' "$images" | tr '\n' ' ')"
    grep -rnE 'FROM golang:[0-9][0-9.]*' "${DOCKERFILES[@]}" | sed 's/^/          /'
    fail=1
fi

echo
if [ "$fail" -eq 0 ]; then
    echo "==> pin-check OK"
else
    echo "==> pin-check FAILED - make the listed sites agree, or update bin/pin-check if a pin moved"
fi
exit "$fail"
