#!/usr/bin/env bash
# Guided first-run, safe to re-run - answers become env files, secrets and a plugin set
# Flags: --all | --backend-only | --apps LIST|none | --docker-apps LIST|none | --keep-code | --yes | --profile FILE
set -e
cd "$(dirname "$(dirname "$0")")"

PROFILE=.skelet-profile

# Storefronts = dirs on disk + dirs in git HEAD (sparse-removed ones stay pickable)
# A space-delimited seen-list, not an associative array - bash 3.2 has no idea about those
storefronts=()
_sf_seen=" "
_sf_add() {
    case "$_sf_seen" in *" $1 "*) return ;; esac
    storefronts+=("$1")
    _sf_seen="$_sf_seen$1 "
}
for d in apps/channels/*/; do
    [ -d "$d" ] || continue
    _sf_add "$(basename "$d")"
done
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        _sf_add "$(basename "$d")"
    done < <(git ls-tree -d --name-only HEAD apps/channels/ 2>/dev/null)
fi

# The payment gateways this tree actually carries. plugins.json naming a slug with no plugins/<slug> directory fails cmd/plugingen outright, so the picker only ever offers what can compile - and one installed from its own repo shows up here without editing this script
gateways=()
for d in apps/backend/core/plugins/payment-*/; do
    [ -d "$d" ] && gateways+=("$(basename "$d")")
done

all_apps="dashboard"
for n in "${storefronts[@]}"; do all_apps="$all_apps,$n"; done

valid_app() {
    [ "$1" = "dashboard" ] && return 0
    for n in "${storefronts[@]}"; do [ "$1" = "$n" ] && return 0; done
    return 1
}

apps=""
apps_set=0
# Which of the selected apps run in a container. Empty means all of them run on the host, which is the default
# There the dev server and the gates share one node_modules, so the linter checks the tree vite is actually serving; in Docker those are two trees that drift apart
docker_apps=""
docker_apps_set=0
keep_code=0
assume_yes=0
while [ $# -gt 0 ]; do
    case "$1" in
        --all)          apps="$all_apps"; apps_set=1 ;;
        --backend-only) apps="";          apps_set=1 ;;
        --apps)
            shift
            [ -n "${1:-}" ] || { echo "--apps needs a value (e.g. ${all_apps} or none)"; exit 2; }
            apps="$1"; [ "$apps" = "none" ] && apps=""
            for a in ${apps//,/ }; do
                valid_app "$a" || { echo "Unknown app \"$a\" (valid: ${all_apps//,/, }, none)"; exit 2; }
            done
            apps_set=1 ;;
        --docker-apps)
            shift
            [ -n "${1:-}" ] || { echo "--docker-apps needs a value (e.g. ${all_apps} or none)"; exit 2; }
            docker_apps="$1"; [ "$docker_apps" = "none" ] && docker_apps=""
            for a in ${docker_apps//,/ }; do
                valid_app "$a" || { echo "Unknown app \"$a\" (valid: ${all_apps//,/, }, none)"; exit 2; }
            done
            docker_apps_set=1 ;;
        --keep-code) keep_code=1 ;;
        --yes|-y)    assume_yes=1 ;;
        --profile)
            shift
            [ -n "${1:-}" ] || { echo "--profile needs a file"; exit 2; }
            [ -f "$1" ] || { echo "No such profile: $1"; exit 2; }
            PROFILE="$1"; assume_yes=1 ;;
        *) echo "Unknown flag: $1 (try --all, --backend-only, --apps LIST, --docker-apps LIST, --keep-code, --yes, --profile FILE)"; exit 2 ;;
    esac
    shift
done

# Last run's answers become this run's defaults, so re-running is not an interrogation
SKELET_TARGET=dev SKELET_SIGNALS=true SKELET_AI=true
SKELET_SEARCH=opensearch SKELET_ADMIN_SLUG=0
SKELET_GATEWAYS="$(IFS=,; printf '%s' "${gateways[*]-}")"
# shellcheck disable=SC1090
[ -f "$PROFILE" ] && . "$PROFILE"

interactive=0
[ "$assume_yes" = 0 ] && [ -t 0 ] && interactive=1

ask_yn() { # ask_yn "question" DEFAULT(y|n) -> 0 for yes
    local reply def="${2:-y}"
    [ "$interactive" = 1 ] || { [ "$def" = y ]; return; }
    if [ "$def" = y ]; then read -r -p "$1 [Y/n] " reply; else read -r -p "$1 [y/N] " reply; fi
    case "${reply:-$def}" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

ask_choice() { # ask_choice VAR "question" DEFAULT opt1 opt2 ... -> echoes the pick
    local __q="$2" __def="$3"; shift 3
    if [ "$interactive" = 0 ]; then printf '%s' "$__def"; return; fi
    printf '%s\n' "    $__q" >&2
    local i=1
    for o in "$@"; do printf '      %d) %s%s\n' "$i" "$o" "$([ "$o" = "$__def" ] && echo '  (default)')" >&2; i=$((i+1)); done
    local reply; read -r -p "    pick [1-$#] " reply
    case "$reply" in ''|*[!0-9]*) printf '%s' "$__def"; return ;; esac
    [ "$reply" -ge 1 ] && [ "$reply" -le $# ] || { printf '%s' "$__def"; return; }
    eval "printf '%s' \"\${$reply}\""
}

# Hex, not base64: sed writes these into the env files and hex can't contain a delimiter
gen_secret() {
    openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
}

# CONFIG_ENCRYPTION_KEY is the one that is not opaque - envcheck requires it to base64-decode
# to exactly 32 bytes for AES-256, so hex here makes a production boot refuse to start
gen_key_b64() {
    openssl rand -base64 32 2>/dev/null | tr -d '\n' || head -c 32 /dev/urandom | base64 | tr -d '\n'
}

placeholder() { # a value we are allowed to overwrite - anything else is the operator's
    case "$1" in ''|change-me|change-me-too|changeme|CHANGE_ME|change-me-in-prod) return 0 ;; *) return 1 ;; esac
}

# GNU sed's -i takes no argument and BSD's demands one, so neither spelling is portable - write a
# sibling and cat it back, which also keeps the original file's mode for the ones holding secrets
sed_i() { # sed_i FILE SED-ARGS...
    local f="$1"; shift
    local t="$f.sed.$$"
    sed "$@" "$f" > "$t" && cat "$t" > "$f"
    rm -f "$t"
}

set_env() { # set_env FILE KEY VALUE - update in place, uncommenting if needed, else append
    local file="$1" key="$2" val="$3"
    if grep -qE "^[#[:space:]]*${key}=" "$file"; then
        sed_i "$file" "s|^[#[:space:]]*${key}=.*|${key}=${val}|"
    else
        printf '%s=%s\n' "$key" "$val" >> "$file"
    fi
}

get_env() { # current value of KEY in FILE, empty when absent or commented out
    grep -E "^${2}=" "$1" 2>/dev/null | head -1 | cut -d= -f2-
}

del_env() { # del_env FILE KEY - drop the line entirely, for knobs whose default is "absent"
    [ -f "$1" ] && sed_i "$1" "/^[#[:space:]]*${2}=/d"
}

# ---------------------------------------------------------------- apps
prompted=0
kept_existing=0
if [ "$apps_set" = 0 ]; then
    if [ -n "${SKELET_APPS_SELECTED+x}" ]; then
        apps="$SKELET_APPS_SELECTED"
        kept_existing=1
        echo "==> App selection: ${apps:-backend only} (from $PROFILE; change with bin/setup --apps ...)"
    elif [ "$interactive" = 1 ]; then
        prompted=1
        echo "==> Which apps should this clone run?"
        echo "    The Go backend (GraphQL APIs, workers) always runs. The"
        echo "    frontends are optional - skip whichever you plan to replace"
        echo "    with your own build."
        parts=()
        ask_yn "    Include the admin dashboard (React SPA on :5173)?" && parts+=(dashboard)
        for n in "${storefronts[@]}"; do
            ask_yn "    Include storefront \"$n\" (Next.js)?" && parts+=("$n")
        done
        apps=$(IFS=,; echo "${parts[*]-}")
    else
        apps="$all_apps"
    fi
fi

# WHERE they run is a separate question from WHETHER you have them, and the default is the host
if [ "$docker_apps_set" = 0 ] && [ -n "$apps" ]; then
    if [ -n "${SKELET_DOCKER_APPS+x}" ]; then
        docker_apps="$SKELET_DOCKER_APPS"
    elif [ "$interactive" = 1 ]; then
        echo "==> Where should the frontends run?"
        echo "    On the host the dev server and the gates share one node_modules, so"
        echo "    a lint run checks the same tree the dev server is serving. In Docker"
        echo "    they are two separate trees, but you need no Node installed."
        ask_yn "    Run them in Docker instead of on the host?" n && docker_apps="$apps"
    fi
fi
# Only apps you actually selected, so --docker-apps can't containerize one that isn't here
kept=""
for a in ${docker_apps//,/ }; do
    case ",$apps," in *,"$a",*) kept="${kept:+$kept,}$a" ;; esac
done
docker_apps="$kept"

printf '%s\n' "$docker_apps" > .skelet-apps
echo "==> Apps: ${apps:-backend only}"
echo "    in Docker: ${docker_apps:-none - they run on the host with \`./skelet serve <app>\`}  (saved to .skelet-apps)"

# Deselected apps get sparse-checkout'd out of the working tree too - the
# code stays in history and comes back if you re-select
if [ "$keep_code" = 0 ] && [ "$kept_existing" = 0 ] \
    && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    excluded=()
    case ",$apps," in *,dashboard,*) ;; *) excluded+=('!/apps/dashboard/') ;; esac
    for n in "${storefronts[@]}"; do
        case ",$apps," in *,"$n",*) ;; *) excluded+=("!/apps/channels/$n/") ;; esac
    done
    if [ ${#excluded[@]} -eq 0 ]; then
        if [ "$(git config core.sparseCheckout 2>/dev/null)" = "true" ]; then
            echo "==> Restoring the full working tree (git sparse-checkout disable)..."
            git sparse-checkout disable
        fi
    else
        do_sparse=1
        if [ "$prompted" = 1 ]; then
            ask_yn "    Also remove the deselected apps' source from your working tree?" || do_sparse=0
        fi
        if [ "$do_sparse" = 1 ]; then
            echo "==> Removing deselected apps from the working tree (git sparse-checkout)..."
            git sparse-checkout set --no-cone '/*' "${excluded[@]}"
            echo "    (still in git history - re-run bin/setup selecting them to restore)"
        fi
    fi
fi

# ---------------------------------------------------------------- shape
if [ "$interactive" = 1 ]; then
    # "Deployment target" alone reads as "where will this eventually live", so people building a
    # shop pick prod and then find bin/dev refuses to start - spell out what each one actually does
    echo "==> How will you run THIS clone?"
    echo "      dev    the local stack - hot reload and sidecars, started with bin/dev"
    echo "      small  a one-container server deployment - writes config, starts nothing here"
    echo "      prod   the full split-tier server deployment - writes config, starts nothing here"
    echo "    Pick dev unless you are configuring a server right now."
    SKELET_TARGET=$(ask_choice t "Target" "$SKELET_TARGET" dev small prod)

    echo "==> Which suites do you want? (all default on)"
    ask_yn "    Signals - analytics: Lens, Synapse, Pulse, Prism?" "$([ "$SKELET_SIGNALS" = true ] && echo y || echo n)" \
        && SKELET_SIGNALS=true || SKELET_SIGNALS=false
    ask_yn "    AI - admin assistant, review classification?" "$([ "$SKELET_AI" = true ] && echo y || echo n)" \
        && SKELET_AI=true || SKELET_AI=false

    echo "==> Engines"
    SKELET_SEARCH=$(ask_choice s "Product search" "$SKELET_SEARCH" opensearch postgres)

    if [ ${#gateways[@]} -eq 0 ]; then
        echo "==> Payment gateways - none in this tree (add one with \`skelet cli plugin install\`)"
        SKELET_GATEWAYS=""
    else
        echo "==> Payment gateways - unpicked ones are left out of the build entirely"
        picks=()
        for g in "${gateways[@]}"; do
            case ",$SKELET_GATEWAYS," in *,"$g",*) d=y ;; *) d=n ;; esac
            ask_yn "    ${g#payment-}?" "$d" && picks+=("$g")
        done
        SKELET_GATEWAYS=$(IFS=,; echo "${picks[*]-}")
    fi

    echo "==> Hardening"
    if ask_yn "    Move the admin API off /api/admin/graphql to an unguessable path?" \
        "$([ "$SKELET_ADMIN_SLUG" = 1 ] && echo y || echo n)"; then
        SKELET_ADMIN_SLUG=1
    else
        SKELET_ADMIN_SLUG=0
    fi
fi

cat > "$PROFILE" <<EOF
# Written by bin/setup - your answers, so a re-run defaults to them
SKELET_TARGET=$SKELET_TARGET
SKELET_SIGNALS=$SKELET_SIGNALS
SKELET_AI=$SKELET_AI
SKELET_SEARCH=$SKELET_SEARCH
SKELET_GATEWAYS=$SKELET_GATEWAYS
SKELET_ADMIN_SLUG=$SKELET_ADMIN_SLUG
SKELET_APPS_SELECTED=$apps
SKELET_DOCKER_APPS=$docker_apps
EOF
echo "==> Profile: $SKELET_TARGET, signals=$SKELET_SIGNALS ai=$SKELET_AI, search=$SKELET_SEARCH  (saved to $PROFILE)"

# ---------------------------------------------------------------- env files
case "$SKELET_TARGET" in
    dev)   backend_env=env/go.env;    want=(env/go.env env/db.env) ;;
    small) backend_env=env/small.env; want=(env/small.env) ;;
    prod)  backend_env=env/prod.env;  want=(env/prod.env) ;;
esac
# Every other env file that target's compose file names, rather than a list kept here
# A shop added by bin/new gets set up like the one it was forked from, and what compose demands cannot drift from what this writes
if [ "$SKELET_TARGET" != dev ]; then
    while IFS= read -r f; do
        case " ${want[*]} " in *" $f "*) continue ;; esac
        want+=("$f")
    done < <(grep -hoE 'env/[a-z0-9.-]+\.env' "docker-compose.$SKELET_TARGET.yml" 2>/dev/null | sort -u)
fi

echo "==> Env files for $SKELET_TARGET"
for target in "${want[@]}"; do
    if [ -f "$target" ]; then
        echo "    $target (exists, keeping your values)"
    else
        cp "$target.example" "$target"
        echo "    $target"
    fi
done

# The backend env file is where the suites and the search tier live
set_env "$backend_env" SIGNALS_ENABLED "$SKELET_SIGNALS"
set_env "$backend_env" AI_ENABLED "$SKELET_AI"

echo "==> Secrets"
for key in JWT_SECRET CONFIG_ENCRYPTION_KEY SIGNALS_SERVICE_SECRET REVIEW_VOTER_TOKEN_SECRET STOREFRONT_REVALIDATE_SECRET EMAIL_WEBHOOK_TOKEN; do
    cur="$(get_env "$backend_env" "$key")"
    if placeholder "$cur"; then
        if [ "$key" = CONFIG_ENCRYPTION_KEY ]; then val="$(gen_key_b64)"; else val="$(gen_secret)"; fi
        set_env "$backend_env" "$key" "$val"
        echo "    $key generated"
    else
        echo "    $key already set, left alone"
    fi
done
if [ "$SKELET_TARGET" != dev ]; then
    cur="$(get_env "$backend_env" BACKUP_ENCRYPTION_PASSPHRASE)"
    if placeholder "$cur"; then
        set_env "$backend_env" BACKUP_ENCRYPTION_PASSPHRASE "$(gen_secret)"
        echo "    BACKUP_ENCRYPTION_PASSPHRASE generated - store it somewhere you can restore from"
    fi

    # The root .env is the ONLY file compose interpolates, and the small and prod files build their datastore URLs out of these
    # A secret reaching the container only through env_file is invisible to ${VAR:?}, and datastore passwords are generated here since an empty one silently becomes a blank password
    touch .env
    for key in JWT_SECRET CONFIG_ENCRYPTION_KEY SIGNALS_SERVICE_SECRET DB_PASSWORD SIGNALS_DB_PASSWORD VALKEY_PASSWORD CLICKHOUSE_PASSWORD; do
        cur="$(get_env .env "$key")"
        placeholder "$cur" || { echo "    .env $key already set, left alone"; continue; }
        # the three the backend also reads must MATCH there, not be generated twice
        case "$key" in
            JWT_SECRET|CONFIG_ENCRYPTION_KEY|SIGNALS_SERVICE_SECRET) val="$(get_env "$backend_env" "$key")" ;;
            *) val="" ;;
        esac
        [ -n "$val" ] || { if [ "$key" = CONFIG_ENCRYPTION_KEY ]; then val="$(gen_key_b64)"; else val="$(gen_secret)"; fi; }
        set_env .env "$key" "$val"
        echo "    .env $key set"
    done
fi

# ---------------------------------------------------------------- root .env
touch .env
echo "==> Compose knobs (.env)"
# Both knobs are written on EVERY run, not just when they leave the default. A one-way write means re-running and changing your answer back silently does nothing, and re-running with different answers is the whole point of the profile defaults above
if [ "$SKELET_SEARCH" = postgres ]; then
    set_env .env OPENSEARCH_URL ""
    echo "    search pinned to the Postgres tier"
else
    # Deleted, not set: compose reads ${OPENSEARCH_URL-http://opensearch:9200}, so absent means
    # the bundled cluster while set-but-empty is what pins search to Postgres
    del_env .env OPENSEARCH_URL
    echo "    search on the bundled OpenSearch"
fi
if [ "$SKELET_ADMIN_SLUG" = 1 ]; then
    slug="$(grep -E '^ADMIN_API_SLUG=.+' .env 2>/dev/null | cut -d= -f2- || true)"
    if [ -z "$slug" ]; then
        slug="admin-$(openssl rand -hex 8 2>/dev/null || head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        echo "    admin API moved to /api/admin/$slug/graphql"
    else
        echo "    admin API slug already set, left alone"
    fi
    set_env .env ADMIN_API_SLUG "$slug"
    set_env .env VITE_GRAPHQL_URL "/api/admin/$slug/graphql"
    set_env .env GRAPHQL_CODEGEN_URL "http://app:8080/api/admin/$slug/graphql"
else
    # Answering no on a re-run has to actually move the API back - all three read
    # ${VAR:-default} in compose, so deleting restores /api/admin/graphql everywhere at once
    del_env .env ADMIN_API_SLUG
    del_env .env VITE_GRAPHQL_URL
    del_env .env GRAPHQL_CODEGEN_URL
fi

# ---------------------------------------------------------------- plugins
plugins_json=apps/backend/core/plugins/plugins.json
before="$(cat "$plugins_json" 2>/dev/null || true)"

# MERGED, never rewritten from a list held here - plugins.json is the decision file that `plugin enable|disable` and `plugin install` write too
# So a slug this script knows nothing about survives a re-run untouched, and only the gateways just picked change value
pairs=()
has_pair() { case " ${pairs[*]-} " in *" $1:"*) return 0 ;; esac; return 1; }

# Existing entries keep their place and their value
while IFS= read -r line; do
    slug="${line%% *}"
    val="${line#* }"
    [ -n "$slug" ] || continue
    case " ${gateways[*]-} " in
        *" $slug "*) case ",$SKELET_GATEWAYS," in *,"$slug",*) val=1 ;; *) val=0 ;; esac ;;
    esac
    pairs+=("$slug:$val")
done < <(sed -n 's/^[[:space:]]*"\([^"]*\)"[[:space:]]*:[[:space:]]*\([01]\).*/\1 \2/p' \
             "$plugins_json" 2>/dev/null)

# Then any plugin directory the file doesn't name yet - plugingen refuses to run while one
# has no decision recorded, so leave none behind. Off unless it was just picked
for d in apps/backend/core/plugins/*/; do
    [ -d "$d" ] || continue
    slug="$(basename "$d")"
    [ "$slug" = firstparty ] && continue
    has_pair "$slug" && continue
    case ",$SKELET_GATEWAYS," in
        *,"$slug",*) pairs+=("$slug:1") ;;
        *)           pairs+=("$slug:0") ;;
    esac
done

{
    echo '{'
    echo '  "plugins": {'
    i=0
    for pair in ${pairs[@]+"${pairs[@]}"}; do
        i=$((i + 1))
        [ "$i" -lt "${#pairs[@]}" ] \
            && echo "    \"${pair%:*}\": ${pair##*:}," \
            || echo "    \"${pair%:*}\": ${pair##*:}"
    done
    echo '  }'
    echo '}'
} > "$plugins_json"
if [ "$before" != "$(cat "$plugins_json")" ]; then
    echo "==> Plugin set changed - ${SKELET_GATEWAYS:-none}"
    regen_plugins=1
else
    echo "==> Plugin set unchanged"
    regen_plugins=0
fi

# ---------------------------------------------------------------- boot
if [ "$SKELET_TARGET" != dev ]; then
    echo "==> Files written. $SKELET_TARGET target: fill the hostnames and credentials in $backend_env,"
    echo "    then deploy with docker-compose.$([ "$SKELET_TARGET" = small ] && echo small || echo prod).yml"
    exit 0
fi

echo "==> Starting containers..."
# --lean - migrating only needs db + app, the sidecars come with the bin/dev below
bin/dev --lean

echo "==> Waiting for db..."
docker compose exec db sh -c 'until pg_isready -U $POSTGRES_USER -d $POSTGRES_DB; do sleep 1; done'

echo "==> Running migrations..."
bin/migrate up

# ClickHouse came up inside the signals profile and the Signals process waits on its one-shot, so
# this only confirms the spine schema landed before the first beacon
if [ "$SKELET_SIGNALS" = true ]; then
    echo "==> Waiting for the ClickHouse spine schema..."
    ch_ready=0
    tries=0
    while [ "$tries" -lt 60 ]; do
        got="$(docker compose exec -T clickhouse clickhouse-client \
                 --user="${CLICKHOUSE_USER:-skelet}" --password="${CLICKHOUSE_PASSWORD:-skelet}" \
                 --query 'EXISTS TABLE signals.analytics_events' 2>/dev/null | tr -d '[:space:]')"
        [ "$got" = 1 ] && { ch_ready=1; break; }
        tries=$((tries + 1))
        sleep 2
    done
    if [ "$ch_ready" = 1 ]; then
        echo "    signals.analytics_events present"
    else
        echo "    NOT ready after 2 minutes - the spine will write nowhere until this lands" >&2
        echo "    look at: bin/logs clickhouse-migrate" >&2
    fi
fi

if [ "$regen_plugins" = 1 ]; then
    echo "==> Regenerating the plugin GraphQL delegation (bin/codegen)..."
    bin/codegen || echo "    codegen failed - run bin/codegen once the stack is warm"
fi

# POPULATED, not merely present - the containers started above mount a named volume at node_modules, and because the parent is a bind mount that leaves an EMPTY directory on the host. Testing -d here would see the directory this script just caused and skip its own install
needs_install() { [ -z "$(ls -A "$1/node_modules" 2>/dev/null)" ]; }

# Into whichever tree the app will actually run from - a host app installed into the container's
# volume, or the reverse, looks like the install did nothing at all
install_app() { # install_app DIR NAME
    local dir="$1" name="$2"
    echo "==> Installing $name dependencies..."
    if ! needs_install "$dir"; then
        echo "    $dir/node_modules is populated, skipping"
        return
    fi
    case ",$docker_apps," in
        *,"$name",*)
            if [ "$name" = dashboard ]; then bin/dash install; else bin/channel "$name" install; fi ;;
        *)
            if command -v npm >/dev/null 2>&1; then
                (cd "$dir" && npm ci)
            else
                echo "    no npm on PATH - install Node, or re-run with --docker-apps $name" >&2
            fi ;;
    esac
}

case ",$apps," in *,dashboard,*) install_app apps/dashboard dashboard ;; esac
for sf in apps/channels/*/package.json; do
    [ -f "$sf" ] || continue
    name="$(basename "$(dirname "$sf")")"
    case ",$apps," in *,"$name",*) install_app "apps/channels/$name" "$name" ;; esac
done

echo "==> Setup complete."
echo
echo "Next steps:"
echo "  bin/dev                 # dev stack with hot reload + sidecars"
echo "  bin/doctor              # check the shape you just picked"
echo "  bin/install-hooks       # opt-in: pre-commit keeps generated code fresh"
echo
echo "Once bin/dev is up:"
if [ "$SKELET_ADMIN_SLUG" = 1 ]; then
    echo "  Admin GraphQL           http://localhost:8080/api/admin/$slug/graphql"
else
    echo "  Backend playgrounds     http://localhost:8080/playground/{admin,front}"
fi
case ",$apps," in *,dashboard,*)
echo "  Dashboard               http://localhost:5173" ;; esac
# Each selected storefront, at whatever port its own compose service publishes
for n in "${storefronts[@]}"; do
    case ",$apps," in *,"$n",*) ;; *) continue ;; esac
    port="$(docker compose port "$n" 3000 2>/dev/null | sed 's/.*://')"
    printf '  %-23s http://localhost:%s\n' "Storefront $n" "${port:-3000}"
done
# A host app is not started by bin/dev, so the ports above only answer once you run it
host_apps=""
for a in ${apps//,/ }; do
    case ",$docker_apps," in *,"$a",*) ;; *) host_apps="${host_apps:+$host_apps }$a" ;; esac
done
if [ -n "$host_apps" ]; then
    echo
    echo "These run on the host, so bin/dev does not start them:"
    for a in $host_apps; do echo "  ./skelet serve $a"; done
fi
echo "  Mailpit (caught email)  http://localhost:8025"
if [ -z "$apps" ]; then
    echo
    echo "Backend-only clone: point your own frontend at the GraphQL APIs above."
fi
