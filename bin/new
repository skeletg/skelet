#!/usr/bin/env bash
# Scaffold something that has to be wired into several files at once - bin/new channel <name>
#
# Storefronts are forks of an existing one, so every compose block here is COPIED from the
# source service rather than templated in this script - a change to the demo's wiring is
# inherited by the next storefront instead of silently drifting from a copy kept here
set -e
cd "$(dirname "$(dirname "$0")")"

# GNU sed's -i takes no argument and BSD's demands one, so neither spelling is portable - write a
# sibling and cat it back, which also keeps the original file's mode for the ones holding secrets
sed_i() { # sed_i FILE SED-ARGS...
    local f="$1"; shift
    local t="$f.sed.$$"
    sed "$@" "$f" > "$t" && cat "$t" > "$f"
    rm -f "$t"
}

usage() {
    cat <<'EOF'
bin/new channel <name> [--from <storefront>] [--tracked]

  Forks a storefront into apps/channels/<name> with its own port, volumes and
  env templates.

  --from      which storefront to copy (default: the only one in the tree)
  --tracked   wire it into the tracked compose files instead of the override

By default the dev service goes in docker-compose.override.yml, which is
git-ignored and auto-merged - so pulling from upstream skelet never conflicts
with your shops (docs/workflow.md). Prod deployment stays yours to wire.

--tracked edits docker-compose{,.prod,.small}.yml instead. That's for adding a
storefront to skelet itself, and it's what makes upstream pulls conflict.

Nothing is written until every generated compose file parses, so a failure
leaves the repo untouched.
EOF
}

kind="${1:-}"
[ $# -gt 0 ] && shift
case "$kind" in
    channel) ;;
    -h|--help|help|"") usage; exit 0 ;;
    *) echo "bin/new: don't know how to make a \"$kind\" - only 'channel' so far" >&2; exit 2 ;;
esac

name="${1:-}"
[ $# -gt 0 ] && shift
src=""
tracked=0
OVERRIDE=docker-compose.override.yml
while [ $# -gt 0 ]; do
    case "$1" in
        --from) shift; src="${1:-}"; [ -n "$src" ] || { echo "--from needs a storefront name" >&2; exit 2; } ;;
        --tracked) tracked=1 ;;
        *) echo "Unknown flag: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

# Compose service names, directory names and the *_IMAGE var all derive from this, so keep it
# to what all three accept rather than discovering the problem three files later
case "$name" in
    "") echo "bin/new channel <name> - e.g. bin/new channel eu-shop" >&2; exit 2 ;;
    *[!a-z0-9-]*|-*|*-) echo "Bad name \"$name\" - lowercase letters, digits and inner hyphens only" >&2; exit 2 ;;
esac
[ -e "apps/channels/$name" ] && { echo "apps/channels/$name already exists" >&2; exit 2; }
grep -qE "^  ${name}:" docker-compose.yml && { echo "docker-compose.yml already has a \"$name\" service" >&2; exit 2; }

# Which compose file declares a service, since a storefront added by a previous run lives in
# the git-ignored override rather than the tracked file
compose_with() { # compose_with SERVICE -> filename, or nothing
    local f
    for f in docker-compose.yml "$OVERRIDE"; do
        [ -f "$f" ] && grep -qE "^  ${1}:" "$f" && { printf '%s' "$f"; return 0; }
    done
    return 1
}

# Prefer a storefront the tracked compose file declares - that's the upstream template, and
# picking whatever sorts first would fork last week's experiment instead of the demo
if [ -z "$src" ]; then
    for d in apps/channels/*/package.json; do
        [ -f "$d" ] || continue
        cand="$(basename "$(dirname "$d")")"
        grep -qE "^  ${cand}:" docker-compose.yml && { src="$cand"; break; }
        [ -z "$src" ] && src="$cand"
    done
fi
[ -n "$src" ] && [ -d "apps/channels/$src" ] || { echo "No storefront to copy from - pass --from <name>" >&2; exit 2; }

src_var="$(printf '%s' "$src"  | tr 'a-z-' 'A-Z_')_IMAGE"
new_var="$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')_IMAGE"

# First free host port at or above a base, so deleting a storefront doesn't leave a hole that
# the next one collides with. Reads every compose file, not just the one being edited
free_port() {
    local p="$1" files=""
    # The override too - storefronts from earlier runs live only there, and missing them hands
    # the next shop a port that's already taken, which compose accepts and `up` then rejects
    for f in docker-compose.yml docker-compose.prod.yml docker-compose.small.yml "$OVERRIDE" \
             env/small-*.env.example env/prod-*.env.example; do
        [ -f "$f" ] && files="$files $f"
    done
    # Matches both a compose mapping ("3001:3000") and a URL (localhost:13001), since in
    # override mode the small-tier port only ever appears in an env template
    while grep -qE "[\"':]${p}([^0-9]|$)" $files; do
        p=$((p + 1))
    done
    printf '%s' "$p"
}
dev_port="$(free_port 3001)"
small_port="$(free_port 13001)"

# Copies the source's service block out of a compose file, renamed - a block runs from its
# `  <name>:` line to the next thing at two-space indent
clone_block() { # clone_block FILE PORT_SED
    # Ends at the next sibling service OR any top-level key - a service that happens to be
    # last in its file is followed by `volumes:`, not by another two-space name
    awk -v s="  $src:" '
        $0 == s { inblk = 1; print; next }
        inblk && (/^  [^ ]/ || /^[^[:space:]]/) { inblk = 0 }
        inblk   { print }
    ' "$1" | sed -e "s/${src}/${name}/g" -e "s/${src_var}/${new_var}/g" -e "$2"
}

# Splices a rendered block in after the source's, keeping related services together
splice_after_block() { # splice_after_block FILE BLOCK_FILE
    awk -v s="  $src:" -v add="$2" '
        $0 == s { inblk = 1; print; next }
        inblk && (/^  [^ ]/ || /^[^[:space:]]/) {
            inblk = 0; while ((getline l < add) > 0) print l; close(add); print ""; print; next }
        { print }
        END { if (inblk) { while ((getline l < add) > 0) print l; close(add) } }
    ' "$1"
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Anchors do NOT cross compose files - each is parsed on its own, so a block copied out of
# docker-compose.yml carrying `logging: *logging` needs that definition here too. Only the
# ones this block actually references, and only when the override doesn't already define them
copy_anchors() { # copy_anchors BLOCK_FILE
    local a
    for a in $(grep -oE '\*[a-zA-Z][a-zA-Z0-9_-]*' "$1" | tr -d '*' | sort -u); do
        grep -qE "&${a}([[:space:]]|$)" "$OVERRIDE" 2>/dev/null && continue
        awk -v anc="&$a" '
            $0 ~ "^x-[a-zA-Z0-9_-]+:[[:space:]]*" anc "[[:space:]]*$" { inblk = 1; print; next }
            inblk && /^[^[:space:]]/ { inblk = 0 }
            inblk { print }
        ' docker-compose.yml
    done
}

# Appends a service and its two volumes to the git-ignored override file, creating it whole
# when absent. YAML forbids a second top-level `services:`, so this splices into the existing
# section rather than concatenating
render_override() { # render_override BLOCK_FILE > new override content
    local blk="$1"
    if [ ! -f "$OVERRIDE" ]; then
        {
            echo "# Per-clone compose additions - git-ignored, auto-merged by docker compose."
            echo "# Storefronts scaffolded by bin/new land here so a pull from upstream skelet"
            echo "# never conflicts with your own shops - see docs/workflow.md"
            echo
            copy_anchors "$blk"
            echo "services:"
            cat "$blk"
            echo
            echo "volumes:"
            echo "  ${name}-node-modules:"
            echo "  ${name}-next-cache:"
        }
        return
    fi
    # Existing file: anchors first, so they're defined before the service that uses them
    copy_anchors "$blk" > "$tmp/anchors"
    awk -v blk="$blk" -v nm="$name" -v anchors="$tmp/anchors" '
        function emit_service(   l) { while ((getline l < blk) > 0) print l; close(blk) }
        function emit_volumes()     { print "  " nm "-node-modules:"; print "  " nm "-next-cache:" }
        NR == 1 { while ((getline l < anchors) > 0) print l; close(anchors) }
        /^services:[[:space:]]*$/ { inserv = 1; print; next }
        /^volumes:[[:space:]]*$/  { if (inserv) { emit_service(); inserv = 0 }
                                    invol = 1; sawvol = 1; print; next }
        # any other top-level key closes whichever section we were in
        /^[^[:space:]#]/ { if (inserv) { emit_service(); inserv = 0 }
                           if (invol)  { emit_volumes(); invol = 0 } }
        { print }
        END {
            if (inserv) emit_service()
            if (invol)  emit_volumes()
            # No volumes section at all in the file we appended to - add one
            if (!sawvol) { print ""; print "volumes:"; emit_volumes() }
        }' "$OVERRIDE"
}

echo "==> Forking $src into apps/channels/$name"
dev_src="$(compose_with "$src")" \
    || { echo "No \"$src\" service in docker-compose.yml or $OVERRIDE - can't copy its wiring" >&2; exit 1; }
# Its published port is whatever that file gave it, so rewrite by matching the container side
clone_block "$dev_src" "s|\"[0-9]\{4,5\}:3000\"|\"${dev_port}:3000\"|" > "$tmp/dev.block"
[ -s "$tmp/dev.block" ] || { echo "Could not read the \"$src\" service out of $dev_src" >&2; exit 1; }

if [ "$tracked" = 1 ]; then
    clone_block docker-compose.prod.yml  "s|127\.0\.0\.1:3000:3000|127.0.0.1:${dev_port}:3000|"    > "$tmp/prod.block"
    clone_block docker-compose.small.yml "s|127\.0\.0\.1:13000:3000|127.0.0.1:${small_port}:3000|" > "$tmp/small.block"
    for f in prod small; do
        [ -s "$tmp/$f.block" ] || { echo "Could not find a \"$src\" service in the $f compose file" >&2; exit 1; }
    done
    splice_after_block docker-compose.yml       "$tmp/dev.block"   > "$tmp/docker-compose.yml"
    splice_after_block docker-compose.prod.yml  "$tmp/prod.block"  > "$tmp/docker-compose.prod.yml"
    splice_after_block docker-compose.small.yml "$tmp/small.block" > "$tmp/docker-compose.small.yml"
    # The dev file also declares the two named volumes that shadow node_modules and .next
    sed_i "$tmp/docker-compose.yml" \
        "s|^  ${src}-next-cache:|  ${src}-next-cache:\\
  ${name}-node-modules:\\
  ${name}-next-cache:|"
    targets="docker-compose.yml docker-compose.prod.yml docker-compose.small.yml"
else
    render_override "$tmp/dev.block" > "$tmp/$OVERRIDE"
    targets="$OVERRIDE"
fi

echo "==> Checking the generated compose files parse"
for f in $targets; do
    # --project-directory or compose resolves env_file and build context against $tmp.
    # --no-interpolate because the prod files demand secrets a dev clone has no reason to
    # hold - the splice is what's under test, not whether this machine could deploy
    if [ "$f" = "$OVERRIDE" ]; then
        # The override is only valid merged with the base, which is how compose reads it
        set -- --project-directory . -f docker-compose.yml -f "$tmp/$f"
    else
        set -- --project-directory . -f "$tmp/$f"
    fi
    docker compose "$@" config -q --no-interpolate 2>"$tmp/err" \
        || { echo "    $f would be invalid - nothing written:" >&2; sed 's/^/      /' "$tmp/err" >&2; exit 1; }
    echo "    $f ok"
done

# Everything validated, so start writing
cp -a "apps/channels/$src" "apps/channels/$name"
rm -rf "apps/channels/$name/node_modules" "apps/channels/$name/.next"
# -I skips binaries, so the favicon and the svgs are left alone
for f in $(grep -rlI "$src" "apps/channels/$name" 2>/dev/null || true); do
    sed_i "$f" "s|${src}|${name}|g"
done

for f in $targets; do
    cp "$tmp/$f" "$f"
done

for tier in prod small; do
    tpl="env/${tier}-${src}.env.example"
    out="env/${tier}-${name}.env.example"
    [ -f "$tpl" ] || continue
    sed -e "s|${src}|${name}|g" -e "s|localhost:13000|localhost:${small_port}|g" "$tpl" > "$out"
    if [ "$tracked" = 1 ]; then
        # Staged, not just written - repo-check demands a COMMITTED .example for every compose
        # env_file, and the tracked prod block above just added one, so an unstaged template
        # would block the very next commit through the pre-commit hook
        git add "$out" 2>/dev/null || true
        echo "    $out (staged)"
    else
        echo "    $out"
    fi
done

if [ "$tracked" = 1 ]; then
    wrote="docker-compose{,.prod,.small}.yml   service + volumes, dev :$dev_port, small :$small_port"
    deploy="Deploying it also needs a Caddy route - deploy/caddy/Caddyfile has $src's."
else
    wrote="$OVERRIDE       service + volumes on :$dev_port (git-ignored)"
    deploy="Prod is yours to wire: docker-compose.prod.yml's \"$src\" block is the shape,
and deploy/caddy/Caddyfile has its route. docs/deploying.md covers both."
fi

# The suggestion adds the new shop to what this clone runs now rather than replacing it - the profile's selection,
# else every app the tree holds, which is what setup picks when it has no answer on record
if grep -q '^SKELET_APPS_SELECTED=' .skelet-profile 2>/dev/null; then
    selected="$(sed -n 's/^SKELET_APPS_SELECTED=//p' .skelet-profile | head -1)"
else
    selected=dashboard
    for d in apps/channels/*/; do
        [ "$(basename "$d")" = "$name" ] || selected="$selected,$(basename "$d")"
    done
fi

cat <<EOF

Wrote:
  apps/channels/$name   forked from $src
  $wrote
  env/{prod,small}-$name.env.example

Next:
  1. Create the channel in admin > channels, and put its uuid in
     STOREFRONT_CHANNEL_ID (or map hosts to channels in
     STOREFRONT_CHANNEL_HOSTS to serve several from one deployment). The dev
     block inherited $src's default uuid, so change it there too.
  2. ./skelet setup --apps ${selected:+$selected,}$name
  3. ./skelet up, then http://localhost:$dev_port

$deploy
EOF
