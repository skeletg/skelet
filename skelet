#!/usr/bin/env bash
# The front door - every dev command, grouped by intent instead of by filename
# The commands live in apps/skelet, a Go program this builds once per change and keeps in .skelet/bin. Verbs still
# route onto bin/*, which keep working directly and unchanged, so a command that worked yesterday works the same
set -e

# Follow symlinks by hand so a PATH install works - macOS has no readlink -f. Bounded because
# a symlink cycle would otherwise hang the front door with no output at all
self="$0"
hops=0
while [ -L "$self" ] && [ "$hops" -lt 40 ]; do
    link="$(readlink "$self")"
    case "$link" in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
    hops=$((hops + 1))
done
root="$(cd "$(dirname "$self")" && pwd)"

# Standing inside a checkout wins over the one $0 came from, so a PATH install acts on the repo you're in rather than whichever clone got symlinked. $0 can't tell us how we were called - the shell expands a PATH hit to a full path before exec
d="$PWD"
while [ "$d" != / ]; do
    [ -f "$d/bin/_lib" ] && [ -f "$d/skelet" ] && { root="$d"; break; }
    d="$(dirname "$d")"
done

die() { printf '%s\n' "$*" >&2; exit 2; }

GO_IMAGE=golang:1.27.3-alpine
src="$root/apps/skelet"
[ -f "$src/go.mod" ] || die "skelet: $src is missing - the front door's own source has to be in the checkout"

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$(uname -m)" in
    x86_64|amd64)  arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *)             arch="$(uname -m)" ;;
esac

# Named by its sources, so a branch switch that leaves apps/skelet alone reuses the build and one that changes it builds once
key="$(cd "$src" && {
    printf '%s %s %s\n' "$GO_IMAGE" "$os" "$arch"
    find . -type f \( \( -name '*.go' ! -name '*_test.go' \) -o -name go.mod -o -name go.sum \) ! -path '*/testdata/*' \
        | LC_ALL=C sort | xargs cksum
} | cksum | cut -d' ' -f1)"
cache="$root/.skelet/bin"
bin="$cache/skelet-$key"

build() {
    local tmp="$cache/.build-$key-$$" log="$cache/build.log" ld="-s -w -X main.mode=checkout"
    mkdir -p "$cache"
    echo "==> building the skelet CLI for this checkout (once per change to apps/skelet)" >&2
    if command -v go >/dev/null 2>&1 \
        && (cd "$src" && GOWORK=off GOFLAGS=-buildvcs=false CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
            go build -trimpath -ldflags "$ld" -o "$tmp" .) >"$log" 2>&1; then
        :
    elif docker info >/dev/null 2>&1; then
        # Out through stdout, so the container writes nothing into the checkout and its uid never matters
        docker run --rm -v "$src:/src:ro" -v skelet-cli-gocache:/root/.cache/go-build -w /src \
            -e CGO_ENABLED=0 -e GOOS="$os" -e GOARCH="$arch" -e GOFLAGS=-buildvcs=false "$GO_IMAGE" \
            sh -c "go build -trimpath -ldflags '$ld' -o /tmp/skelet . && cat /tmp/skelet" >"$tmp" 2>>"$log" \
            || { rm -f "$tmp"; cat "$log" >&2; die "skelet: building the CLI failed - the output above is also in $log"; }
    else
        rm -f "$tmp"
        [ -s "$log" ] && cat "$log" >&2
        die "skelet: the CLI is built once per change, and that needs Go on the host or a running Docker - neither works here. bin/<script> still runs directly"
    fi
    chmod +x "$tmp"
    mv -f "$tmp" "$bin"
    rm -f "$log"
    ls -1t "$cache"/skelet-* | sed 1,3d | while IFS= read -r old; do rm -f "$old"; done
}

[ -x "$bin" ] || build
SKELET_ROOT="$root" SKELET_SHIM=1 exec "$bin" "$@"
