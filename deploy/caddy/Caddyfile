# Reverse proxy + automatic HTTPS for the prod and small stacks - OPT-IN, behind the
# `edge` compose profile. Without it every service stays on 127.0.0.1 and terminating
# TLS is yours to do; with it Caddy gets Let's Encrypt certs for the domains in
# env/prod-caddy.env and renews them. Routing table + the nginx equivalent: README
#
# This file is yours to edit. The vhost map is the one thing no tool can discover -
# only you know which domain points where, or which storefront you actually run.

# ACME_EMAIL is the Let's Encrypt account contact, so Caddy can send expiry and
# renewal-failure notices - without one a silent renewal failure surfaces as an outage
# REQUIRED: an empty value breaks the parser, so env/prod-caddy.env must set a real address
{
	email {$ACME_EMAIL}
}

# Shared response headers. HSTS lives HERE and only here - the app-layer copies
# (apps/backend/core/lib/httpx/securityheaders.go, apps/dashboard/nginx.conf.template) deliberately
# omit it, since asserting it over plain http would wrongly pin a browser for a year
#
# The CSP and Permissions-Policy lines are GENERATED from apps/backend/core/lib/httpx/securityheaders.go
# by skelet gen (cmd/secheadgen) and gated by skelet check contracts, so edit them there.
# Payment SDK hosts (Stripe/Braintree/PayPal) need their script + frame origins; inline
# styles/scripts stay allowed because Next and Vite inject them
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$UPLOAD_ORIGINS}; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		# Don't advertise the server software
		-Server
	}
}

# The shop, on the apex domain. Swap the upstream for your own storefront's compose
# service - the name here is the demo's, not something the stack derives
{$STOREFRONT_DOMAIN:localhost} {
	import security_headers
	encode zstd gzip
	reverse_proxy vetrina:3000
}

# Admin dashboard - its nginx proxies the SPA's /api/* to the backend in-network, so
# this host serves the UI and its API needs without the API domain below existing
{$DASHBOARD_DOMAIN:admin.localhost} {
	import security_headers
	encode zstd gzip
	reverse_proxy dashboard:8080
}

# Public API surface. Its ONLY hard requirement is inbound webhooks - a payment
# provider POSTing to /api/v1/payments/webhook/<provider>, which is the URL you
# register in the Stripe/Braintree dashboard. Skip this host and captures silently
# never settle, so it is not the optional one it looks like
#
# Uncomment the media and ingest routes to move those off the commerce process -
# both tiers serve the same paths `app` does, so routing them is a scaling choice
{$API_DOMAIN:api.localhost} {
	import security_headers
	encode zstd gzip
	# reverse_proxy /media/t/* media:8083
	# reverse_proxy /t/* ingest:8091
	reverse_proxy app:8080
}
