# Root .env - the only file compose interpolates, so a secret that appears in two places (a container and the URL reaching it) is defined once here cp to .env and fill in - what each var does: docs/env.md Dev needs none of it: this is read by docker-compose.prod.yml and docker-compose.small.yml

# Self-hosted: the bundled Postgres/Valkey/pgbouncer containers. Drop this line (or set it empty) when you point the *_URL vars below at managed instances - the containers then never start, instead of idling beside the databases you're actually using
COMPOSE_PROFILES=bundled

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32 - signs core's calls on the Signals contract, core and the Signals processes alone
SIGNALS_SERVICE_SECRET=
# openssl rand -base64 32, keep stable
CONFIG_ENCRYPTION_KEY=

DB_PASSWORD=
SIGNALS_DB_PASSWORD=
VALKEY_PASSWORD=

# Matches env/prod-vetrina-demo.env's revalidate route
STOREFRONT_REVALIDATE_SECRET=

# The two apps' PUBLIC origins, as a pair - the dashboard frames storefront previews, and the storefront names the dashboard in its frame-ancestors CSP and checks it on every postMessage Leaving these unset works in dev only, where both defaults happen to be right
# VITE_STOREFRONT_ORIGIN=https://shop.example.com
# NEXT_PUBLIC_DASHBOARD_ORIGIN=https://admin.example.com

# The bundled ClickHouse, where the event spine lives - the Signals processes refuse to boot with
# nowhere to write. Point SIGNALS_CH_URL at a managed instance instead and this goes unused
CLICKHOUSE_PASSWORD=
# Only for --profile queue
# NATS_PASSWORD=

# Point any of these at a managed/external datastore and its *_PASSWORD above
# goes unused - the bundled container just isn't what you connect to
# DATABASE_URL=
# SIGNALS_DB_URL=
# VALKEY_URL=
# The evictable cache Valkey (caches, rate limiters, persisted queries) - defaults to the bundled valkey-cache (allkeys-lru) so a cache flood can't fill the noeviction auth primary - point it at a managed instance, or set it empty to fold caches back onto VALKEY_URL
# VALKEY_CACHE_URL=
# SIGNALS_QUEUE_URL=
# SIGNALS_CH_URL=
# SIGNALS_CH_MIGRATE_URL=

# Image tags for a registry deploy
# APP_IMAGE=ghcr.io/you/skelet-app:v1
# SIGNALS_IMAGE=ghcr.io/you/skelet-signals:v1
# DASHBOARD_IMAGE=ghcr.io/you/skelet-dashboard:v1
# VETRINA_DEMO_IMAGE=ghcr.io/you/skelet-vetrina-demo:v1

# Move a GraphQL endpoint off its known URL. Unset keeps /api/<surface>/graphql. Cuts scanner noise - the resolver permission gates are the real access control, and the segment still leaks via Referer, history and screenshots. ADMIN_API_SLUG also moves the X-Api-Token machine API, so update every integration with it, and set VITE_GRAPHQL_URL to match or the dashboard posts to a path that 404s. Set all three together - the SPA, its codegen introspection and the backend mount:
# ADMIN_API_SLUG=8to64charsAlnumDashUnderscore
# VITE_GRAPHQL_URL=/api/admin/8to64charsAlnumDashUnderscore/graphql
# GRAPHQL_CODEGEN_URL=http://app:8080/api/admin/8to64charsAlnumDashUnderscore/graphql
# FRONT_API_SLUG=
