# Backend env for dev. cp to env/go.env - what each var does: docs/env.md

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://skelet:skelet@db:5432/skelet?sslmode=disable
VALKEY_URL=redis://valkey:6379
# Session and link keys - ./skelet setup generates them all, and docs/env.md says which tier holds which
# Admin sessions, held by core alone
ADMIN_JWT_SECRET=change-me
# Customer sessions - an Ed25519 pair, the public half copied into env/signals.env
CUSTOMER_JWT_PRIVATE_KEY=
CUSTOMER_JWT_PUBLIC_KEY=
# Unsubscribe, open and click links - shared with the Signals processes
EMAIL_LINK_SECRET=change-me
# Anonymous review votes - shared with the storefront through the root .env
REVIEW_VOTER_TOKEN_SECRET=change-me
# Signs core's calls on the Signals contract - core and the suite alone, distinct from every key above (openssl rand -hex 32)
SIGNALS_SERVICE_SECRET=change-me-too
# openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=

# Unset SMTP_HOST prints mail to the app log - ./skelet up fills these in when the mailpit dev tool is picked
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_WEBHOOK_TOKEN=

# Include the scheme
STOREFRONT_URL=
DASHBOARD_URL=http://localhost:5173
STOREFRONT_REVALIDATE_URL=
STOREFRONT_REVALIDATE_SECRET=

# Lets the SEO link-map crawler past the front API's per-IP rate limit. A crawl drives thousands of SSR renders from one address, so without this the limiter refuses it partway and the storefront serves its own error pages - the map then reports breakage the crawl caused. Empty disables the bypass entirely.
SEO_CRAWL_BYPASS_TOKEN=
# Extra origins (comma-separated) a link-map crawl may start at, e.g. the storefront's compose address. The channel's public URL and STOREFRONT_URL are always allowed
SEO_CRAWL_ALLOWED_ORIGINS=

# Local Garage - ops on garage:3900, presigns on host 9900, reads on 9902
# Real AWS S3 leaves the endpoint vars empty and path style false
AWS_ACCESS_KEY_ID=skeletdev
AWS_SECRET_ACCESS_KEY=skeletdev-secret-not-for-prod
AWS_REGION=us-east-1
S3_BUCKET_NAME=media
S3_ENDPOINT_URL=http://garage:3900
S3_PRESIGN_ENDPOINT_URL=http://localhost:9900
S3_PUBLIC_URL_BASE=http://media.localhost:9902
S3_USE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=10485760

# Blank exports nothing - ./skelet up fills these in when the grafana dev tool is picked
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
APP_VERSION=

TRUSTED_PROXIES=
# Rate limiting and the login lockout are OFF unless this is true - dev leaves them
# off so nothing 429s you while clicking around. Per-surface knobs: docs/env.md
# RATE_LIMIT_ENABLED=true

# Moves a GraphQL endpoint behind an unguessable path segment - empty keeps /api/<surface>/graphql. Cuts scanner noise; the resolver permission gates are the actual access control. ADMIN_API_SLUG also moves the X-Api-Token machine API, so every integration and the dashboard's VITE_GRAPHQL_URL must be updated with it
ADMIN_API_SLUG=
FRONT_API_SLUG=

# ---- Feature suites - all default true, set false to switch one off entirely ----
# Signals is the analytics and marketing stack (Lens, Synapse, Pulse, Prism) - false makes every Signals resolver refuse and stops its jobs, transactional mail keeps going
SIGNALS_ENABLED=true
# Where cmd/signals serves the wire contract core calls - its own listener, since grpc needs one
SIGNALS_GRPC_ADDR=signals:8092
# Where the suite serves /t - core proxies beacons there rather than serving them itself
SIGNALS_INGEST_URL=http://signals:8090
# Where /e is served, the open pixel and click redirect in every marketing mail (cmd/signals and the ingest tier both do) - core
# proxies them there too, since the send log they name is the suite's
SIGNALS_URL=http://signals:8090
# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true
