# Storefront env, split from prod.env so the most exposed container holds no
# DB password / S3 keys / SMTP creds - what each var does: docs/env.md
#
# REVIEW_VOTER_TOKEN_SECRET and STOREFRONT_REVALIDATE_SECRET are shared with the backend, so
# compose injects them from the root .env - they're not repeated here. No session key reaches this container

STOREFRONT_BASE_URL=https://shop.example.com
# REQUIRED: at least one of the two. One deployment serves every channel - map each host to its
# channel uuid (admin > channels shows the ids), e.g. shop.example.com=<uuid>,de.shop.example.com=<uuid>.
# STOREFRONT_CHANNEL_ID pins a channel for every host the map doesn't name, which is all a
# one-channel shop needs; a host neither covers is a 404 rather than a guess
STOREFRONT_CHANNEL_HOSTS=
STOREFRONT_CHANNEL_ID=
# Domain for the ad and affiliate click-id cookies - empty sets them on the shop's host (minus a leading www.)
STOREFRONT_COOKIE_DOMAIN=

# NEXT_PUBLIC_ variant is baked at build time
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
