# Storefront env for astro-shop, split from small.env so the most exposed container holds no
# DB password / S3 keys / SMTP creds - what each var does: docs/env.md
#
# STOREFRONT_REVALIDATE_SECRET is shared with the backend, so compose injects it from the root .env.
# The backend purges one storefront: when this is it, set STOREFRONT_REVALIDATE_URL=http://astro-shop:3000/api/revalidate
# in small.env, or its pages stay stale until their hour runs out. Start it with --profile astro-shop.
# The canonical URL in every page's head comes from the channel's public URL (admin > channels)

# REQUIRED: the channel this storefront serves (admin > channels shows the ids). One storefront, one
# channel - a second market is a second deployment
STOREFRONT_CHANNEL_ID=
