# Caddy env - domains and the ACME contact, nothing else. cp to env/prod-caddy.env
#
# Only read when you run the opt-in edge:
#   docker compose -f docker-compose.prod.yml --profile edge up -d
#
# Each domain must already resolve to this host, or Let's Encrypt can't validate it.
# Routing table and what each host is for: README, Operations > Deploying
STOREFRONT_DOMAIN=shop.example.com
DASHBOARD_DOMAIN=admin.example.com
# Where payment providers POST their webhooks - skipping it means captures never settle
API_DOMAIN=api.example.com

# A real, monitored address - Caddy sends renewal-failure notices here, and an empty
# value breaks the Caddyfile parser rather than defaulting to something
ACME_EMAIL=ops@example.com
