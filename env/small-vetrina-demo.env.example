# Storefront half of the small profile - split from small.env so the most
# exposed container holds no DB password. cp to env/small-vetrina-demo.env
#
# JWT_SECRET and STOREFRONT_REVALIDATE_SECRET are shared with the backend, so
# compose injects them from the root .env - they're not repeated here
STOREFRONT_BASE_URL=http://localhost:13000
# REQUIRED. Channel uuid from admin > channels - a storefront serves exactly one channel.
# A second market means a second channel AND a second deployment of this app, not this one
# switching between them. Unset, the app refuses to serve rather than guess
STOREFRONT_CHANNEL_ID=

# openssl rand -hex 32
REVIEW_VOTER_TOKEN_SECRET=

SENTRY_DSN=
