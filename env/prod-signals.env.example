# What only the Signals process reads - cp to env/prod-signals.env, loaded by the `signals` service on top of env/prod.env
# Optional: without it the retention archive fails closed and the email builder's products block renders nothing - what each var does: docs/env.md

# Where the suite reads core's storefront API for the email builder's products block
CORE_FRONT_API_URL=http://app:8080/api/front/graphql

# ---- Analytics retention archive ---- skelet takes no database backups: that belongs to your infrastructure, see docs/backups.md.
# Setting BACKUP_S3_BUCKET enables the archive: with signals/analytics/retention_action on `archive`, aged
# spine events and send-log months are exported as identity-stripped .jsonl.gz under <prefix>archive/ before
# the rows are deleted. With no destination the sweep fails closed and deletes nothing.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=db/
