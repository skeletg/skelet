# Small-profile backend env - ONE app container runs every role, one Postgres holds both schemas. cp to env/small.env - what each var does: docs/env.md Signals is off here: switching it on means `--profile signals`, which adds the Signals process, its ClickHouse and their two migrations Not here on purpose: the secrets and the two DSNs, which compose injects from the root .env so a password and the URL using it cannot drift

APP_ENV=production
PORT=8080

# ---- Datastores - both schemas, one cluster, two databases ---- The DSNs come from the root .env (DB_PASSWORD, or DATABASE_URL / SIGNALS_DB_URL outright for a managed instance).
# Drop this to 0 once that instance has TLS
ALLOW_INSECURE_DB=1
DB_MAX_CONNS=10
ANALYTICS_DB_MAX_CONNS=4
# Read by the Signals process, so they only matter under --profile signals
SIGNALS_DB_MAX_CONNS=4
SIGNALS_READ_DB_MAX_CONNS=4

# ---- Everything optional, explicitly off ---- Empty VALKEY_URL degrades rate limiting to per-process counting and WS notification fanout to process-local, both correct for exactly one node
VALKEY_URL=
# No NATS - the ingest path writes the spine directly
SIGNALS_QUEUE_URL=
# Postgres search tier
OPENSEARCH_URL=

# ---- No split-out tiers - this is the collapse ---- Both false so the app process owns the scheduler, webhook delivery, the outbox relay, Signals retention/forwarding/trait-compute, and /media/t/*
JOBS_EXTERNAL=false

# ---- Networking ---- Loopback defaults match the offset ports in docker-compose.small.yml - a real tenant puts its own hostnames here, with the scheme
CORS_ALLOWED_ORIGINS=http://localhost:13000,http://localhost:18081
TRUSTED_PROXIES=172.16.0.0/12
# Every per-IP limiter plus the failed-login lockout, OFF unless this is true - see docs/env.md
RATE_LIMIT_ENABLED=true
STOREFRONT_URL=http://localhost:13000
DASHBOARD_URL=http://localhost:18081
STOREFRONT_REVALIDATE_URL=http://vetrina-demo:3000/api/revalidate

# ---- Media storage - NOT optional, the app refuses to boot without a bucket ---- Points at the dev Garage over the host-published port, which is what makes this runnable beside the dev stack
# a real tenant gets its own bucket or prefix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=skeletdev
AWS_SECRET_ACCESS_KEY=skeletdev-secret-not-for-prod
S3_BUCKET_NAME=media
S3_ENDPOINT_URL=http://host.docker.internal:9900
S3_PRESIGN_ENDPOINT_URL=http://localhost:9900
S3_PUBLIC_URL_BASE=http://media.localhost:9902
S3_USE_PATH_STYLE=true
S3_MAX_UPLOAD_BYTES=10485760

# ---- Unset here - no mail is sent until you fill this in ----
SMTP_HOST=
# The analytics retention archive's destination, not a database backup - see docs/backups.md for those
BACKUP_S3_BUCKET=
LOG_LEVEL=info

# ---- Feature suites - set one false to switch it off entirely ----
# Signals off here: the suite is a second process, started with `--profile signals` together with the ClickHouse its spine lives in
SIGNALS_ENABLED=false
# Only read when the switch above is true, and they name services the signals profile starts
SIGNALS_GRPC_ADDR=signals:8092
SIGNALS_URL=http://signals:8090
SIGNALS_INGEST_URL=http://signals:8090
CORE_FRONT_API_URL=http://app:8080/api/front/graphql
# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true
