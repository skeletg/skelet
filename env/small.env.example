# Small-profile backend env - ONE app container runs every role, one Postgres
# holds both schemas. cp to env/small.env - what each var does: docs/env.md
#
# This is the whole tenant config in one file, which is the point: Small ->
# Medium -> Large is this file changing, not a different build.
#
# Not here on purpose: JWT_SECRET, CONFIG_ENCRYPTION_KEY,
# STOREFRONT_REVALIDATE_SECRET and the two DSNs. Compose injects those from the
# root .env, so the password and the URL using it can't drift - see .env.example

APP_ENV=production
PORT=8080

# ---- Datastores - both schemas, one cluster, two databases ----
# The DSNs come from the root .env (DB_PASSWORD, or DATABASE_URL / SIGNALS_DB_URL
# outright for a managed instance). Drop this to 0 once that instance has TLS
ALLOW_INSECURE_DB=1
DB_MAX_CONNS=10
ANALYTICS_DB_MAX_CONNS=4
SIGNALS_DB_MAX_CONNS=4
SIGNALS_READ_DB_MAX_CONNS=4

# ---- Everything optional, explicitly off ----
# Empty VALKEY_URL degrades rate limiting to per-process counting and WS
# notification fanout to process-local, both correct for exactly one node
VALKEY_URL=
# No NATS - the ingest path writes the spine directly
SIGNALS_QUEUE_URL=
# Postgres spine, not ClickHouse
SIGNALS_ENGINE=
SIGNALS_CH_URL=
# Postgres search tier
OPENSEARCH_URL=

# ---- No split-out tiers - this is the collapse ----
# Both false so the app process owns the scheduler, webhook delivery, the outbox
# relay, Signals retention/forwarding/trait-compute, and /media/t/*
JOBS_EXTERNAL=false
SIGNALS_JOBS_EXTERNAL=false

# ---- Networking ----
# Loopback defaults match the offset ports in docker-compose.small.yml - a real
# tenant puts its own hostnames here, with the scheme
CORS_ALLOWED_ORIGINS=http://localhost:13000,http://localhost:18081
TRUSTED_PROXIES=172.16.0.0/12
# Every per-IP limiter plus the failed-login lockout, OFF unless this is true - see docs/env.md
RATE_LIMIT_ENABLED=true
STOREFRONT_URL=http://localhost:13000
DASHBOARD_URL=http://localhost:18081
STOREFRONT_REVALIDATE_URL=http://vetrina-demo:3000/api/revalidate

# ---- Media storage - NOT optional, the app refuses to boot without a bucket ----
# Points at the dev Garage over the host-published port, which is what makes this
# runnable beside the dev stack - a real tenant gets its own bucket or prefix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=skeletdev
AWS_SECRET_ACCESS_KEY=skeletdev-secret-not-for-prod
S3_BUCKET_NAME=media
S3_ENDPOINT_URL=http://host.docker.internal:9900
S3_PRESIGN_ENDPOINT_URL=http://localhost:9900
S3_PUBLIC_URL_BASE=http://media.localhost:9902
S3_USE_PATH_STYLE=true
S3_MAX_UPLOAD_BYTES=10485760

# ---- Unset here - no mail is sent and no backups are taken until you fill them ----
SMTP_HOST=
BACKUP_S3_BUCKET=
# One box means one thing to lose, so the dead-man's switch matters more here, not less -
# it's the only signal that catches a machine that stopped backing up rather than failing
# BACKUP_HEARTBEAT_URL=
LOG_LEVEL=info

# ---- Feature suites - all default true, set false to switch one off entirely ----
# Signals is the analytics stack (Lens, Synapse, Pulse, Prism) - false makes every Signals
# resolver refuse and stops its jobs, but signals-db stays required: transactional mail
# still records sends into email_sends, which lives there
SIGNALS_ENABLED=true
# The wholesale surface - companies, credit lines, quotes
B2B_ENABLED=true
# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true
