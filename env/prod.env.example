# Backend env (app + worker + media + signals + ingest + migrate)
# cp to env/prod.env and fill in - what each var does: docs/env.md
#
# Secrets are NOT here - passwords and connection strings live in the root .env
# because that's the only file compose interpolates - see .env.example

APP_ENV=production
PORT=8080

# ---- REQUIRED ----
CORS_ALLOWED_ORIGINS=

# ---- Datastores ----
# Drop this for a managed/remote Postgres and use sslmode=require
ALLOW_INSECURE_DB=1
# DATABASE_REPLICA_URL=postgres://skelet:CHANGE_ME@replica:5432/skelet?sslmode=require
# DB_MAX_CONNS=25
# ANALYTICS_DB_MAX_CONNS=8
# SIGNALS_DB_MAX_CONNS=8
# SIGNALS_REPLICA_URL=postgres://skelet:CHANGE_ME@signals-db-replica:5432/skelet_signals?sslmode=disable
# SIGNALS_READ_DB_MAX_CONNS=8
# Spine engine - unset/postgres uses the Signals database
# SIGNALS_ENGINE=clickhouse

# ---- Split-out tiers ----
# The prod compose ALWAYS runs the worker and signals containers, so these two must stay
# true - with them unset the app ALSO runs those jobs, and event-destination forwarding
# double-posts every batch to GA4/Meta/webhooks
SIGNALS_JOBS_EXTERNAL=true
JOBS_EXTERNAL=true
# INGEST_PORT=8091
# INGEST_PRIMARY_MAX_CONNS=4
# INGEST_SIGNALS_MAX_CONNS=16
# MEDIA_PORT=8083
# MEDIA_MAX_SOURCE_PIXELS=40000000
# MEDIA_RENDER_SLOTS=4
# MEDIA_DB_MAX_CONNS=2

# ---- Database pooler ----
# Prod compose derives these; set them only to point at something else. The DIRECT
# pair must be a real session - pg_dump and golang-migrate can't use a transaction
# pooler. Unset means "no pooler", and the pooled URL is used for both.
# DATABASE_DIRECT_URL=
# SIGNALS_DIRECT_URL=

# ---- Search ----
# OPTIONAL, empty falls back to the Postgres tier
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_FILE=

# ---- Networking ----
TRUSTED_PROXIES=172.16.0.0/12
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# ---- Rate limiting ----
# OFF by default. One flag turns on every per-IP limiter plus the failed-login
# lockout; per-surface budgets in docs/env.md. Production warns while it's off.
RATE_LIMIT_ENABLED=true
# LOGIN_LOCKOUT_ENABLED=true
# LOGIN_LOCKOUT_THRESHOLD=10

# ---- Storefront links / cache revalidation ----
STOREFRONT_URL=https://shop.example.com
DASHBOARD_URL=https://admin.example.com
STOREFRONT_REVALIDATE_URL=http://vetrina-demo:3000/api/revalidate

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_WEBHOOK_TOKEN=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164
TWILIO_FROM=

# ---- Media storage (S3-compatible, required for media) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_PRESIGN_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
S3_USE_PATH_STYLE=false
S3_MAX_UPLOAD_BYTES=10485760

# ---- Database backups (nightly pg_dump of both databases, streamed to a bucket) ----
# ENV-ONLY on purpose: were the destination admin config, anyone with settings access
# could redirect full dumps to a bucket they control. Setting BACKUP_S3_BUCKET enables
# the job. Use a DEDICATED bucket with its own credential (ideally write-only + bucket
# lifecycle/object-lock for delete protection - the app credential prunes retention).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts dumps with age - STRONGLY recommended (dumps hold all PII); store this
# passphrase somewhere durable OUTSIDE the host: losing it makes every backup unreadable
BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_S3_PREFIX=db/
# BACKUP_KEEP=30
# Dead-man's switch - pinged only after a fully successful run. Point it at
# healthchecks.io or similar: the scheduler alerts when the job FAILS, but only a
# monitor watching for these pings to stop catches the job never running at all
# BACKUP_HEARTBEAT_URL=

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
APP_VERSION=
# LOG_LEVEL=info

# ---- Feature suites - all default true, set false to switch one off entirely ----
# Signals is the analytics stack (Lens, Synapse, Pulse, Prism) - false makes every Signals
# resolver refuse and stops its jobs, but signals-db stays required: transactional mail
# still records sends into email_sends, which lives there
SIGNALS_ENABLED=true
# The wholesale surface - companies, credit lines, quotes
B2B_ENABLED=true
# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true

# ---- Optional tuning ----
# REQUEST_MAX_BODY_BYTES=8388608
# GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Moves a GraphQL endpoint behind an unguessable path segment -
# empty keeps /api/<surface>/graphql. Cuts scanner noise; the resolver permission gates are the
# actual access control. ADMIN_API_SLUG also moves the X-Api-Token machine API, so every
# integration and the dashboard's VITE_GRAPHQL_URL must be updated with it
ADMIN_API_SLUG=
FRONT_API_SLUG=
