# Backend env (app + worker + media + signals + ingest + migrate) cp to env/prod.env and fill in - what each var does: docs/env.md
# What only the Signals process reads lives in env/prod-signals.env, so its credentials stay out of the commerce containers

APP_ENV=production
PORT=8080

# ---- REQUIRED ----
CORS_ALLOWED_ORIGINS=

# ---- Datastores ----
# Drop this for a managed/remote Postgres and use sslmode=require
ALLOW_INSECURE_DB=1
# DATABASE_REPLICA_URL=postgres://skelet:CHANGE_ME@replica:5432/skelet?sslmode=require
# DB_MAX_CONNS=25
# ANALYTICS_DB_MAX_CONNS=8
# SIGNALS_DB_MAX_CONNS=8
# SIGNALS_REPLICA_URL=postgres://skelet:CHANGE_ME@signals-db-replica:5432/skelet_signals?sslmode=disable
# SIGNALS_READ_DB_MAX_CONNS=8

# ---- Split-out tiers ---- Hands the scheduler, webhook-queue, outbox and import/export claim loops to the worker
# each leases what it claims, so an app that also polls wastes connections, not work The prod compose sets this inline on `app`; this line is for other orchestrators
JOBS_EXTERNAL=true
# INGEST_PORT=8091
# INGEST_SIGNALS_MAX_CONNS=16
# MEDIA_PORT=8083
# MEDIA_MAX_SOURCE_PIXELS=40000000
# MEDIA_RENDER_SLOTS=4
# MEDIA_DB_MAX_CONNS=2

# ---- Search ----
# OPTIONAL, empty falls back to the Postgres tier
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_FILE=

# ---- Networking ----
# Every tier that reads a client address - core, the Signals process (core proxies /t and /e to it) and ingest - trusts the compose network's X-Forwarded-For
TRUSTED_PROXIES=172.16.0.0/12
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# ---- Rate limiting ---- OFF by default. One flag turns on every per-IP limiter plus the failed-login lockout; per-surface budgets in docs/env.md. Production warns while it's off.
RATE_LIMIT_ENABLED=true
# LOGIN_LOCKOUT_ENABLED=true
# LOGIN_LOCKOUT_THRESHOLD=10

# ---- Storefront links / cache revalidation ----
STOREFRONT_URL=https://shop.example.com
DASHBOARD_URL=https://admin.example.com
STOREFRONT_REVALIDATE_URL=http://vetrina-demo:3000/api/revalidate

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_WEBHOOK_TOKEN=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164
TWILIO_FROM=

# ---- Media storage (S3-compatible, required for media) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_PRESIGN_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
S3_USE_PATH_STYLE=false
S3_MAX_UPLOAD_BYTES=10485760

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
APP_VERSION=
# LOG_LEVEL=info

# ---- Feature suites - all default true, set false to switch one off entirely ----
# Signals is the analytics and marketing stack (Lens, Synapse, Pulse, Prism) - false makes every Signals resolver refuse and stops its jobs, transactional mail keeps going
SIGNALS_ENABLED=true
# Where cmd/signals serves the wire contract core calls - its own listener, since grpc needs one
# Unset, core has no suite to dial: the admin chat stops offering its Signals tools
SIGNALS_GRPC_ADDR=signals:8092
# Where the suite serves /t - core proxies beacons there rather than serving them itself
SIGNALS_INGEST_URL=http://signals:8090
# Where /e is served (the open pixel and click redirect) - cmd/signals and the ingest tier both do, so this can follow SIGNALS_INGEST_URL
SIGNALS_URL=http://signals:8090
# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true

# ---- Optional tuning ----
# REQUEST_MAX_BODY_BYTES=8388608
# GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Moves a GraphQL endpoint behind an unguessable path segment - empty keeps /api/<surface>/graphql. Cuts scanner noise; the resolver permission gates are the actual access control. ADMIN_API_SLUG also moves the X-Api-Token machine API, so every integration and the dashboard's VITE_GRAPHQL_URL must be updated with it
ADMIN_API_SLUG=
FRONT_API_SLUG=
