# Signals env for dev (the signals and ingest services) - ./skelet setup and ./skelet up copy it to env/signals.env - what each var does: docs/env.md
# Only what the suite reads: its own database, spine and queue URLs come from docker-compose.yml, and core's DATABASE_URL and CONFIG_ENCRYPTION_KEY never reach it

APP_ENV=development
# These have to match env/go.env, so ./skelet up copies them across from there on every start - edit them in go.env
# The customer session PUBLIC key only - the suite checks a session and can mint none
CUSTOMER_JWT_PUBLIC_KEY=
EMAIL_LINK_SECRET=change-me
SIGNALS_SERVICE_SECRET=change-me-too
VALKEY_URL=redis://valkey:6379

# Local Mailpit, the same relay core sends through
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Local Garage, for the email builder's image uploads
AWS_ACCESS_KEY_ID=skeletdev
AWS_SECRET_ACCESS_KEY=skeletdev-secret-not-for-prod
AWS_REGION=us-east-1
S3_BUCKET_NAME=media
S3_ENDPOINT_URL=http://garage:3900
S3_PRESIGN_ENDPOINT_URL=http://localhost:9900
S3_PUBLIC_URL_BASE=http://media.localhost:9902
S3_USE_PATH_STYLE=true

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
APP_VERSION=

# Rate limiting is OFF unless this is true, as in core
# RATE_LIMIT_ENABLED=true

# Where the suite reads core's storefront API - the email builder's products block. Unset, the block renders nothing
CORE_FRONT_API_URL=http://app:8080/api/front/graphql

# The retention archive's destination - unset, retention_action=archive fails closed and deletes nothing
BACKUP_S3_BUCKET=
