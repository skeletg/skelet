# Prod storefront image - Next.js standalone output on a small node base
# Build: docker build -f Dockerfile.prod -t skelet-vetrina-demo:prod apps/channels/vetrina-demo
# Runtime config: BACKEND_INTERNAL_URL (default http://app:8080), STOREFRONT_CHANNEL_HOSTS and/or STOREFRONT_CHANNEL_ID

FROM node:24-alpine AS build
RUN npm install -g pnpm@12.6.0
WORKDIR /app
# The workspace file carries the build policy the lockfile was resolved under
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile --store-dir /pnpm/store
COPY . .

ARG NEXT_PUBLIC_DASHBOARD_ORIGIN
ENV NEXT_PUBLIC_DASHBOARD_ORIGIN=$NEXT_PUBLIC_DASHBOARD_ORIGIN
# next.config.ts bakes it into the CSP at build
ARG UPLOAD_ORIGINS
ENV UPLOAD_ORIGINS=$UPLOAD_ORIGINS

# No channel and no backend at build time: the host picks the channel per request, and pages render on first visit
RUN pnpm run build

FROM node:24-alpine AS run
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app
# server.js doesn't serve public/ or .next/static itself - copy them in
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
# The ISR cache writes here at runtime, as the unprivileged user
RUN mkdir -p .next/cache && chown app:app .next/cache
USER app
EXPOSE 3000
CMD ["node", "server.js"]
