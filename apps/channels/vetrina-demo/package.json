{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@sentry/nextjs": "^10.71.0",
    "graphql": "^16.14.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.6",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrweb": "^2.1.1",
    "rrweb-snapshot": "^2.1.1",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.0",
    "zod": "^4.6.5"
