---
import { ButtonLink } from "../components/ui";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="mx-auto max-w-md py-16 text-center">
    <p class="text-sm font-semibold text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">We couldn't find that page</h1>
    <p class="mt-3 text-muted-foreground">It may have moved, or it's no longer for sale.</p>
    <ButtonLink href="/" className="mt-8">Back to the shop</ButtonLink>
  </section>
</Base>
