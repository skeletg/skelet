---
import { Price } from "../components/Price";
import Choice from "../components/Choice.astro";
import Field from "../components/Field.astro";
import { Button, Notice } from "../components/ui";
import Base from "../layouts/Base.astro";
import { cartId, forgetCart } from "../lib/cart";
import { getChannel } from "../lib/channel";
import { gql, GqlError, shopperMessage } from "../lib/gql";
import {
  CheckoutDocument,
  CountriesDocument,
  PaymentOptionsDocument,
  PlaceDocument,
  SetDeliveryDocument,
  SetDestinationDocument,
  SetDetailsDocument,
  SetPaymentDocument,
} from "../graphql/checkout.gql";

// Two steps, both plain forms: where it's going (prices delivery), then delivery + details + payment in one submit.
// The backend's requirements decide what's missing - placeOrder refuses until they're met (docs/checkout.md)
const id = cartId(Astro.cookies);
if (!id) return Astro.redirect("/cart");

let error: string | undefined;
let posted: FormData | undefined;
const field = (name: string, fallback?: string | null) => String(posted?.get(name) ?? fallback ?? "");
// A radio group's pick: what was just posted, else what the cart has saved, else the first option
const chosen = (name: string, saved?: string | null, first?: string) => (posted ? field(name) : (saved ?? first));

const saveDelivery = async (form: FormData) => {
  for (const group of form.getAll("group").map(String)) {
    const [optionId, carrierSlug, methodCode] = field(`delivery:${group}`).split("|");
    if (!optionId || !carrierSlug || !methodCode) throw new GqlError("Choose a delivery option", "VALIDATION");
    await gql(SetDeliveryDocument, { cartId: id, groupKey: group, optionId, carrierSlug, methodCode });
  }
};

if (Astro.request.method === "POST") {
  posted = await Astro.request.formData();
  const intent = field("intent");
  try {
    if (intent === "destination") {
      await gql(SetDestinationDocument, { cartId: id, countryCode: field("countryCode"), postalCode: field("postalCode").trim() });
      return Astro.redirect("/checkout", 303);
    }
    // A changed delivery pick reprices the summary - no redirect, so the page re-renders with what was typed kept
    if (intent === "delivery") await saveDelivery(posted);
    if (intent === "place") {
      await saveDelivery(posted);
      const opt = (name: string) => field(name).trim() || null;
      await gql(SetDetailsDocument, {
        cartId: id,
        input: {
          email: field("email").trim(),
          phone: opt("phone"),
          billingSameAsShipping: true,
          shippingAddress: {
            firstName: field("firstName").trim(),
            lastName: field("lastName").trim(),
            street1: field("street1").trim(),
            street2: opt("street2"),
            city: field("city").trim(),
            state: opt("state"),
            postalCode: field("postalCode").trim(),
            countryCode: field("countryCode"),
            phone: opt("phone"),
          },
        },
      });
      await gql(SetPaymentDocument, { cartId: id, providerSlug: field("payment") });
      const { placeOrder } = await gql(PlaceDocument, { cartId: id, acceptTerms: field("acceptTerms") === "on" });
      // shortcut: card gateways that confirm in the browser (3DS) aren't wired - offline methods only, add the gateway's client step for cards
      forgetCart(Astro.cookies);
      return Astro.redirect(`/order-placed?n=${encodeURIComponent(placeOrder.number)}`, 303);
    }
  } catch (err) {
    error = shopperMessage(err, "We couldn't place your order - please try again.");
  }
}

const [{ cart }, channel] = await Promise.all([gql(CheckoutDocument, { id }), getChannel()]);
if (!cart || cart.lines.length === 0) return Astro.redirect("/cart");
const c = cart.checkout;
const dest = Astro.url.searchParams.get("step") === "destination" ? null : c.destination;
const [{ countries }, payments] = await Promise.all([
  gql(CountriesDocument),
  dest ? gql(PaymentOptionsDocument, { countryCode: dest.countryCode, cartId: id }).then((r) => r.paymentMethods) : [],
]);
const currency = channel.currency;
const addr = c.shippingAddress;
// shortcut: door delivery only - pickup points and store pickup need their own pickers
const groups = c.deliveryGroups.map((g) => ({ ...g, choices: g.choices.filter((ch) => ch.kind === "ship_to_address") }));
const choiceValue = (ch: { optionId: string; carrierSlug: string; methodCode: string }) => `${ch.optionId}|${ch.carrierSlug}|${ch.methodCode}`;
const country = countries.find((x) => x.code === dest?.countryCode);
const picks = new Map(groups.map((g) => [g.key, chosen(`delivery:${g.key}`, g.selection && choiceValue(g.selection), g.choices[0] && choiceValue(g.choices[0]))]));
const pickedPayment = chosen("payment", c.paymentProviderSlug, payments[0]?.providerSlug);
const sectionTitle = "mb-4 flex items-center gap-3 text-lg font-semibold";
const stepDot = "grid size-7 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground";
---

<Base title="Checkout" noindex transitions={false}>
  <h1 class="mb-8 text-3xl font-semibold tracking-tight sm:text-4xl">Checkout</h1>
  {error && <Notice>{error}</Notice>}

  <div class="grid items-start gap-10 lg:grid-cols-[1fr_380px]">
    <div>
      {
        !dest ? (
          <form method="post" class="grid gap-6 rounded-3xl border border-border bg-card p-6 sm:p-8">
            <h2 class={sectionTitle}><span class={stepDot}>1</span>Where should we send it?</h2>
            <input type="hidden" name="intent" value="destination" />
            <div class="grid gap-4 sm:grid-cols-2">
              <Field label="Country">
                <select name="countryCode" required autocomplete="country">
                  {countries.map((x) => (
                    <option value={x.code} selected={x.code === (c.destination?.countryCode ?? field("countryCode"))}>{x.name}</option>
                  ))}
                </select>
              </Field>
              <Field label="Postal code">
                <input name="postalCode" required autocomplete="postal-code" value={field("postalCode", c.destination?.postalCode)} />
              </Field>
            </div>
            <Button type="submit" className="justify-self-start">Continue</Button>
          </form>
        ) : (
          <form method="post" id="checkout-details" class="grid gap-10">
            <input type="hidden" name="countryCode" value={dest.countryCode} />
            <input type="hidden" name="postalCode" value={dest.postalCode} />

            <section>
              <h2 class={sectionTitle}><span class={stepDot}>1</span>Delivery</h2>
              <p class="-mt-2 mb-4 text-sm text-muted-foreground">
                To {country?.name ?? dest.countryCode} {dest.postalCode} ·{" "}
                <a href="/checkout?step=destination" class="text-foreground underline underline-offset-4">Change</a>
              </p>
              {groups.map((g) => (
                <fieldset class="grid gap-2">
                  <legend class="sr-only">Delivery option</legend>
                  <input type="hidden" name="group" value={g.key} />
                  {g.choices.length === 0 && <Notice>These items can't be delivered there.</Notice>}
                  {g.choices.map((ch) => (
                    <Choice name={`delivery:${g.key}`} value={choiceValue(ch)} checked={choiceValue(ch) === picks.get(g.key)} autosubmit="update-shipping">
                      <span class="flex-1">
                        {ch.methodName || ch.optionName}
                        {ch.estimatedArrival && (
                          <span class="block text-sm text-muted-foreground">
                            Arrives {new Date(ch.estimatedArrival).toLocaleDateString(channel.defaultLocale, { weekday: "short", day: "numeric", month: "short" })}
                          </span>
                        )}
                      </span>
                      <span class="font-medium">{ch.priceCents === 0 ? "Free" : <Price amount={ch.priceCents} currency={currency} />}</span>
                    </Choice>
                  ))}
                </fieldset>
              ))}
            </section>

            <section>
              <h2 class={sectionTitle}><span class={stepDot}>2</span>Contact and address</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                <Field label="Email" wide><input type="email" name="email" required autocomplete="email" value={field("email", c.email)} /></Field>
                <Field label="First name"><input name="firstName" required autocomplete="given-name" value={field("firstName", addr?.firstName)} /></Field>
                <Field label="Last name"><input name="lastName" required autocomplete="family-name" value={field("lastName", addr?.lastName)} /></Field>
                <Field label="Address" wide><input name="street1" required autocomplete="address-line1" value={field("street1", addr?.street1)} /></Field>
                <Field label="Apartment, suite" optional wide><input name="street2" autocomplete="address-line2" value={field("street2", addr?.street2)} /></Field>
                <Field label="City"><input name="city" required autocomplete="address-level2" value={field("city", addr?.city)} /></Field>
                <Field label="State / region"><input name="state" autocomplete="address-level1" value={field("state", addr?.state)} /></Field>
                <Field label="Phone" optional wide><input type="tel" name="phone" autocomplete="tel" value={field("phone", addr?.phone)} /></Field>
              </div>
            </section>

            <section>
              <h2 class={sectionTitle}><span class={stepDot}>3</span>Payment</h2>
              {payments.length === 0 && <Notice>No payment method is available for this country.</Notice>}
              <fieldset class="grid gap-2">
                <legend class="sr-only">Payment method</legend>
                {payments.map((p) => (
                  <Choice name="payment" value={p.providerSlug} checked={p.providerSlug === pickedPayment}>
                    <span class="flex-1">
                      {p.displayName}
                      {p.instructions && <span class="block text-sm text-muted-foreground">{p.instructions}</span>}
                    </span>
                  </Choice>
                ))}
              </fieldset>
            </section>

            <div class="grid gap-4">
              <label class="flex items-center gap-3 text-sm">
                <input type="checkbox" name="acceptTerms" required checked={field("acceptTerms") === "on"} class="size-5 min-h-0 w-auto accent-primary" />
                I accept the terms and conditions
              </label>
              <Button type="submit" name="intent" value="place" className="w-full text-lg" disabled={payments.length === 0 || groups.some((g) => g.choices.length === 0)}>
                Place order
              </Button>
            </div>
          </form>
        )
      }
    </div>

    <!-- Swapped in after a delivery pick (enhance.ts), so shipping and the total follow the choice -->
    <aside class="rounded-3xl border border-border bg-card p-6 lg:sticky lg:top-24" aria-label="Order summary" data-summary>
      <h2 class="mb-4 text-lg font-semibold">Order summary</h2>
      <ul class="grid gap-3 border-b border-border pb-4">
        {
          cart.lines.map((l) => (
            <li class="flex justify-between gap-3 text-sm">
              <span>
                {l.name} <span class="text-muted-foreground">× {l.quantity}</span>
              </span>
              <Price amount={l.totalPrice} currency={currency} />
            </li>
          ))
        }
      </ul>
      <dl class="mt-4 grid gap-2 text-sm">
        <div class="flex justify-between"><dt class="text-muted-foreground">Subtotal</dt><dd><Price amount={c.totals.subtotalCents} currency={currency} /></dd></div>
        {c.totals.discountCents > 0 && <div class="flex justify-between text-success"><dt>Discount</dt><dd>−<Price amount={c.totals.discountCents} currency={currency} /></dd></div>}
        {dest && <div class="flex justify-between"><dt class="text-muted-foreground">Shipping</dt><dd>{c.totals.shippingCents === 0 ? "Free" : <Price amount={c.totals.shippingCents} currency={currency} />}</dd></div>}
        {c.totals.taxCents > 0 && <div class="flex justify-between"><dt class="text-muted-foreground">Tax</dt><dd><Price amount={c.totals.taxCents} currency={currency} /></dd></div>}
        <div class="mt-2 flex justify-between border-t border-border pt-3 text-base font-semibold"><dt>Total</dt><dd data-total><Price amount={c.totals.totalCents} currency={currency} /></dd></div>
      </dl>
      {
        dest && (
          // Without scripts a delivery pick reprices through this; with them, each pick submits through it on its own
          <button
            type="submit"
            id="update-shipping"
            form="checkout-details"
            name="intent"
            value="delivery"
            formnovalidate
            data-enhance="[data-summary]"
            class="mt-4 text-sm text-foreground underline underline-offset-4 js:hidden"
          >
            Update shipping
          </button>
        )
      }
    </aside>
  </div>
</Base>
