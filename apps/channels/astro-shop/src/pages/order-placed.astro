---
import { ButtonLink } from "../components/ui";
import Base from "../layouts/Base.astro";

// The number is only echoed back - the order itself isn't read, so this page reveals nothing
const number = Astro.url.searchParams.get("n")?.slice(0, 40);
---

<Base title="Thank you" noindex transitions={false}>
  <section class="mx-auto grid max-w-lg justify-items-center gap-3 py-16 text-center">
    <span aria-hidden="true" class="grid size-14 place-items-center rounded-full bg-success/15 text-2xl text-success" data-reveal>✓</span>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Thank you for your order</h1>
    {number && <p class="text-lg">Your order number is <strong data-order-number>{number}</strong>.</p>}
    <p class="text-muted-foreground">We've emailed you a confirmation with the details.</p>
    <ButtonLink href="/" className="mt-6">Back to the shop</ButtonLink>
  </section>
</Base>
