---
import { Price } from "../components/Price";
import { QuantityInput } from "../components/QuantityInput";
import { Button, ButtonLink, Notice } from "../components/ui";
import Base from "../layouts/Base.astro";
import { bumpBadge, cartAction, cartId, forgetCart, rememberCart, setFlash, takeFlash, withCart } from "../lib/cart";
import { getChannel } from "../lib/channel";
import { gql, shopperMessage } from "../lib/gql";
import { AddLineDocument, CartDocument, RemoveLineDocument, UpdateLineDocument } from "../graphql/cart.gql";

// Never cached: everything here is one shopper's. Mutations post here and redirect back (post/redirect/get), so no JS is needed
if (Astro.request.method === "POST") {
  const action = cartAction(await Astro.request.formData());
  try {
    if (!action) throw new Error("bad cart form");
    const cart = await withCart(Astro.cookies, async (cartId) => {
      if (action.intent === "add") return (await gql(AddLineDocument, { cartId, sku: action.sku, quantity: action.quantity })).addToCart;
      if (action.intent === "remove") return (await gql(RemoveLineDocument, { cartId, lineId: action.lineId })).removeFromCart;
      return (await gql(UpdateLineDocument, { cartId, lineId: action.lineId, quantity: action.quantity })).updateCartLine;
    });
    rememberCart(Astro.cookies, cart);
    if (action.intent === "add") bumpBadge(Astro.cookies);
  } catch (err) {
    setFlash(Astro.cookies, shopperMessage(err, "That didn't work - please try again."));
  }
  return Astro.redirect("/cart", 303);
}

const id = cartId(Astro.cookies);
const [cart, channel] = await Promise.all([id ? gql(CartDocument, { id }).then((r) => r.cart) : null, getChannel()]);
if (id && !cart) forgetCart(Astro.cookies);
else if (cart) rememberCart(Astro.cookies, cart);
const flash = takeFlash(Astro.cookies);
const lines = cart?.lines ?? [];
const currency = channel.currency;
// shortcut: a line's +/- and arrows step by 1 whatever the product's quantity step, fetch the step on the line if fractional goods sell here
---

<Base title="Cart" noindex transitions={false}>
  <h1 class="mb-8 text-3xl font-semibold tracking-tight sm:text-4xl">Your cart</h1>
  <!-- What a background post (enhance.ts) swaps in - the lines, the totals and any message, all together -->
  <div data-cart>
    {flash && <Notice>{flash}</Notice>}

    {
      lines.length === 0 || !cart ? (
        <div class="rounded-3xl border border-dashed border-border px-6 py-16 text-center">
          <p class="text-lg font-medium">Your cart is empty</p>
          <p class="mt-2 text-muted-foreground">Find something you'll love in the shop.</p>
          <ButtonLink href="/" className="mt-6">Keep shopping</ButtonLink>
        </div>
      ) : (
        <div class="grid items-start gap-10 lg:grid-cols-[1fr_360px]">
          <ul class="divide-y divide-border border-y border-border">
            {lines.map((l) => (
              <li class="grid grid-cols-[72px_1fr_auto] gap-4 py-5 sm:grid-cols-[88px_1fr_auto]" data-line>
                <div class="aspect-4/5 overflow-hidden rounded-xl bg-muted">
                  {l.imageUrl && <img src={l.imageUrl} alt="" width="88" height="110" loading="lazy" class="h-full w-full object-cover" />}
                </div>
                <div class="min-w-0">
                  <p class="font-medium">{l.name}</p>
                  <p class="mt-0.5 text-sm text-muted-foreground"><Price amount={l.unitPrice} currency={currency} /> each</p>
                  <div class="mt-3 flex flex-wrap items-center gap-4">
                    <form method="post" class="flex items-center gap-2" data-enhance="[data-cart]">
                      <input type="hidden" name="intent" value="update" />
                      <input type="hidden" name="lineId" value={l.id} />
                      <QuantityInput id={`qty-${l.id}`} value={l.quantity} label={`Quantity for ${l.name}`} item={l.name} autosubmit />
                      <Button variant="ghost" type="submit" className="min-h-11 px-4 text-sm js:hidden">Update</Button>
                    </form>
                    <form method="post" data-enhance="[data-cart]">
                      <input type="hidden" name="intent" value="remove" />
                      <input type="hidden" name="lineId" value={l.id} />
                      <button type="submit" class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Remove</button>
                    </form>
                  </div>
                </div>
                <p class="font-semibold"><Price amount={l.totalPrice} currency={currency} /></p>
              </li>
            ))}
          </ul>
          <aside class="grid gap-3 rounded-3xl border border-border bg-card p-6 lg:sticky lg:top-24">
            <h2 class="text-lg font-semibold">Summary</h2>
            <p class="flex justify-between"><span class="text-muted-foreground">Subtotal</span><Price amount={cart.subtotal} currency={currency} className="font-semibold" /></p>
            {cart.totalDiscount > 0 && (
              <p class="flex justify-between text-success"><span>Discount</span><span>−<Price amount={cart.totalDiscount} currency={currency} /></span></p>
            )}
            <p class="text-sm text-muted-foreground">Shipping and tax are worked out at checkout.</p>
            <ButtonLink href="/checkout" className="mt-2 w-full">Checkout</ButtonLink>
          </aside>
        </div>
      )
    }
  </div>
</Base>
