---
import { getSite } from "../lib/channel";
import { absolute, jsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: "website" | "product";
  // Cart, checkout and error pages - kept out of the index, links still followed
  noindex?: boolean;
  structured?: unknown[];
}

const { title, description, image, type = "website", noindex = false, structured = [] } = Astro.props;
const { channel, origin } = await getSite(Astro.url.origin);
// Query strings never make a second canonical page
const canonical = absolute(origin, Astro.url.pathname);
const fullTitle = title ? `${title} · ${channel.name}` : channel.name;
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<meta property="og:site_name" content={channel.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? channel.name} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={channel.defaultLocale.replace("-", "_")} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
{structured.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
