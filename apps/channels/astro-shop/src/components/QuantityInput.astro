---
// A quantity box between - and + buttons. The buttons need scripts (enhance.ts steps the box), so without
// them only the box shows - typing and the keyboard's arrow keys still work
interface Props {
  id: string;
  value: number;
  min?: number;
  max?: number | null;
  step?: number | null;
  // The screen-reader name of the box, and what the buttons say they add or take away
  label: string;
  item?: string;
  // Changes post the form by themselves, once the clicks or typing settle (the cart's lines)
  autosubmit?: boolean;
  // Show the box's native up/down arrows as well as - and +
  arrows?: boolean;
}

const { id, value, min = 0, max, step, label, item, autosubmit = false, arrows = false } = Astro.props;
const what = item ? ` ${item}` : "";
const stepClass = "hidden size-11 shrink-0 place-items-center rounded-full text-lg text-muted-foreground transition-colors hover:text-foreground js:grid";
---

<div class="inline-flex items-center rounded-full border border-border bg-card">
  <button type="button" id={`${id}-less`} data-step="-1" aria-label={`One fewer${what}`} class={stepClass}>−</button>
  <label>
    <span class="sr-only">{label}</span>
    <input
      type="number"
      id={id}
      name="quantity"
      value={value}
      min={min}
      max={max ?? undefined}
      step={step ?? "any"}
      inputmode="decimal"
      data-autosubmit={autosubmit ? "" : undefined}
      data-arrows={arrows ? "" : undefined}
      class:list={[
        "w-20 rounded-full border-0 bg-transparent text-center focus:border-0",
        // The arrows take room on the right, so the number keeps off them
        arrows ? "pl-4 pr-2 js:w-16 js:pl-2" : "px-3 js:w-12 js:px-0",
      ]}
    />
  </label>
  <button type="button" id={`${id}-more`} data-step="1" aria-label={`One more${what}`} class={stepClass}>+</button>
</div>
