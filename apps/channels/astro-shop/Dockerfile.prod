# Prod storefront image - Astro's standalone Node server on a small node base
# Build: docker build -f Dockerfile.prod -t skelet-astro-shop:prod apps/channels/astro-shop
# Runtime config: BACKEND_INTERNAL_URL (default http://app:8080), STOREFRONT_CHANNEL_ID, STOREFRONT_REVALIDATE_SECRET

FROM node:24-alpine AS build
RUN npm install -g pnpm@12.6.0
WORKDIR /app
# The workspace file carries the build policy the lockfile was resolved under
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile --store-dir /pnpm/store
COPY . .
# No channel and no backend at build time: every page renders on demand, then sits in the route cache
RUN pnpm run build \
    # The server bundle imports its runtime dependencies, so the image keeps the production half of node_modules
    && pnpm prune --prod --config.confirm-modules-purge=false

FROM node:24-alpine AS run
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app
COPY --from=build --chown=app:app /app/package.json ./
COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/dist ./dist
USER app
EXPOSE 3000
CMD ["node", "dist/server/entry.mjs"]
