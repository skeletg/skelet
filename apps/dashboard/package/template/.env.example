# The admin GraphQL endpoint - relative when the dashboard is served from the API's own host, absolute otherwise
VITE_GRAPHQL_URL=/api/admin/graphql
# Where the CMS and blog previews frame the storefront
VITE_STOREFRONT_ORIGIN=https://shop.example.com
# Hosts the dashboard uploads to directly, for the CSP
UPLOAD_ORIGINS=
# Error monitoring, off when empty
VITE_SENTRY_DSN=
