# Signals' settings and secrets - cp to .env beside compose.yaml and fill in - what each var does: docs/env.md

APP_ENV=production
# SIGNALS_IMAGE=ghcr.io/you/skelet-signals:v1
COMPOSE_PROFILES=bundled,valkey
SIGNALS_BIND=127.0.0.1

SIGNALS_SERVICE_SECRET=
EMAIL_LINK_SECRET=
CUSTOMER_JWT_PUBLIC_KEY=
TRUSTED_PROXY_KEY=

# ---- Datastores ----
SIGNALS_DB_PASSWORD=
CLICKHOUSE_PASSWORD=
SIGNALS_VALKEY_PASSWORD=
# Drop this for a managed/remote Postgres and use sslmode=require
ALLOW_INSECURE_DB=1
# SIGNALS_DB_URL=
# SIGNALS_REPLICA_URL=postgres://skelet:CHANGE_ME@signals-db-replica:5432/skelet_signals?sslmode=disable
# SIGNALS_DB_MAX_CONNS=8
# SIGNALS_READ_DB_MAX_CONNS=8
# SIGNALS_CH_URL=clickhouse://user:password@host:9440/signals?secure=true
# VALKEY_CACHE_URL=
# Only for --profile queue
# NATS_PASSWORD=
# SIGNALS_QUEUE_URL=
# The primary Valkey, where core publishes killed admin sessions - optional, without it revoked tokens live out their two minutes
VALKEY_URL=

# ---- Core to Signals ----
# Where the suite reads core's storefront API for the email builder's products block
CORE_FRONT_API_URL=http://app:8080/api/front/graphql
INGEST_FALLBACK_URL=http://app:8080
# SIGNALS_GRPC_TLS_CERT=/certs/signals.pem
# SIGNALS_GRPC_TLS_KEY=/certs/signals-key.pem

# ---- Networking ----
TRUSTED_PROXIES=172.16.0.0/12
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true
RATE_LIMIT_ENABLED=true
# INGEST_PORT=8091
# INGEST_SIGNALS_MAX_CONNS=16

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false

# ---- Analytics retention archive ---- skelet takes no database backups: that belongs to your infrastructure, see docs/backups.md.
# Setting BACKUP_S3_BUCKET enables the archive: with signals/analytics/retention_action on `archive`, aged
# spine events and send-log months are exported as identity-stripped .jsonl.gz under <prefix>archive/ before
# the rows are deleted. With no destination the sweep fails closed and deletes nothing.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=db/

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
APP_VERSION=
# LOG_LEVEL=info
# GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb
