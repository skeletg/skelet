{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Run one node of a marketing flow. The returned context is shallow-merged into the run's context; branch picks the next edge.",
  "properties": {
    "request": {
      "properties": {
        "context": {},
        "customerId": {
          "type": "string"
        },
        "flowId": {
          "type": "string"
        }
      },
      "required": [
        "customerId",
        "flowId"
      ],
      "title": "remoteActionRequest",
      "type": "object"
    },
    "response": {
      "properties": {
        "branch": {
          "type": "string"
        },
        "context": {}
      },
      "required": [
        "branch",
        "context"
      ],
      "title": "remoteActionResponse",
      "type": "object"
    }
  },
  "title": "flow_action",
  "x-kind": "flow_action",
  "x-source": "internal/flow.remoteActionRequest -\u003e internal/flow.remoteActionResponse"
}
