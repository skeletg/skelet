enum PromotionStopMode {
  NONE
  SAME_ACTION_TYPE
  ALL
}

type PromotionRule {
  id:                  ID!
  slug:                String!
  name:                String!
  description:         String!
  publicLabel:     String!
  channelId:         ID
  requiresCode:        Boolean!
  priority:            Int!
  stopAfterApply:      PromotionStopMode!
  exclusivityGroup:    String!
  validFrom:           Time
  validTo:             Time
  scheduleJson:        JSON
  maxUses:             Int
  perCustomerLimit:    Int
  usedCount:           Int!
  isActive:            Boolean!
  conditions:          [PromotionCondition!]!
  actions:             [PromotionAction!]!
  codes(limit: Int = 50, offset: Int = 0): PromotionCodeList!
  contents:            [PromotionRuleContent!]!
  createdByAdminId:    ID
  updatedByAdminId:    ID
  # Promotional creative. Label = small corner sticker overlaid on
  # product listing cards. Banner = wide hero strip on the product
  # detail page. Both nullable; rules with no media render text-only.
  labelMediaId:        ID
  bannerMediaId:       ID
  labelMedia:          MediaAsset
  bannerMedia:         MediaAsset
  # Stylable text pill - fallback for promos without a label image
  # but still wanting a coloured badge. Empty pillText = no pill.
  # pillTextColor and pillBgColor are CSS strings (#RRGGBB); empty
  # = storefront default palette.
  pillText:            String!
  pillTextColor:       String!
  pillBgColor:         String!
  createdAt:           Time!
  updatedAt:           Time!
}

# Per-locale storefront-visible label + terms text. Cart UI resolves
# label by the request's Locale header; empty rows fall back to the
# rule's own public_label.
type PromotionRuleContent {
  locale:    String!
  label:     String!
  terms:     String!
  updatedAt: Time!
}

# Per-rule redemption analytics. Backed by promotion_redemptions joined
# to orders for revenue accumulation. Date range filter on the query
# scopes the count and totals.
# Money fields are int64 cents via the Int64 scalar - a lifetime discount
# or revenue total overflows the 32-bit Int scalar, same as the sales reports.
type PromotionRuleAnalytics {
  ruleId:             ID!
  ruleSlug:           String!
  ruleName:           String!
  redemptionCount:    Int!
  discountTotalCents: Int64!
  uniqueCustomers:    Int!
  orderRevenueCents:  Int64!
}

type PromotionAnalyticsTotals {
  redemptionCount:    Int!
  discountTotalCents: Int64!
  uniqueCustomers:    Int!
}

# One day's redemption + discount bucket. Powers the promotions hub
# trend chart (all rules) and per-promotion trends (ruleId set).
type PromotionAnalyticsDailyPoint {
  date:               String!
  redemptionCount:    Int!
  discountTotalCents: Int64!
}

# Result of the simulatePromotion admin query. Carries the engine's
# trace so operators can see exactly which rules matched / skipped /
# shadowed for a hypothetical cart.
type PromotionSimulationResult {
  appliedRuleIds:        [ID!]!
  subtotalDiscountCents: Int!
  freeShipping:          Boolean!
  trace:                 [PromotionTraceEntry!]!
}

type PromotionTraceEntry {
  ruleId:         ID!
  ruleSlug:       String!
  priority:       Int!
  matched:        Boolean!
  skipReason:     String!
  discountCents:  Int!
  stopAfterApply: PromotionStopMode!
}

input PromotionSimulationInput {
  subtotalCents:     Int!
  currency:          String
  countryCode:       String
  customerGroupSlug: String
  customerSegmentSlugs: [String!]
  appliedCodes:      [String!]
  lines:             [PromotionSimulationLineInput!]!
}

input PromotionSimulationLineInput {
  productSku:     String!
  quantity:       Float!
  unitPriceCents: Int!
  productKind:    String
  categoryIds:    [ID!]
}

input UpsertPromotionRuleContentInput {
  ruleId: ID!
  locale: String!
  label:  String!
  terms:  String
}

type PromotionCondition {
  id:             ID!
  type:           String!
  params:         JSON!
  paramsVersion:  Int!
  sortOrder:      Int!
}

type PromotionAction {
  id:             ID!
  type:           String!
  params:         JSON!
  paramsVersion:  Int!
  sortOrder:      Int!
}

type PromotionCode {
  id:                  ID!
  ruleId:              ID!
  code:                String!
  maxUses:             Int
  perCustomerLimit:    Int
  validFrom:           Time
  validTo:             Time
  restrictedToEmail:   String!
  usedCount:           Int!
  isActive:            Boolean!
  createdAt:           Time!
  updatedAt:           Time!
}

type PromotionCodeList {
  items:      [PromotionCode!]!
  totalCount: Int!
}

type PromotionRuleList {
  items:      [PromotionRule!]!
  totalCount: Int!
}

# Descriptor returned by the type-introspection queries. Lets the
# dashboard render a generic JSON-schema-driven form for each
# registered condition / action type, including those shipped by
# plugins. paramsSchema is JSON Schema (Draft-7-ish).
type PromotionTypeDescriptor {
  slug:         String!
  label:        String!
  description:  String!
  paramsSchema: JSON!
}

input PromotionConditionInput {
  type:           String!
  params:         JSON!
  paramsVersion:  Int
  sortOrder:      Int
}

input PromotionActionInput {
  type:           String!
  params:         JSON!
  paramsVersion:  Int
  sortOrder:      Int
}

input CreatePromotionRuleInput {
  slug:               String!
  name:               String!
  description:        String
  publicLabel:    String
  channelId:        ID
  requiresCode:       Boolean
  priority:           Int
  stopAfterApply:     PromotionStopMode
  exclusivityGroup:   String
  validFrom:          Time
  validTo:            Time
  scheduleJson:       JSON
  maxUses:            Int
  perCustomerLimit:   Int
  isActive:           Boolean
  conditions:         [PromotionConditionInput!]
  actions:            [PromotionActionInput!]
  labelMediaId:       ID
  bannerMediaId:      ID
  pillText:           String
  pillTextColor:      String
  pillBgColor:        String
}

input UpdatePromotionRuleInput {
  id:                 ID!
  slug:               String
  name:               String
  description:        String
  publicLabel:    String
  channelId:        ID
  requiresCode:       Boolean
  priority:           Int
  stopAfterApply:     PromotionStopMode
  exclusivityGroup:   String
  validFrom:          Time
  validTo:            Time
  scheduleJson:       JSON
  maxUses:            Int
  perCustomerLimit:   Int
  isActive:           Boolean
  conditions:         [PromotionConditionInput!]
  actions:            [PromotionActionInput!]
  labelMediaId:       ID
  bannerMediaId:      ID
  pillText:           String
  pillTextColor:      String
  pillBgColor:        String
}

input UpdatePromotionCodeInput {
  id:                  ID!
  code:                String
  maxUses:             Int
  perCustomerLimit:    Int
  validFrom:           Time
  validTo:             Time
  restrictedToEmail:   String
  isActive:            Boolean
}

extend type Query {
  promotionRules(limit: Int = 25, offset: Int = 0): PromotionRuleList!
  promotionRule(id: ID!): PromotionRule
  # Type introspection for the dashboard's rule editor.
  promotionConditionTypes: [PromotionTypeDescriptor!]!
  promotionActionTypes:    [PromotionTypeDescriptor!]!

  # Analytics: redemption counts + discount totals + revenue
  # impact per rule for a date range. Both bounds inclusive;
  # leave start NULL for "all time".
  promotionAnalytics(start: Time, end: Time): [PromotionRuleAnalytics!]!
  promotionAnalyticsTotals(start: Time, end: Time): PromotionAnalyticsTotals!

  # Daily redemption + discount series for trend charts. ruleId is
  # optional: omit for the all-rules hub trend, set for one promotion.
  promotionAnalyticsDaily(start: Time, end: Time, ruleId: ID): [PromotionAnalyticsDailyPoint!]!

}

extend type Mutation {
  createPromotionRule(input: CreatePromotionRuleInput!): PromotionRule!
  updatePromotionRule(input: UpdatePromotionRuleInput!): PromotionRule!
  deletePromotionRule(id: ID!): Boolean!

  # Generates `count` codes using the pattern grammar:
  #   [A] uppercase letter, [N] digit, [*] alphanumeric.
  # Prefix + suffix wrap the whole pattern.
  generatePromotionCodes(
    ruleId: ID!,
    pattern: String!,
    count:   Int!,
    prefix:  String,
    suffix:  String,
  ): [PromotionCode!]!

  updatePromotionCode(input: UpdatePromotionCodeInput!): PromotionCode!
  deletePromotionCode(id: ID!): Boolean!

  # Batch-update priorities by position in ruleIds. Output priorities
  # are sparse multiples of 10 so future inserts can slot between two
  # rules without a full renumber. Rules not in the array keep their
  # existing priority.
  reorderPromotionRules(ruleIds: [ID!]!): Boolean!

  # i18n storefront labels.
  upsertPromotionRuleContent(input: UpsertPromotionRuleContentInput!): PromotionRuleContent!
  deletePromotionRuleContent(ruleId: ID!, locale: String!): Boolean!

}

extend type Query {
  # Run the engine against a synthetic cart and return the full trace.
  # Used by the dashboard's "Simulate" button to debug "why didn't rule
  # X fire?" without touching real customer carts.
  simulatePromotion(input: PromotionSimulationInput!): PromotionSimulationResult!
}
