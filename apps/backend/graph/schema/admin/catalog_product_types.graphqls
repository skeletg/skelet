type ProductTypeAttribute {
  attribute: Attribute!
  sortOrder: Int!
  groupId:   ID
}

type AttributeGroup {
  id:         ID!
  name:       String!
  sortOrder:  Int!
  attributes: [ProductTypeAttribute!]!
}

type ProductType {
  id:                 ID!
  slug:               String!
  name:               String!
  isDigital:          Boolean!
  isShippingRequired: Boolean!
  # Auto-generated URL path template applied to products of this type whose
  # urlPathAuto is true. Empty string = no auto-generation. Tokens:
  # {slug}, {category}, {categorySlug}, {attr:<slug>}.
  urlTemplate:    String!
  # Whether new products of this type opt into inventory tracking by default.
  # Per-product override on Product.tracksInventoryOverride.
  tracksInventory:    Boolean!
  # Flat list of all assigned attributes (grouped and ungrouped).
  attributes:         [ProductTypeAttribute!]!
  # Grouped view - only attributes that belong to a group appear here.
  groups:             [AttributeGroup!]!
  metadata:           [MetadataItem!]!
  privateMetadata:    [MetadataItem!]!
  createdAt:          Time!
  updatedAt:          Time!
}

input CreateProductTypeInput {
  slug:               String!
  name:               String!
  isDigital:          Boolean
  isShippingRequired: Boolean
  # Empty or omitted = no auto-generated URL paths for products of this type.
  urlTemplate:    String
  # Default false. Toggles inventory tracking for new products of this type.
  tracksInventory:    Boolean
  metadata:           [MetadataInput!]
  privateMetadata:    [MetadataInput!]
}

# slug is immutable on update.
input UpdateProductTypeInput {
  id:                 ID!
  name:               String
  isDigital:          Boolean
  isShippingRequired: Boolean
  # Null = no change. Setting will pre-flight every product whose
  # urlPathAuto = true and override = "": if any can't render the new
  # template, the change is rejected.
  urlTemplate:    String
  tracksInventory:    Boolean
  metadata:           [MetadataInput!]
  privateMetadata:    [MetadataInput!]
}

# --- Queries (require catalog.view) ---
extend type Query {
  productTypes:         [ProductType!]!
  productType(id: ID!): ProductType!
}

# --- Mutations (require catalog.manage) ---
extend type Mutation {
  createProductType(input: CreateProductTypeInput!): ProductType!
  updateProductType(input: UpdateProductTypeInput!): ProductType!
  deleteProductType(id: ID!):                        Boolean!
  # Focused mutation for setting just the URL path template. Pre-flights
  # every affected product (auto + no override) and rejects the change if
  # any can't render against the new template.
  setProductTypeURLPathTemplate(productTypeId: ID!, template: String!): ProductType!

  assignAttribute(
    productTypeId: ID!
    attributeId:   ID!
    sortOrder:     Int
    groupId:       ID
  ): ProductType!
  unassignAttribute(productTypeId: ID!, attributeId: ID!): ProductType!

  createAttributeGroup(productTypeId: ID!, name: String!, sortOrder: Int): ProductType!
  updateAttributeGroup(id: ID!, name: String, sortOrder: Int): ProductType!
  deleteAttributeGroup(id: ID!): ProductType!
  # groupId null = move to ungrouped
  moveAttributeToGroup(productTypeId: ID!, attributeId: ID!, groupId: ID): ProductType!
}
