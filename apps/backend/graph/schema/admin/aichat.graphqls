# Admin chat - conversational Signals analyst. Config-gated (AI must be enabled)
# + permission-gated (only Signals sections the admin may view are included in
# the model's context). Suggestion-only analysis; conversation is ephemeral.

input SignalsChatMessage {
  # "user" or "assistant".
  role:    String!
  content: String!
}

type SignalsChatReply {
  reply: String!
}

# The dashboard page the operator is viewing when they ask, so the assistant can
# answer about "this page" / "this order" etc. entityType/entityId are set for
# detail pages (product/order/customer); path + label are always present.
input SignalsChatPage {
  path:       String!
  label:      String
  entityType: String
  entityId:   String
}

type ChatActionResult {
  ok:      Boolean!
  message: String!
}

extend type Mutation {
  # Analyze the Signals suite for a channel + lookback window. messages is the
  # running conversation (the server prepends the system prompt + data snapshot).
  # page (optional) is the operator's current dashboard location.
  signalsChat(channelId: ID!, sinceDays: Int, page: SignalsChatPage, messages: [SignalsChatMessage!]!): SignalsChatReply!

  # Run an action the assistant proposed (operator-confirmed). Dispatches to a small
  # whitelist of safe actions; each re-checks its own permission server-side.
  # argsJson is a JSON object of the action's arguments.
  runChatAction(action: String!, argsJson: String!): ChatActionResult!
}
