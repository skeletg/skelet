# Admin "Order Manager" cart console: search/list carts, view + edit a live cart
# (the shopper shares it), create carts (guest / existing / new customer),
# duplicate, and finish a cart into an order (via createDraftOrder sourceCartId).
# Read gated on orders.view, mutations on orders.update - both channel-scoped to
# the cart's channel. Money is int64 cents.
#
# Types are Admin-prefixed: the storefront schema has its own Cart/CartLine, and
# the front gqlgen autobinds to this admin model package - same-named types would
# collide and clobber the storefront Cart.

type AdminCart {
  id:            ID!
  customerId:    ID
  customerEmail: String       # null for guest carts
  customerName:  String       # null for guest carts
  channelId:     ID!
  currencyCode:  String!      # the channel's currency
  status:        String!      # active | converted | merged
  lines:         [AdminCartLine!]!
  subtotal:      Int!         # Σ line totals (estimate - no tax/shipping)
  itemCount:     Int!
  createdAt:     Time!
  updatedAt:     Time!
}

type AdminCartLine {
  id:          ID!
  productName: String!
  productSku:  String!
  unitPrice:   Int!
  quantity:    Float!
  totalPrice:  Int!
  # False for bundle/configured lines - admins can view + remove those but not
  # add new ones (v1 add is simple products only).
  isSimple:    Boolean!
  components:  [AdminCartLineComponent!]!
  options:     [AdminCartLineOption!]!
}

type AdminCartLineComponent {
  id:          ID!
  productSku:  String!
  productName: String!
  unitPrice:   Int!
  quantity:    Float!
}

type AdminCartLineOption {
  id:          ID!
  optionTitle: String!
  valueLabel:  String!
  textValue:   String!
  priceDelta:  Int!
  fileUrl:     String!
}

# Cart summary row for the console list.
type CartListItem {
  id:            ID!
  customerId:    ID
  customerEmail: String
  customerName:  String
  channelId:     ID!
  currencyCode:  String!
  status:        String!
  itemCount:     Int!
  subtotal:      Int!
  updatedAt:     Time!
}

type CartList {
  items:      [CartListItem!]!
  totalCount: Int!
}

extend type Query {
  # Channel-scoped cart search. abandoned=true narrows to active carts untouched
  # for a while (server threshold). customerId / search (email or name) / status
  # are optional filters. Paged.
  carts(
    channelId: ID!
    customerId: ID
    status: String
    abandoned: Boolean
    search: String
    limit: Int = 50
    offset: Int = 0
  ): CartList!
  cart(id: ID!): AdminCart!
}

# Option picks for an admin-entered configured line - mirrors the
# storefront's ProductOptionSelectionInput (server-side pricing and
# validation; nothing here is trusted for price).
input AdminCartLineOptionInput {
  optionId:    ID!
  valueIds:    [ID!]
  textValue:   String
  fileAssetId: ID
}

extend type Mutation {
  # Create/return a cart to build: guest (no customerId) → fresh cart; existing
  # customer → their one active cart on the channel.
  adminCreateCart(channelId: ID!, customerId: ID): AdminCart!
  # Live cart line editing (simple products; bundle lines view+remove only).
  # Price resolves server-side from the catalog. Passing options adds a
  # CONFIGURED line - same validation/pricing/snapshot contract as the
  # storefront's addConfiguredToCart, so phone orders can carry required
  # options.
  adminAddCartLine(cartId: ID!, productSku: String!, quantity: Float!, options: [AdminCartLineOptionInput!]): AdminCart!
  adminUpdateCartLine(cartId: ID!, lineId: ID!, quantity: Float!): AdminCart!
  adminRemoveCartLine(cartId: ID!, lineId: ID!): AdminCart!
  adminClearCart(cartId: ID!): AdminCart!
  # Clone a cart's simple lines into a fresh cart for the target (guest or
  # existing customer) on the source's channel.
  adminDuplicateCart(cartId: ID!, targetCustomerId: ID): AdminCart!
}
