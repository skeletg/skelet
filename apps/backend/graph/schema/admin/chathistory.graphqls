# Chat history - persisted per admin. Conversations are owned by the
# calling admin (resolvers scope every op to the auth'd admin id; a passed id
# can only ever match the caller's own rows).

type ChatMessage {
  role:    String!
  content: String!
}

type ChatConversationSummary {
  id:        ID!
  title:     String!
  updatedAt: Time!
}

type ChatConversation {
  id:        ID!
  title:     String!
  messages:  [ChatMessage!]!
  updatedAt: Time!
}

extend type Query {
  # The calling admin's recent conversations (titles only).
  chatConversations(limit: Int): [ChatConversationSummary!]!
  # One conversation with its messages; null if not found / not owned.
  chatConversation(id: ID!): ChatConversation
}

extend type Mutation {
  # Upsert: omit id to create, pass it to update the caller's own row. Returns
  # the conversation id. Title auto-derives from the first user message if blank.
  saveChatConversation(id: ID, channelId: ID, title: String, messages: [SignalsChatMessage!]!): ID!
  deleteChatConversation(id: ID!): Boolean!
}
