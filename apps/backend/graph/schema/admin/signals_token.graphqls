# Access to the Signals API, which runs as its own service and does not share this one's session store - the dashboard exchanges its admin session for a short-lived token carrying only what that surface checks

type ServiceToken {
  token:     String!
  expiresAt: Time!
}

extend type Query {
  # Needs no permission of its own, since it carries the caller's existing grants and opens nothing they do not already hold
  signalsToken: ServiceToken!
}
