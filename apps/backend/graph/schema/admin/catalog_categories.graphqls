# ---------- Category ----------

type CategoryContent {
  locale:           String!
  name:             String!
  shortDescription: JSON
  description:      JSON
  metaTitle:        String
  metaDescription:  String
  metaKeywords:     String
  updatedAt:        Time!
}

type Category {
  id:              ID!
  slug:            String!
  urlPath:         String!
  position:        Int!
  isPublished:     Boolean!
  seoNoindex:      Boolean!
  parent:          Category
  children:        [Category!]!
  ancestors:       [Category!]!
  level:           Int!
  coverImage:      CollectionCover
  metadata:        [MetadataItem!]!
  privateMetadata: [MetadataItem!]!
  content:          [CategoryContent!]!
  name:             String
  shortDescription: JSON
  description:      JSON
  metaTitle:        String
  metaDescription:  String
  # The locale code whose content row populates name/description/seo* above.
  # Tracks the requested locale when present, otherwise the global default
  # locale (resolved via fallback). Null only if the category has no content
  # rows at all.
  contentLocale:    String
  products:         [Product!]!
  # Number of products directly assigned to this category (resolver-computed,
  # excludes descendant categories). Cheap indexed COUNT - safe to select on
  # the category tree (e.g. picker hints), unlike the full `products` list.
  productCount:     Int!
  # Per-store listings - gates which storefronts render this category.
  # Without a row, a category is hidden on that store.
  listings:         [CategoryChannelListing!]!
  createdAt:        Time!
  updatedAt:        Time!
  # Per-category storefront filter presentation - rows pin a facet's order on this
  # category's PLP or hide it there entirely. Empty = attribute sortOrder default
  facetOverrides:   [FacetOverride!]!
}

# One attribute's presentation override on one category's/collection's storefront
# filter sidebar - shared by Category.facetOverrides and Collection.facetOverrides
type FacetOverride {
  attributeId:   ID!
  attributeSlug: String!
  # Position within the page's sidebar - overridden facets render in this
  # order ahead of every non-overridden one
  sortOrder:     Int!
  # Hidden facets never reach the storefront for this page, matching values
  # remain filterable through direct URLs
  hidden:        Boolean!
}

input FacetOverrideInput {
  attributeId: ID!
  hidden:      Boolean! = false
}

# Per-(category, channel) availability. Mirrors ProductChannelListing /
# BlogPostChannelListing. sortOrderOverride lets a store reorder a category
# within its parent without touching the global Position.
type CategoryChannelListing {
  categoryId:        ID!
  channelId:       ID!
  channel:         Channel!
  isPublished:       Boolean!
  sortOrderOverride: Int
  updatedAt:         Time!
}

input SetCategoryListingInput {
  categoryId:        ID!
  channelId:       ID!
  isPublished:       Boolean!
  # Pass null to clear the per-store sort override (inherit Category.position).
  sortOrderOverride: Int
}

input CreateCategoryInput {
  parentId:         ID
  slug:             String!
  position:         Int
  isPublished:      Boolean
  seoNoindex:       Boolean
  metadata:         [MetadataInput!]
  privateMetadata:  [MetadataInput!]
  locale:           String!
  name:             String!
  shortDescription: JSON
  description:      JSON
  metaTitle:        String
  metaDescription:  String
  metaKeywords:     String
}

input UpdateCategoryInput {
  id:              ID!
  parentId:        ID
  clearParent:     Boolean
  slug:            String
  position:        Int
  isPublished:     Boolean
  seoNoindex:      Boolean
  metadata:        [MetadataInput!]
  privateMetadata: [MetadataInput!]
}

input UpsertCategoryContentInput {
  locale:           String!
  name:             String!
  shortDescription: JSON
  description:      JSON
  metaTitle:        String
  metaDescription:  String
  metaKeywords:     String
}

input RequestCategoryCoverUploadInput {
  categoryId: ID!
  filename:   String!
  mimeType:   String!
  sizeBytes:  Int!
  altText:    String
}

# --- Queries (require catalog.view) ---
extend type Query {
  # When channelId is set, only categories listed-and-published on that
  # channel are returned - header-driven admin uses this in CHANNEL
  # mode so the tree matches what the storefront actually renders. Omit
  # for the global tree. Locale comes from the `Locale` header.
  rootCategories(channelId: ID): [Category!]!
  categoryChildren(parentId: ID!, channelId: ID): [Category!]!
  category(id: ID!): Category!
}

# --- Mutations (require catalog.manage) ---
extend type Mutation {
  createCategory(input: CreateCategoryInput!): Category!
  updateCategory(input: UpdateCategoryInput!): Category!
  # Replaces the category's whole filter-presentation set - order in the list is the
  # storefront order, an empty list resets to attribute-order defaults
  setCategoryFacetOverrides(categoryId: ID!, overrides: [FacetOverrideInput!]!): Category!
  deleteCategory(id: ID!): Boolean!
  upsertCategoryContent(categoryId: ID!, input: UpsertCategoryContentInput!): Category!
  deleteCategoryContent(categoryId: ID!, locale: String!): Boolean!
  addProductToCategory(productId: ID!, categoryId: ID!, position: Int, isPrimary: Boolean): Product!
  removeProductFromCategory(productId: ID!, categoryId: ID!): Product!
  setProductPrimaryCategory(productId: ID!, categoryId: ID!): Product!
  requestCategoryCoverUpload(input: RequestCategoryCoverUploadInput!): RequestCoverUploadPayload!
  confirmCategoryCoverUpload(categoryId: ID!, width: Int!, height: Int!): Category!
  clearCategoryCover(categoryId: ID!): Category!

  # Per-store listing operations - mirror setProductListing/clearProductListing.
  # Header-driven admin uses these to publish a category onto a single store.
  setCategoryListing(input: SetCategoryListingInput!): Category!
  clearCategoryListing(categoryId: ID!, channelId: ID!): Category!
}
