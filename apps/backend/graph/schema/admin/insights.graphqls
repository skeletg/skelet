# Proactive chat insights - a deterministic (no-LLM) scan of what changed,
# shown when the chat panel opens. Permission-gated per Signals/domain section
# (same gating as signalsChat); returns nothing for sections the admin can't see.

type SignalsInsight {
  level:  String! # "good" | "warn" | "info"
  title:  String!
  detail: String!
}

extend type Query {
  # Notable changes/anomalies for a channel over a lookback window (revenue Δ,
  # orders to fulfill, decided experiments, traffic, low stock). Cheap + cached-
  # read; no model call. Empty list when the admin has no Signals access.
  signalsInsights(channelId: ID!, sinceDays: Int): [SignalsInsight!]!
}
