enum UrlEntityType {
  PRODUCT
  COLLECTION
  CATEGORY
  BLOG_POST
  BLOG_CATEGORY
  BLOG_TAG
  BLOG_AUTHOR
  CMS_PAGE
}

type UrlRewritePage {
  totalCount: Int!
  items:      [UrlRewrite!]!
}

type UrlRewrite {
  id:              ID!
  entityType:      UrlEntityType!
  entityId:        ID!
  requestPath:     String!
  targetPath:      String
  redirectType:    Int!
  isAutogenerated: Boolean!
  description:     String
  # null = GLOBAL (applies to every channel); set = a per-channel override that
  # wins over the global row for the same requestPath on that channel.
  channelId:       ID
  createdAt:       Time!
  updatedAt:       Time!
}

# Returned by resolveUrl - tells the frontend which entity owns a URL path and
# whether it should do a redirect before rendering.
type UrlResolveResult {
  entityType:  UrlEntityType!
  entityId:    ID!
  redirectType: Int!
  redirectTo:   String
}

# A pickable internal link target: an entity that has a (global canonical) URL.
# Backs the CMS link-field picker - store (entityType, entityId) as a reference
# and it resolves to the live, channel-aware URL at render (follows renames).
type Linkable {
  entityType: UrlEntityType!
  entityId:   ID!
  label:      String!  # entity name/title (falls back to the path)
  path:       String!  # current global canonical request_path (no leading slash)
}

input CreateUrlRewriteInput {
  entityType:   UrlEntityType!
  entityId:     ID!
  requestPath:  String!
  targetPath:   String
  redirectType: Int!
  description:  String
  channelId:    ID   # null = global; set = per-channel override
}

input UpdateUrlRewriteInput {
  id:           ID!
  requestPath:  String
  targetPath:   String
  redirectType: Int
  description:  String
}

extend type Query {
  # Public - storefront calls this for SSR routing to identify which entity a path belongs to.
  # channelId scopes resolution to a channel (channel override wins over global).
  resolveUrl(path: String!, channelId: ID): UrlResolveResult

  # Admin - list rewrites, optionally filtered by entity and/or channel.
  # search matches request and target paths - limit defaults 50, max 500 - entityId
  # short-circuits to that entity's rows and ignores paging (an entity has a handful)
  urlRewrites(entityType: UrlEntityType, entityId: ID, channelId: ID, search: String, redirectTypes: [Int!], autogenerated: Boolean, limit: Int, offset: Int): UrlRewritePage!
  urlRewrite(id: ID!): UrlRewrite

  # Searchable list of internal-link targets (entities with a canonical URL) for
  # the CMS link picker. `search` matches the path; results carry entity labels.
  linkables(search: String, limit: Int): [Linkable!]!
}

extend type Mutation {
  createUrlRewrite(input: CreateUrlRewriteInput!): UrlRewrite!
  updateUrlRewrite(input: UpdateUrlRewriteInput!): UrlRewrite!
  deleteUrlRewrite(id: ID!): Boolean!

  # Plugin / microservice write surface. These three accept the
  # entity_type as a plain string so a Tier 1 plugin or external
  # service can register URL rewrites for its own entity types
  # (e.g. "loyalty_program") without a Skelet code change. The
  # caller is expected to authenticate as an integration with the
  # urlrewrite.manage permission slug.
  #
  # Core entity types (product, category, collection, blog_*,
  # cms_page) keep using the existing typed mutations and the
  # in-process urlrewrite.Service calls from catalog/blog/cms.

  # Upsert the canonical (redirect_type=0) row for an entity. Slug
  # change from the plugin side calls this with the new path, then
  # createUrlRewriteRedirect with the old.
  syncCanonicalUrlRewrite(input: SyncCanonicalUrlRewriteInput!): UrlRewrite!

  # Create a 301/302 redirect row from an old path to the entity's
  # canonical. The autogenerated flag is set so it doesn't show up
  # as an admin-editable row in the dashboard's rewrites list.
  createUrlRewriteRedirect(input: CreateUrlRewriteRedirectInput!): UrlRewrite!

  # Drop every rewrite row (canonical + all redirects) for an
  # entity. Returns the number of rows removed. Called on delete
  # so the table doesn't accumulate orphans pointing at a
  # nonexistent entity id.
  deleteUrlRewritesForEntity(entityType: String!, entityId: ID!): Int!
}

input SyncCanonicalUrlRewriteInput {
  entityType:  String!  # plugin-defined slug, e.g. "loyalty_program"
  entityId:    ID!
  requestPath: String!  # no leading slash; "rewards/gold-tier"
  channelId:   ID       # null = global; set = per-channel override
}

input CreateUrlRewriteRedirectInput {
  entityType:   String!
  entityId:     ID!
  fromPath:     String!  # the old path to redirect from
  redirectType: Int!     # 301 (permanent) or 302 (temporary)
  channelId:    ID       # null = global; set = per-channel override
}
