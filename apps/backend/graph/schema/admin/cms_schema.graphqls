enum CMSInputType {
  TEXT
  TEXTAREA
  RICHTEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  URL
  SELECT
  MULTISELECT
  ASSET
  ASSETS
  RELATIONSHIP
  JSON
}

enum CMSRelationshipTarget {
  CMS_PAGE
  BLOG_POST
  PRODUCT
  COLLECTION
  CATEGORY
}

# ==================== Attribute / Value / Group ====================

type CMSAttribute {
  id:                 ID!
  slug:               String!
  inputType:          CMSInputType!
  isTranslatable:     Boolean!
  isRequiredDefault:  Boolean!
  unit:               String
  validation:         JSON
  defaultValue:       JSON
  relationshipTarget: CMSRelationshipTarget
  metadata:           [MetadataItem!]!
  values:             [CMSAttributeValue!]!
  content:            CMSAttributeContent
  allContent:         [CMSAttributeContent!]!
  createdAt:          Time!
  updatedAt:          Time!
}

type CMSAttributeContent {
  locale:      String!
  name:        String!
  helperText:  String
  placeholder: String
  updatedAt:   Time!
}

type CMSAttributeValue {
  id:          ID!
  attributeId: ID!
  slug:        String!
  position:    Int!
  allContent:  [CMSAttributeValueContent!]!
  createdAt:   Time!
}

type CMSAttributeValueContent {
  locale:    String!
  name:      String!
  updatedAt: Time!
}

type CMSAttributeGroup {
  id:        ID!
  slug:      String!
  position:  Int!
  createdAt: Time!
  updatedAt: Time!
}

input CMSAttributeValueInput {
  slug:     String!
  position: Int
}

input CreateCMSAttributeInput {
  slug:               String!
  inputType:          CMSInputType!
  isTranslatable:     Boolean
  isRequiredDefault:  Boolean
  unit:               String
  validation:         JSON
  defaultValue:       JSON
  relationshipTarget: CMSRelationshipTarget
  metadata:           [MetadataInput!]
  values:             [CMSAttributeValueInput!]
}

input UpdateCMSAttributeInput {
  id:                 ID!
  isTranslatable:     Boolean
  isRequiredDefault:  Boolean
  unit:               String
  validation:         JSON
  defaultValue:       JSON
  relationshipTarget: CMSRelationshipTarget
  metadata:           [MetadataInput!]
}

input UpsertCMSAttributeContentInput {
  attributeId: ID!
  locale:      String!
  name:        String!
  helperText:  String
  placeholder: String
}

# ==================== Page Type ====================

type CMSPageType {
  id:         ID!
  slug:       String!
  icon:       String
  isSystem:   Boolean!
  position:   Int!
  # Global URL prefix for pages of this type ("" / null = bare path).
  rootSlug:          String
  # Per-channel root overrides (defer to rootSlug when a channel is absent).
  channelRoots:      [CMSPageTypeChannelRoot!]!
  # Starter block document seeded into new pages of this type.
  defaultBlocks:     JSON
  # Default meta-title pattern ({title}) + noindex inherited by pages when blank.
  defaultMetaTitle:  String
  defaultSeoNoindex: Boolean!
  # When true, only one page of this type may exist.
  isSingleton:       Boolean!
  # Number of pages currently of this type (for singleton enforcement in the UI).
  pageCount:         Int!
  content:    CMSPageTypeContent
  allContent: [CMSPageTypeContent!]!
  attributes: [CMSPageTypeAttribute!]!
  createdAt:  Time!
  updatedAt:  Time!
}

type CMSPageTypeChannelRoot {
  channelId: ID!
  rootSlug:  String!
}

type CMSPageTypeContent {
  locale:      String!
  name:        String!
  description: String
  updatedAt:   Time!
}

type CMSPageTypeAttribute {
  attribute:  CMSAttribute!
  groupId:    ID
  position:   Int!
  isRequired: Boolean!
  # Conditional visibility: show only when sibling conditionAttributeId holds
  # conditionValue. Null = always shown.
  conditionAttributeId: ID
  conditionValue:       String
}

input CreateCMSPageTypeInput {
  slug:        String!
  icon:        String
  isSystem:    Boolean
  position:    Int
  locale:      String!
  name:        String!
  description: String
}

input UpdateCMSPageTypeInput {
  id:       ID!
  icon:     String
  position: Int
}

input UpdateCMSPageTypeStructureInput {
  id:                ID!
  rootSlug:          String
  defaultMetaTitle:  String
  defaultSeoNoindex: Boolean
  isSingleton:       Boolean
}

input UpsertCMSPageTypeContentInput {
  pageTypeId:  ID!
  locale:      String!
  name:        String!
  description: String
}

input AssignCMSAttributeInput {
  pageTypeId:  ID!
  attributeId: ID!
  groupId:     ID
  position:    Int
  isRequired:  Boolean
  conditionAttributeId: ID
  conditionValue:       String
}

# ==================== Queries ====================

extend type Query {
  cmsAttribute(slug: String, id: ID): CMSAttribute
  cmsAttributes: [CMSAttribute!]!

  cmsAttributeGroups: [CMSAttributeGroup!]!

  cmsPageType(slug: String, id: ID): CMSPageType
  cmsPageTypes: [CMSPageType!]!
}

# ==================== Mutations ====================

extend type Mutation {
  # Schema-editing - gated by cms.types_manage
  createCMSAttribute(input: CreateCMSAttributeInput!): CMSAttribute!
  updateCMSAttribute(input: UpdateCMSAttributeInput!): CMSAttribute!
  deleteCMSAttribute(id: ID!): Boolean!
  upsertCMSAttributeContent(input: UpsertCMSAttributeContentInput!): CMSAttribute!
  addCMSAttributeValue(attributeId: ID!, slug: String!, position: Int): CMSAttributeValue!
  updateCMSAttributeValue(id: ID!, slug: String!, position: Int!): CMSAttributeValue!
  upsertCMSAttributeValueContent(valueId: ID!, locale: String!, name: String!): CMSAttribute!
  deleteCMSAttributeValue(id: ID!): Boolean!

  createCMSAttributeGroup(slug: String!, position: Int): CMSAttributeGroup!
  updateCMSAttributeGroup(id: ID!, slug: String!, position: Int!): CMSAttributeGroup!
  deleteCMSAttributeGroup(id: ID!): Boolean!

  createCMSPageType(input: CreateCMSPageTypeInput!): CMSPageType!
  updateCMSPageType(input: UpdateCMSPageTypeInput!): CMSPageType!
  deleteCMSPageType(id: ID!): Boolean!
  upsertCMSPageTypeContent(input: UpsertCMSPageTypeContentInput!): CMSPageType!
  updateCMSPageTypeStructure(input: UpdateCMSPageTypeStructureInput!): CMSPageType!
  setCMSPageTypeChannelRoot(pageTypeId: ID!, channelId: ID!, rootSlug: String!): CMSPageType!
  setCMSPageTypeDefaultBlocks(pageTypeId: ID!, blocks: JSON): CMSPageType!
  assignCMSAttribute(input: AssignCMSAttributeInput!): CMSPageType!
  unassignCMSAttribute(pageTypeId: ID!, attributeId: ID!): CMSPageType!
}
