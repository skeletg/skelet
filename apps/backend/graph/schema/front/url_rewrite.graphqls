# URL routing primitive for the storefront's catch-all page. Resolves
# any pretty path (e.g. "summer-collection/blue-shirt") to the
# underlying entity so the storefront doesn't have to encode separate
# routes per entity type.
#
# The backend owns the path→entity map via the `url_rewrites` table -
# every catalog/blog/CMS create/update syncs a canonical row through
# urlrewrite.SyncCanonical. Slug changes leave 301-redirect rows
# behind; this resolver surfaces those as `redirectTo` so the
# storefront can issue the redirect rather than render stale content.

enum RouteKind {
  PRODUCT
  CATEGORY
  COLLECTION
  BLOG_POST
  BLOG_CATEGORY
  BLOG_TAG
  BLOG_AUTHOR
  CMS_PAGE
  # External entity registered by a Tier 1 plugin or microservice via
  # the admin syncCanonicalUrlRewrite mutation. The actual entity_type
  # slug is in `pluginKind` - the storefront switches on that string
  # to pick its renderer.
  PLUGIN
}

# RouteResolution carries everything the storefront needs to decide
# what to render. `redirectTo` is non-null when the matched row is a
# 301 or 302; in that case the storefront issues the redirect and
# ignores the other fields. `redirectStatusCode` is 301 or 302 to
# match - the catch-all maps it back to next/navigation's redirect()
# permanent vs. temporary mode.
#
# When `kind == PLUGIN`, `pluginKind` is the plugin's entity_type slug
# (e.g. "loyalty_program"). For core kinds it's null.
type RouteResolution {
  kind:               RouteKind!
  pluginKind:         String
  entityId:           ID!
  redirectTo:         String
  redirectStatusCode: Int
}

extend type Query {
  # Resolves a storefront path to its entity. Returns null when no
  # row matches - the catch-all renders 404 in that case.
  route(path: String!): RouteResolution
}
