type Currency {
  code:           String!
  name:           String!
  symbol:         String!
  decimals:       Int!
  symbolPosition: String!
  isActive:       Boolean!
  sortOrder:      Int!
}

extend type Query {
  currencies(activeOnly: Boolean): [Currency!]!
  currency(code: String!):         Currency!
}

# A currency the storefront can PRESENT prices in (estimates converted
# from the channel's base currency at the stored ECB-refreshed rate).
# Orders are still charged in the channel currency - presentment is a
# display convenience, and the checkout says so.
type PresentmentCurrency {
  code:           String!
  name:           String!
  symbol:         String!
  decimals:       Int!
  symbolPosition: String!
  # Multiply a base-currency minor amount by this factor (then round)
  # to get the presented minor amount - decimals-aware, so JPY/BHD
  # convert correctly.
  factorFromBase: Float!
  rateUpdatedAt:  Time!
}

extend type Query {
  # Active currencies with FRESH rates (updated within 7 days),
  # excluding the current channel's own currency. Empty when the
  # channel's base has no rate row (cross rates need both sides).
  presentmentCurrencies: [PresentmentCurrency!]!
}
