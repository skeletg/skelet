# Digital downloads the customer has access to (granted when an order with a
# downloadable product is placed). downloadUrl is the token-gated link the
# storefront points at; hitting it consumes one use and redirects to the file.

type DownloadGrant {
  id:            ID!
  title:         String!
  productId:     ID!
  downloadUrl:   String!
  downloadsUsed: Int!
  maxDownloads:  Int
  expiresAt:     Time
  createdAt:     Time!
}

extend type Query {
  # The authenticated customer's download grants ("My downloads").
  myDownloads: [DownloadGrant!]!
}
