# Core's settings and secrets - cp to .env beside compose.yaml and fill in - what each var does: docs/env.md

APP_ENV=production
PORT=8080
# CORE_IMAGE=ghcr.io/you/skelet-core:v1
COMPOSE_PROFILES=bundled,valkey
CORE_BIND=127.0.0.1

# ---- REQUIRED ----
CORS_ALLOWED_ORIGINS=

# Session and link keys, each held only by the tiers that need it - skelet setup generates them all, docs/env.md has the map
# openssl rand -hex 32 - admin sessions, core alone
ADMIN_JWT_SECRET=
# Customer sessions, Ed25519 - core signs with the private key, the Signals processes get only the public one
CUSTOMER_JWT_PRIVATE_KEY=
CUSTOMER_JWT_PUBLIC_KEY=
# openssl rand -hex 32 - unsubscribe, open and click links, core and the Signals processes
EMAIL_LINK_SECRET=
# openssl rand -hex 32 - anonymous review votes, core and the storefront
REVIEW_VOTER_TOKEN_SECRET=
# openssl rand -hex 32 - signs core's calls on the Signals contract, core and the Signals processes alone
SIGNALS_SERVICE_SECRET=
# openssl rand -hex 32 - signs browser upload URLs when STORAGE_DRIVER=filesystem, core alone
STORAGE_SIGNING_KEY=
# openssl rand -base64 32, keep stable
CONFIG_ENCRYPTION_KEY=
STOREFRONT_REVALIDATE_SECRET=
TRUSTED_PROXY_KEY=

# ---- Datastores ----
DB_PASSWORD=
VALKEY_PASSWORD=
# Drop this for a managed/remote Postgres and use sslmode=require
ALLOW_INSECURE_DB=1
# DATABASE_URL=
# DATABASE_REPLICA_URL=postgres://skelet:CHANGE_ME@replica:5432/skelet?sslmode=require
# DB_MAX_CONNS=25
# ANALYTICS_DB_MAX_CONNS=8
# VALKEY_URL=
# VALKEY_CACHE_URL=
# VALKEY_CACHE_MAXMEMORY=512mb
# VALKEY_CACHE_MEMORY_LIMIT=640m
# VALKEY_LIMITS_URL=

# ---- Split-out tiers ---- Hands the scheduler, webhook-queue, outbox and import/export claim loops to the worker
WORKER_REPLICAS=1
MEDIA_REPLICAS=1
JOBS_EXTERNAL=true
# MEDIA_PORT=8083
# MEDIA_MAX_SOURCE_PIXELS=40000000
# MEDIA_RENDER_SLOTS=4
# MEDIA_DB_MAX_CONNS=2

# ---- Core to Signals ----
# Signals is the analytics and marketing stack (Lens, Synapse, Pulse, Prism) - false makes every Signals resolver refuse and stops its jobs, transactional mail keeps going
SIGNALS_ENABLED=true
# Where cmd/signals serves the wire contract core calls - its own listener, since grpc needs one
SIGNALS_GRPC_ADDR=signals:8092
# Where the suite serves /t - core proxies beacons there rather than serving them itself
SIGNALS_INGEST_URL=http://signals:8090
# Where /e is served (the open pixel and click redirect) - cmd/signals and the ingest tier both do, so this can follow SIGNALS_INGEST_URL
SIGNALS_URL=http://signals:8090
# SIGNALS_GRPC_TLS=true
# SIGNALS_GRPC_TLS_CA=/certs/ca.pem

# ---- Search ----
# OPTIONAL, empty falls back to the Postgres tier
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT_FILE=

# ---- Networking ----
TRUSTED_PROXIES=172.16.0.0/12
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# ---- Rate limiting ---- OFF by default. One flag turns on every per-IP limiter plus the failed-login lockout; per-surface budgets in docs/env.md. Production warns while it's off.
RATE_LIMIT_ENABLED=true
# LOGIN_LOCKOUT_ENABLED=true
# LOGIN_LOCKOUT_THRESHOLD=10

# ---- Storefront links / cache revalidation ----
STOREFRONT_URL=https://shop.example.com
DASHBOARD_URL=https://admin.example.com
STOREFRONT_REVALIDATE_URL=http://nextjs-vetrina:3000/api/revalidate

# ---- Email (transactional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_WEBHOOK_TOKEN=

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164
TWILIO_FROM=

# ---- Media storage (S3-compatible, required for media) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_PRESIGN_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
S3_USE_PATH_STYLE=false
STORAGE_MAX_UPLOAD_BYTES=10485760
# Required: a second bucket on the same endpoint and credentials that is NOT publicly readable. Exports, import
# uploads, form uploads and the media library's private half live there. The app refuses to start without it, and
# when a file in it can be fetched without credentials. PRIVATE_STORAGE_DIR on the filesystem driver
PRIVATE_S3_BUCKET=

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
APP_VERSION=
# LOG_LEVEL=info

# Admin AI assistant and review classification - needs an API key in Settings to do anything
AI_ENABLED=true

# ---- Optional tuning ----
# REQUEST_MAX_BODY_BYTES=8388608
# GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Moves a GraphQL endpoint behind an unguessable path segment - empty keeps /api/<surface>/graphql. Cuts scanner noise; the resolver permission gates are the actual access control. ADMIN_API_SLUG also moves the X-Api-Token machine API, so every integration and the dashboard's VITE_GRAPHQL_URL must be updated with it
ADMIN_API_SLUG=
FRONT_API_SLUG=
