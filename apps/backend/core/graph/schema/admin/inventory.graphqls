enum ReservationReason {
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_FULFILLED
  MANUAL_ADJUSTMENT
}

# How the inventory subsystem is operating. MULTI_LOCATION is the default - products have per-location levels and reservations drive salability.
# FLAT means an external ERP owns inventory: a single quantity column per product, no warehouses, no reservations, no per-channel allocation.
enum InventoryMode {
  MULTI_LOCATION
  FLAT
}

enum InventoryLocationType {
  RETAIL_STORE
  WAREHOUSE
  STORAGE
  DROPSHIPPER
  FULFILLMENT_PARTNER
  UNCLASSIFIED
}

input InventoryLocationFilter {
  types: [InventoryLocationType!]
  city: String
  isActive: Boolean
  storefrontVisible: Boolean
  pickupEnabled: Boolean
}

type InventoryLocation {
  id:        ID!
  slug:      String!
  name:      String!
  isActive:  Boolean!
  storefrontVisible: Boolean!
  # Purpose, independent of online pickup eligibility.
  type:      InventoryLocationType!
  # Structured address.
  line1:        String!
  line2:        String!
  city:         String!
  region:       String!
  postalCode:   String!
  countryCode:  String!  # ISO 3166-1 alpha-2; empty when unset
  # Resolved Country row (null when countryCode is empty or stale).
  country:      Country
  # Coordinates. Nullable; ~10cm precision (DECIMAL(9,6)).
  latitude:     Float
  longitude:    Float
  # Operational.
  timezone:           String!  # IANA, e.g. "Europe/Berlin"
  hours:              JSON!    # opaque per-day schedule
  email:              String!
  phone:              String!
  contactName:        String!
  externalReference:  String!  # ERP/WMS sync code
  # Click-and-collect: when enabled (and active), checkout offers this
  # location as a $0 pickup option.
  pickupEnabled:      Boolean!
  pickupInstructions: String!
  # Free-form bucket for everything else (carrier accounts, custom flags…).
  metadata:  [MetadataItem!]!
  createdAt: Time!
  updatedAt: Time!
}

# A channel's view of a location: the same row plus the per-store
# priority used during allocation (lower = preferred).
type ChannelInventoryLocation {
  location: InventoryLocation!
  priority: Int!
}

type InventoryLevel {
  location:          InventoryLocation!
  quantity:          Float!
  # Net of all reservation rows for this (item, location) pair. Negative
  # means held; positive means restocked beyond physical (rare, transient).
  reservedQuantity:  Float!
  # quantity - max(0, -reservedQuantity).
  available:         Float!
}

type InventoryItem {
  id:                 ID!
  product:            Product!
  tracked:            Boolean!
  backorderable:      Boolean!
  lowStockThreshold:  Float!
  levels:             [InventoryLevel!]!
  # Flat-mode authoritative quantity. Coexists with `levels` - in multi-location mode the dashboard ignores this column; in flat mode it's the only number that matters.
  quantity:           Float!
  # Audit trail for the last syncProductInventory write. Both null
  # until the first sync.
  lastSyncedAt:       Time
  lastSyncedSource:   String
}

# One alert row in the dashboard's low-stock list. Either a (product, location) pair where the level fell at or below the threshold, OR - when locationId is null - a "no stock anywhere yet" marker for a tracked product with threshold > 0 but no inventory_levels rows recorded. The unstocked case is sorted first (most urgent - setup gap).
type LowStockLevel {
  inventoryItemId:    ID!
  productId:          ID!
  productSlug:        String!
  productSku:         String!
  # Per-product display precision - the dashboard formats quantity and lowStockThreshold using these so a "fabric" product with quantityDecimals=2 reads as "1.50" not "1.5".
  quantityDecimals:   Int!
  quantityStep:       Float!
  # Null when this row is the "unstocked anywhere" marker.
  locationId:         ID
  locationSlug:       String
  locationName:       String
  quantity:           Float!
  lowStockThreshold:  Float!
  backorderable:      Boolean!
  updatedAt:          Time!
}

type InventoryReservation {
  id:              ID!
  inventoryItem:   InventoryItem!
  location:        InventoryLocation!
  quantityDelta:   Float!
  reason:          ReservationReason!
  orderId:         ID
  orderLineId:     ID
  adminId:         ID
  note:            String!
  createdAt:       Time!
}

input CreateInventoryLocationInput {
  pickupEnabled: Boolean
  pickupInstructions: String
  slug:               String!
  name:               String!
  storefrontVisible:  Boolean
  isActive:           Boolean
  type:               InventoryLocationType
  line1:              String
  line2:              String
  city:               String
  region:             String
  postalCode:         String
  countryCode:        String  # ISO 3166-1 alpha-2; uppercased before insert
  latitude:           Float   # -90..90
  longitude:          Float   # -180..180
  timezone:           String
  hours:              JSON
  email:              String
  phone:              String
  contactName:        String
  externalReference:  String
  metadata:           [MetadataInput!]
}

input UpdateInventoryLocationInput {
  pickupEnabled: Boolean
  pickupInstructions: String
  id:                 ID!
  name:               String
  storefrontVisible:  Boolean
  isActive:           Boolean
  type:               InventoryLocationType
  line1:              String
  line2:              String
  city:               String
  region:             String
  postalCode:         String
  countryCode:        String
  latitude:           Float
  longitude:          Float
  # Set true to explicitly clear both lat/lng (separate from passing the
  # values, since GraphQL can't distinguish "not provided" from "null").
  clearCoords:        Boolean
  timezone:           String
  hours:              JSON
  email:              String
  phone:              String
  contactName:        String
  externalReference:  String
  metadata:           [MetadataInput!]
}

input LocationAssignmentInput {
  locationId: ID!
  priority:   Int!
}

input AdjustInventoryLevelInput {
  productId:        ID!
  locationId:       ID!
  newQuantity:      Float!
  note:             String
}

# Flat-mode write. Identify the product by SKU (preferred, matches ERP record format) or by ID. Source attribution flows through to inventory_items.last_synced_source - pass the integration name, "manual", etc. Empty falls back to the calling admin.
input SyncProductInventoryInput {
  productSku:  String
  productId:   ID
  quantity:    Float!
  source:      String
}

type SyncProductInventoryFailure {
  productSku: String
  productId:  ID
  reason:     String!
}

type SyncProductInventoryBatchResult {
  succeeded: Int!
  failed:    [SyncProductInventoryFailure!]!
}

extend type Query {
  # All args optional for compatibility - search matches name/slug/city,
  # limit defaults to everything so pickers keep their full list
  inventoryLocations(search: String, limit: Int, offset: Int, filter: InventoryLocationFilter): [InventoryLocation!]!  # requires inventory.view
  inventoryLocationsCount(search: String, filter: InventoryLocationFilter): Int!             # requires inventory.view
  inventoryLocation(id: ID!): InventoryLocation!            # requires inventory.view
  # Returns the inventory item for a product, or null when the product
  # isn't tracked.
  productInventory(productId: ID!): InventoryItem           # requires inventory.view
  # Tracked items whose physical quantity is at or below their configured low_stock_threshold. Sorted most-urgent first, so the limit (default 200, max 1000) keeps the worst cases
  lowStockLevels(limit: Int): [LowStockLevel!]!             # requires inventory.view
  # Current global inventory mode. Drives whether the dashboard
  # renders the per-location editor or the flat-quantity input.
  inventoryMode: InventoryMode!                             # public - no permission gate
}

extend type Mutation {
  createInventoryLocation(input: CreateInventoryLocationInput!): InventoryLocation!  # requires inventory.manage
  updateInventoryLocation(input: UpdateInventoryLocationInput!): InventoryLocation!  # requires inventory.manage
  deleteInventoryLocation(id: ID!): Boolean!                                         # requires inventory.manage

  setChannelLocations(channelId: ID!, assignments: [LocationAssignmentInput!]!): Channel!  # requires inventory.manage

  setInventoryItemTracking(productId: ID!, tracked: Boolean!): InventoryItem!         # requires inventory.manage
  setInventoryItemBackorder(
    productId: ID!
    backorderable: Boolean!
    lowStockThreshold: Float
  ): InventoryItem!                                                                   # requires inventory.manage
  adjustInventoryLevel(input: AdjustInventoryLevelInput!): InventoryLevel!            # requires inventory.manage

  # Flat-mode writes. Overwrites the product's flat quantity column and stamps last_synced_at / last_synced_source. Idempotent. Permitted in both modes - in multi-location mode it updates the audit fields without affecting salability so mode flips later have a meaningful history.
  syncProductInventory(input: SyncProductInventoryInput!): InventoryItem!             # requires inventory.manage
  # Batched form for ERP daily sync runs. Partial success is the norm (one bad SKU shouldn't block the rest); the failed array carries per-item error reasons.
  syncProductInventoryBatch(items: [SyncProductInventoryInput!]!): SyncProductInventoryBatchResult!  # requires inventory.manage
}

extend type Mutation {
  # Toggle click-and-collect for a location (inventory.manage).
  setLocationPickup(id: ID!, enabled: Boolean!, instructions: String): InventoryLocation!
}
