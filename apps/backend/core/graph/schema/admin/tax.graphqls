# Tax rules are a predicate→effect engine (mirrors promotion rules). A rule owns typed conditions (ALL must pass) and typed effects (applied in order). Jurisdiction/rate are condition/effect types, introspected via taxConditionTypes / taxEffectTypes (each carries a JSON Schema the dashboard renders a params form from).

type TaxRule {
  id:               ID!
  channelId:        ID!
  name:             String!
  # Lower = evaluated earlier.
  priority:         Int!
  # Non-empty = at most one rule per group applies (most specific wins
  # via priority). Empty = always stacks.
  exclusivityGroup: String!
  sortOrder:        Int!
  isActive:         Boolean!
  conditions:       [TaxCondition!]!
  effects:          [TaxEffect!]!
  createdAt:        Time!
  updatedAt:        Time!
}

type TaxCondition {
  id:            ID!
  type:          String!
  params:        JSON!
  paramsVersion: Int!
  sortOrder:     Int!
}

type TaxEffect {
  id:            ID!
  type:          String!
  params:        JSON!
  paramsVersion: Int!
  sortOrder:     Int!
}

# Registry introspection - drives the dashboard rule builder.
type TaxTypeDescriptor {
  slug:         String!
  label:        String!
  description:  String!
  paramsSchema: JSON!
}

input TaxConditionInput {
  type:          String!
  params:        JSON!
  paramsVersion: Int
  sortOrder:     Int
}

input TaxEffectInput {
  type:          String!
  params:        JSON!
  paramsVersion: Int
  sortOrder:     Int
}

input CreateTaxRuleInput {
  channelId:        ID!
  name:             String!
  priority:         Int
  exclusivityGroup: String
  sortOrder:        Int
  isActive:         Boolean
  conditions:       [TaxConditionInput!]
  effects:          [TaxEffectInput!]
}

input UpdateTaxRuleInput {
  id:               ID!
  name:             String
  priority:         Int
  exclusivityGroup: String
  sortOrder:        Int
  isActive:         Boolean
  # Omit to leave unchanged; pass a (possibly empty) list to replace.
  conditions:       [TaxConditionInput!]
  effects:          [TaxEffectInput!]
}

extend type Query {
  # Omit channelId for the cross-channel view (every channel's rules);
  # pass it to scope to one channel.
  taxRules(channelId: ID): [TaxRule!]!
  taxRule(id: ID!): TaxRule
  taxConditionTypes: [TaxTypeDescriptor!]!
  taxEffectTypes: [TaxTypeDescriptor!]!
}

extend type Mutation {
  createTaxRule(input: CreateTaxRuleInput!): TaxRule!
  updateTaxRule(input: UpdateTaxRuleInput!): TaxRule!
  deleteTaxRule(id: ID!): Boolean!
  # Bulk-import a jurisdiction rate table as engine rules. CSV columns: name, country_code, rate_bps (required); region_code, priority, tax_class, exclusivity_group (optional; exclusivity_group defaults to "import" so country fallback + state rows don't stack). Returns the number of rules created. Requires settings.manage.
}
