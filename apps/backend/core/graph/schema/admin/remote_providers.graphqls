# Remote providers - merchant-registered HTTP endpoints that IMPLEMENT a pluggable role (shipping rates, tax, address validation, promotion logic, flow actions) instead of observing events. Core calls the endpoint mid-request; its signed JSON response is the answer.

enum RemoteProviderKind {
  SHIPPING_CARRIER
  TAX_PROVIDER
  ADDRESS_VALIDATOR
  PROMOTION_CONDITION
  PROMOTION_ACTION
  FRAUD_RISK
  CURRENCY_RATE
  PRICING
  RECOMMENDATION
  REVIEWS
  SEARCH
  CUSTOMER_SEGMENTS
  RETURNS_POLICY
  INVENTORY_AVAILABILITY
  SHIPPING_TRACKING
}

# What an invocation failure means to the consuming subsystem. FAIL_OPEN (default) falls back to core behavior (skip remote rates, run core tax, treat the address as valid). FAIL_CLOSED aborts the operation.
enum RemoteProviderFailurePolicy {
  FAIL_OPEN
  FAIL_CLOSED
}

type RemoteProvider {
  id:        ID!
  kind:      RemoteProviderKind!
  # Stable identifier referenced by consumers (promotion rules). Immutable
  # after create.
  slug:      String!
  name:      String!
  targetUrl: String!
  # Free-form JSON forwarded verbatim in every invocation envelope -
  # receiver-side API keys, rate tables, options.
  config:    JSON
  # Per-invocation HTTP timeout in ms. 0 = 5s default, max 30000.
  timeoutMs: Int!
  # Successful responses are cached per request payload for this many
  # seconds. 0 = no caching. Essential for hot paths (promotion checks).
  cacheTtlS: Int!
  failurePolicy: RemoteProviderFailurePolicy!
  # Null = global (all stores), non-null = scoped to that store.
  channel:  Channel
  isActive: Boolean!
  # Breaker state - same semantics as webhook circuits.
  circuit: WebhookCircuit!
  createdAt: Time!
  updatedAt: Time!
}

type CreateRemoteProviderPayload {
  rawSecret: String!
  provider:  RemoteProvider!
}

type RotateRemoteProviderSecretPayload {
  rawSecret: String!
  provider:  RemoteProvider!
}

input CreateRemoteProviderInput {
  kind:      RemoteProviderKind!
  slug:      String!
  name:      String!
  targetUrl: String!
  config:    JSON
  timeoutMs: Int
  cacheTtlS: Int
  # Default FAIL_OPEN.
  failurePolicy: RemoteProviderFailurePolicy
  channelId: ID
}

# Kind, slug and channel are immutable - consumers reference providers by
# (kind, slug), so changing them is indistinguishable from delete+recreate.
input UpdateRemoteProviderInput {
  id:        ID!
  name:      String
  targetUrl: String
  config:    JSON
  timeoutMs: Int
  cacheTtlS: Int
  failurePolicy: RemoteProviderFailurePolicy
}

extend type Query {
  remoteProviders(kind: RemoteProviderKind): [RemoteProvider!]!
  remoteProvider(id: ID!): RemoteProvider!
}

extend type Mutation {
  createRemoteProvider(input: CreateRemoteProviderInput!):   CreateRemoteProviderPayload!
  updateRemoteProvider(input: UpdateRemoteProviderInput!):   RemoteProvider!
  setRemoteProviderActive(id: ID!, active: Boolean!):        RemoteProvider!
  rotateRemoteProviderSecret(id: ID!):                       RotateRemoteProviderSecretPayload!
  deleteRemoteProvider(id: ID!):                             Boolean!
}
