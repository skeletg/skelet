# Unified emails: one list of standalone named emails (subject + typed blocks + styles), organized by an admin GROUP taxonomy, referenced by campaigns + flows and - when in the Transactional group and assigned a SLOT - used for transactional sends (order confirmation, …), with built-in fallback when a slot has no email. Same JSON block/style model as templates/campaigns. Gated on emails.view / emails.manage.

type EmailGroup {
  id:        ID!
  slug:      String!
  name:      String!
  isSystem:  Boolean!   # transactional / marketing - renamable, not deletable
  emailCount: Int!
}

type LibraryEmail {
  id:        ID!
  channelId: ID!
  name:      String!
  subject:   String!
  preheader: String!   # inbox-preview snippet; supports {{merge.tags}}
  blocks:    JSON!
  styles:    JSON!
  groupId:   ID
  slot:      String!    # '' = not a transactional slot; else order_confirmation, …
  createdAt: Time!
  updatedAt: Time!
}

input SaveLibraryEmailInput {
  id:        ID      # null = create
  channelId: ID!
  name:      String!
  subject:   String!
  preheader: String
  blocks:    JSON!
  styles:    JSON
  groupId:   ID
}

# One pre-send checklist finding.
type EmailWarning {
  severity: String!  # warn | info
  message:  String!
}

# A saved content snapshot of an email (version history).
type EmailRevision {
  id:        ID!
  name:      String!
  subject:   String!
  preheader: String!
  blocks:    JSON!
  styles:    JSON!
  createdAt: Time!
}

# One transactional slot and the email (if any) currently filling it for a channel.
type TransactionalSlot {
  slot:      String!   # order_confirmation, order_shipment, …
  label:     String!
  emailId:   ID        # null = built-in default is used
  emailName: String
}

# What one seeding run created - zeros mean the channel had it all already
type PulseStarterContent {
  blocks: Int!
  emails: Int!
  flows:  Int!
}

extend type Query {
  # Emails for a channel, optionally filtered to one group slug ('' = all).
  libraryEmails(channelId: ID!, groupSlug: String): [LibraryEmail!]!
  libraryEmail(id: ID!): LibraryEmail
  # The admin group taxonomy.
  emailGroups: [EmailGroup!]!
  # Transactional slots for a channel + which email fills each (built-in when null).
  transactionalSlots(channelId: ID!): [TransactionalSlot!]!
  # Pre-send checklist for an email (deliverability + quality warnings).
  emailPreflight(id: ID!): [EmailWarning!]!
  # Version history for an email (newest first).
  emailRevisions(id: ID!): [EmailRevision!]!
  # Live preview of draft content. customerId (optional) renders merge tags with
  # that customer's real data; otherwise sample data. Includes the preheader.
  renderLibraryPreview(channelId: ID!, customerId: ID, subject: String!, preheader: String, blocks: JSON!, styles: JSON): EmailPreview!
}

extend type Mutation {
  saveLibraryEmail(input: SaveLibraryEmailInput!): LibraryEmail!
  deleteLibraryEmail(id: ID!): Boolean!
  # Group taxonomy management (emails.manage). System groups can be renamed, not deleted.
  createEmailGroup(name: String!): EmailGroup!
  renameEmailGroup(id: ID!, name: String!): EmailGroup!
  deleteEmailGroup(id: ID!): Boolean!
  # Bind an email to a transactional slot (slot: "" clears it). One email per slot.
  assignEmailSlot(emailId: ID!, slot: String!): Boolean!
  # Restore a prior version of an email (records the restored state as a new revision).
  restoreEmailRevision(revisionId: ID!): LibraryEmail!
  # Pulse's starter content for a channel - the blocks, an email per transactional slot and an active flow that sends it (emails.manage + flows.manage)
  # Idempotent, and only ever on request - once seeded, receipts go out from these emails instead of core's templates
  seedPulseStarterContent(channelId: ID!): PulseStarterContent!
  # AI copy assist (requires AI configured). Subject-line suggestions from a
  # short description; rewrite a block of copy per an instruction.
  suggestEmailSubjects(context: String!, count: Int): [String!]!
  rewriteEmailText(text: String!, instruction: String): String!
}
