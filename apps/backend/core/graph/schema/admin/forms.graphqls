# Signup forms: storefront email-capture (popup / inline / flyout) feeding Pulse. A submission records marketing consent, optionally adds the subscriber to a segment, and fires the form_submitted flow trigger. Gated forms.view / forms.manage.

type SignupFormDisplay {
  trigger:       String!   # immediate | delay | scroll | exit_intent
  delaySeconds:  Int!
  scrollPercent: Int!
  frequencyDays: Int!
}

input SignupFormDisplayInput {
  trigger:       String!
  delaySeconds:  Int!
  scrollPercent: Int!
  frequencyDays: Int!
}

type SignupForm {
  id:              ID!
  channelId:       ID!
  slug:            String!
  name:            String!
  status:          String!   # draft | active
  type:            String!   # popup | inline | flyout
  heading:         String!
  body:            String!
  buttonLabel:     String!
  successMessage:  String!
  collectName:     Boolean!
  consentKind:     String!
  targetSegmentId: ID
  triggerFlow:     Boolean!
  display:         SignupFormDisplay!
  submissionCount: Int!
}

type SignupFormSubmission {
  email:      String!
  customerId: ID
  createdAt:  Time!
}

input SaveSignupFormInput {
  channelId:       ID!       # ignored on update
  slug:            String!
  name:            String!
  status:          String!
  type:            String!
  heading:         String!
  body:            String!
  buttonLabel:     String!
  successMessage:  String!
  collectName:     Boolean!
  consentKind:     String!
  targetSegmentId: ID
  triggerFlow:     Boolean!
  display:         SignupFormDisplayInput!
}

extend type Query {
  signupForms(channelId: ID!): [SignupForm!]!
  signupForm(id: ID!): SignupForm
  signupFormSubmissions(formId: ID!, limit: Int): [SignupFormSubmission!]!
}

extend type Mutation {
  createSignupForm(input: SaveSignupFormInput!): SignupForm!
  updateSignupForm(id: ID!, input: SaveSignupFormInput!): SignupForm!
  deleteSignupForm(id: ID!): Boolean!
}
