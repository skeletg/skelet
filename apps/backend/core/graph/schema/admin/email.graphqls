# Reusable email blocks - the shared component palette behind the /emails hub's builder. Per-key transactional TEMPLATES live in the email library (email_library.graphqls), where a slot binds a library email and `emailId null` falls back to the built-in default.

# A reusable block (the unified component). `fields` is an optional JSON array of {key,label,kind,required,default,options} - when present the block is parameterized. Its body is either composed `blocks` or an admin-authored `htmlTemplate` (sanitized at render).
type EmailBlockSnippet {
  channelId:    ID!
  slug:         String!
  name:         String!
  icon:         String!
  fields:       JSON!
  blocks:       JSON!
  htmlTemplate: String!
  textTemplate: String!
  css:          String!   # custom CSS for the HTML body (sanitized, injected as <style>)
  scripted:     Boolean!  # render the HTML body through Liquid (conditionals/loops/filters)
}

# Shared by the campaign and library preview renderers
type EmailPreview {
  subject: String!
  html:    String!
}

input SaveEmailBlockInput {
  channelId:    ID!
  slug:         String!
  name:         String!
  icon:         String
  fields:       JSON
  blocks:       JSON!
  htmlTemplate: String
  textTemplate: String
  css:          String
  scripted:     Boolean
}

extend type Query {
  emailBlocks(channelId: ID!): [EmailBlockSnippet!]!
}

extend type Mutation {
  saveEmailBlock(input: SaveEmailBlockInput!): EmailBlockSnippet!
  deleteEmailBlock(channelId: ID!, slug: String!): Boolean!
}
