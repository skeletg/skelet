# Signing in through an outside OpenID Connect provider, set up under Admin sign-in. Start, send the browser to authorizeUrl, and complete with the code and state the provider hands back plus the binding start returned, which only the starting browser holds.
type SsoStart {
  authorizeUrl: String!
  state:        String!
  binding:      String!
}

type SsoOption {
  label: String!
}

extend type Query {
  # Null while no provider is set up. Unauthenticated, for the sign-in page.
  adminSsoOption: SsoOption
}

extend type Mutation {
  # redirectUri is the dashboard page the provider returns to - it has to be on one of the dashboard's origins and registered at the provider.
  adminSsoStart(redirectUri: String!): SsoStart!
  adminSsoComplete(state: String!, code: String!, binding: String!): AdminAuthPayload!
}
