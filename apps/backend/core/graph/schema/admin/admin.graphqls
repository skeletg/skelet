type PermissionGroup {
  id:          ID!
  name:        String!
  slug:        String!
  permissions: [Permission!]!
}

type Permission {
  id:   ID!
  name: String!
  slug: String!
  # What holding this permission lets someone do, where the name doesn't say it.
  # Empty until a description is written for that slug.
  description: String!
}

type Role {
  id:          ID!
  name:        String!
  slug:        String!
  description: String!
  # One entry per (permission, channel?, locale?) tuple the role grants. A scope with both channel + locale null is the canonical "global" grant for that permission; one such row is enough to make the permission unbounded.
  scopes:      [RolePermissionScope!]!
  memberCount: Int!
  createdAt:   Time!
}

type RolePermissionScope {
  permission: Permission!
  # null = any channel
  channelId:  ID
  # null = any locale
  locale:     String
}

type AdminSession {
  id:           ID!
  ipAddress:    String
  userAgent:    String
  createdAt:    Time!
  lastActiveAt: Time!
  isCurrent:    Boolean!
}

type AdminUser {
  id:          ID!
  email:       String!
  firstName:   String!
  lastName:    String!
  isActive:    Boolean!
  isSuperuser: Boolean!
  # Two-factor (TOTP) enabled for this account.
  totpEnabled: Boolean!
  roles:       [Role!]!
  permissions: [Permission!]!
  sessions:    [AdminSession!]!
  # Last successful sign-in. Null for an account that has never signed in - session
  # rows get pruned, so this is the durable answer to "when were they last here".
  lastLoginAt: Time
  createdAt:   Time!
}

type AdminAuthPayload {
  accessToken:  String!
  refreshToken: String!
  admin:        AdminUser!
  # True only when this account had never signed in before - the dashboard shows its first-run introduction on the back of it. Later logins are always false, so it is a one-shot signal rather than something to poll.
  firstLogin:   Boolean!
}

input AdminLoginInput {
  email:    String!
  password: String!
  # Required (with valid credentials) when the account has TOTP enabled; a missing code fails with code TOTP_REQUIRED so the UI can prompt. Accepts a one-use recovery code as fallback.
  totpCode: String
}

# adminTotpSetup response: plaintext secret + otpauth:// URI to load into an
# authenticator app. Returned exactly once per setup call.
type AdminTotpSetup {
  secret:     String!
  otpauthUrl: String!
}

input CreateAdminInput {
  email:     String!
  password:  String!
  firstName: String!
  lastName:  String!
  roleSlugs: [String!]!
}

input UpdateAdminInput {
  firstName: String
  lastName:  String
  isActive:  Boolean
  roleSlugs: [String!]
}

input CreateRoleInput {
  name:        String!
  slug:        String!
  description: String
  # Required and non-empty. A role with zero scopes grants nothing -
  # the service rejects empty arrays with a validation error.
  scopes:      [RolePermissionScopeInput!]!
}

input UpdateRoleInput {
  name:        String
  description: String
  # null = leave scopes alone. Pass [] to wipe all grants (caller is expected to know what they're doing - the role becomes unusable until something is granted again).
  scopes:      [RolePermissionScopeInput!]
}

input RolePermissionScopeInput {
  permissionSlug: String!
  # null = any channel
  channelId:      ID
  # null = any locale
  locale:         String
}

extend type Query {
  me:                    AdminUser!
  permissionGroups:      [PermissionGroup!]!
  admins:                [AdminUser!]!
  admin(id: ID!):        AdminUser!
  roles:                 [Role!]!
  role(id: ID!):         Role!
  # DEV ONLY (APP_ENV=development): lists every admin account so the dashboard's dev user-switcher can offer one-click identity swaps for permission testing. Deliberately unauthenticated - a switched-to low-permission user must still be able to switch again. Errors in any other environment.
  devAdmins:             [AdminUser!]!
}

extend type Mutation {
  adminLogin(input: AdminLoginInput!):                            AdminAuthPayload!
  # Self-service password recovery (unauthenticated). requestAdminPasswordReset always returns true and never reveals whether the email exists; resetAdminPassword consumes the token from the emailed link, sets the new password, and revokes existing admin sessions.
  requestAdminPasswordReset(email: String!):                      Boolean!
  resetAdminPassword(token: String!, newPassword: String!):       Boolean!
  # Two-factor lifecycle for the CURRENT admin. Setup stages a pending secret; enable verifies the first code and returns ten one-use recovery codes (shown exactly once); disable requires a current or recovery code.
  adminTotpSetup:                                                 AdminTotpSetup!
  adminTotpEnable(code: String!):                                 [String!]!
  adminTotpDisable(code: String!):                                Boolean!
  refreshToken(token: String!):                                   AdminAuthPayload!
  # DEV ONLY (APP_ENV=development): issues a full session for the given admin without a password - the dev user-switcher's swap mechanism. Errors in any other environment.
  devImpersonate(adminId: ID!):                                   AdminAuthPayload!
  logout(token: String!):                                         Boolean!
  logoutOtherDevices(currentRefreshToken: String!):               Boolean!
  createAdmin(input: CreateAdminInput!):                          AdminUser!
  updateAdmin(id: ID!, input: UpdateAdminInput!):                 AdminUser!
  deleteAdmin(id: ID!):                                           Boolean!
  changePassword(currentPassword: String!, newPassword: String!): Boolean!
  createRole(input: CreateRoleInput!):                            Role!
  updateRole(id: ID!, input: UpdateRoleInput!):                   Role!
  deleteRole(id: ID!):                                            Boolean!
}
