# Custom form builder: admin-built forms (arbitrary fields, conditional visibility) placed on CMS pages via the `form` block, plus their submissions. `fields` and `settings` are JSON (the dashboard owns the shape; the backend validates it) - same approach as CMS block bodies. Gated webforms.view / webforms.manage; submissions gated webforms.submissions_view.

type WebForm {
  id:              ID!
  channelId:       ID!
  slug:            String!
  name:            String!
  status:          String!   # draft | active
  fields:          JSON!     # ordered Field[] (see dashboard webform types)
  settings:        JSON!     # FormSettings
  submissionCount: Int!
  # Set when soft-deleted; submissions stay readable and the storefront
  # stops serving the form.
  deletedAt:       Time
  createdAt:       Time!
  updatedAt:       Time!
}

input SaveWebFormInput {
  slug:     String        # ignored on update (slug is immutable)
  name:     String!
  status:   String!
  fields:   JSON!
  settings: JSON!
}

type WebFormSubmission {
  id:         ID!
  formId:     ID!
  answers:    JSON!
  files:      JSON!
  customerId: ID
  meta:       JSON!
  createdAt:  Time!
}

extend type Query {
  webForms(channelId: ID!, includeDeleted: Boolean): [WebForm!]!
  webForm(id: ID!): WebForm
  webFormSubmissions(formId: ID!, limit: Int, offset: Int): [WebFormSubmission!]!
  webFormSubmissionCount(formId: ID!): Int!
}

extend type Mutation {
  createWebForm(channelId: ID!, input: SaveWebFormInput!): WebForm!
  updateWebForm(id: ID!, input: SaveWebFormInput!): WebForm!
  # Soft delete - submissions stay readable and the storefront stops
  # serving the form. Restorable.
  deleteWebForm(id: ID!): Boolean!
  restoreWebForm(id: ID!): Boolean!
}
