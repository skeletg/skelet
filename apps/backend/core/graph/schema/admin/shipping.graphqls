enum ShippingCalcType {
  FLAT
  FREE
  FREE_ABOVE
}

type ShippingZone {
  id:          ID!
  channelId: ID!
  code:        String!
  name:        String!
  sortOrder:   Int!
  isActive:    Boolean!
  countries:   [String!]!
  methods:     [ShippingMethod!]!
  createdAt:   Time!
  updatedAt:   Time!
}

type ShippingMethod {
  id:             ID!
  zoneId:         ID!
  code:           String!
  name:           String!
  calcType:       ShippingCalcType!
  flatCents:      Int!
  freeAboveCents: Int!
  sortOrder:      Int!
  isActive:       Boolean!
  # "all" (offered to every country the zone covers) or "specific"
  # (only allowedCountries). Layered on top of the zone.
  countryMode:      String!
  allowedCountries: [String!]!
  # The delivery kind the method prices - ship_to_address (door delivery), parcel_locker (a pickup point the shopper picks) or carrier_point (the carrier delivers to the pickup point nearest the address).
  deliveryKind:     String!
  # Charge the price again for every started bundle of this many units - 5 means 1-5 units pay once, 6-10 twice. 0 charges once per shipment.
  unitsPerCharge:   Int!
  # Delivery days the method takes, counted from the day after the order - 0 gives no estimate.
  estimatedDays:      Int!
  # Saturday and Sunday count toward estimatedDays - off skips them, so a Friday order quoted 1 day arrives Monday.
  deliversOnWeekends: Boolean!
  # Prices for particular product types - their lines are priced by their own row instead of pooling into the method's price.
  typeRates:        [ShippingMethodTypeRate!]!
  createdAt:      Time!
  updatedAt:      Time!
}

input CreateShippingZoneInput {
  channelId: ID!
  code:        String!
  name:        String
  sortOrder:   Int
  isActive:    Boolean
  countries:   [String!]
}

input UpdateShippingZoneInput {
  id:        ID!
  code:      String
  name:      String
  sortOrder: Int
  isActive:  Boolean
  countries: [String!]
}

# A shipping method's own price for one product type - a fridge at 30€ per unit that never ships free, while everything else pools into the method's price.
type ShippingMethodTypeRate {
  productTypeId:        ID!
  productTypeName:      String!
  priceCents:           Int!
  unitsPerCharge:       Int!
  # The method's free-above threshold also waives this type's price.
  freeShippingEligible: Boolean!
}

input ShippingMethodTypeRateInput {
  productTypeId:        ID!
  priceCents:           Int!
  unitsPerCharge:       Int
  freeShippingEligible: Boolean
}

input CreateShippingMethodInput {
  zoneId:         ID!
  code:           String!
  name:           String
  calcType:       ShippingCalcType!
  flatCents:      Int
  freeAboveCents: Int
  sortOrder:      Int
  isActive:       Boolean
  countryMode:      String
  allowedCountries: [String!]
  deliveryKind:     String
  unitsPerCharge:   Int
  estimatedDays:      Int
  deliversOnWeekends: Boolean
  typeRates:        [ShippingMethodTypeRateInput!]
}

input UpdateShippingMethodInput {
  id:             ID!
  code:           String
  name:           String
  calcType:       ShippingCalcType
  flatCents:      Int
  freeAboveCents: Int
  sortOrder:      Int
  isActive:       Boolean
  countryMode:      String
  allowedCountries: [String!]
  deliveryKind:     String
  unitsPerCharge:   Int
  estimatedDays:      Int
  deliversOnWeekends: Boolean
  # Replaces the method's type rates when given.
  typeRates:        [ShippingMethodTypeRateInput!]
}

# A registered shipping carrier with its per-channel config. The built-in zones/methods engine is the "builtin" carrier; plugin carriers register additional slugs. carrierSlug + the (carrierSlug, methodCode) selection at checkout identify a carrier. Credentials (API keys) are edited via Settings → Shipping → <carrier>, not here.
type ShippingCarrierAdmin {
  carrierSlug:      String!
  displayName:      String!
  isEnabled:        Boolean!
  sortOrder:        Int!
  # "all" (ships everywhere) or "specific" (only allowedCountries).
  countryMode:      String!
  allowedCountries: [String!]!
  # Capability flags from the carrier's interface implementation.
  supportsTracking: Boolean!
  supportsLabels:   Boolean!
  # Saturday and Sunday count toward the carrier's delivery estimates on this channel. Always false for "builtin", whose methods each set their own.
  deliversOnWeekends: Boolean!
}

# An admin-defined carton for cartonization. The packer bins cart/order items into these boxes so weight/dimension-based carriers rate real multi-parcel shipments. maxWeightGrams is the GROSS limit (contents + boxWeightGrams tare); 0 = unlimited.
type ShippingBox {
  id:             ID!
  channelId:      ID!
  code:           String!
  name:           String!
  innerLengthMm:  Int!
  innerWidthMm:   Int!
  innerHeightMm:  Int!
  maxWeightGrams: Int!
  boxWeightGrams: Int!
  isActive:       Boolean!
  sortOrder:      Int!
  createdAt:      Time!
  updatedAt:      Time!
}

input ShippingBoxInput {
  channelId:      ID!
  code:           String!
  name:           String
  innerLengthMm:  Int!
  innerWidthMm:   Int!
  innerHeightMm:  Int!
  maxWeightGrams: Int
  boxWeightGrams: Int
  isActive:       Boolean
  sortOrder:      Int
}

extend type Query {
  shippingZones(channelId: ID!): [ShippingZone!]!
  shippingZone(id: ID!): ShippingZone
  # Every registered carrier with its per-channel enable/sort/country config.
  # A carrier not yet synced reports isEnabled=false (except builtin), countryMode="all".
  shippingCarriers(channelId: ID!): [ShippingCarrierAdmin!]!
  # The channel's cartons (active + inactive). Empty = cartonization off.
  shippingBoxes(channelId: ID!): [ShippingBox!]!
}

extend type Mutation {
  createShippingZone(input: CreateShippingZoneInput!): ShippingZone!
  updateShippingZone(input: UpdateShippingZoneInput!): ShippingZone!
  deleteShippingZone(id: ID!): Boolean!

  createShippingMethod(input: CreateShippingMethodInput!): ShippingMethod!
  updateShippingMethod(input: UpdateShippingMethodInput!): ShippingMethod!
  deleteShippingMethod(id: ID!): Boolean!

  # Create or update a carton (keyed on channel + code).
  upsertShippingBox(input: ShippingBoxInput!): ShippingBox!
  deleteShippingBox(id: ID!): Boolean!

  setShippingCarrierEnabled(channelId: ID!, carrierSlug: String!, enabled: Boolean!): ShippingCarrierAdmin!
  # mode is "all" or "specific"; countries is the allow-list (ignored when "all").
  setShippingCarrierCountries(channelId: ID!, carrierSlug: String!, mode: String!, countries: [String!]!): ShippingCarrierAdmin!
  # Whether Saturday and Sunday count toward the carrier's estimates. Refused for "builtin" - set it on each method instead.
  setShippingCarrierWeekendDelivery(channelId: ID!, carrierSlug: String!, deliversOnWeekends: Boolean!): ShippingCarrierAdmin!
}
