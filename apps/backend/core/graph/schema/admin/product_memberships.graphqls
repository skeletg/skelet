# Product.partOf - the inverse of the parent→child relationships. Given a product, report what it belongs to: its configurable parent, the bundles it's a selection in, and the grouped products it's a member of - each with the relationship metadata and the sibling collection. Lazy: nothing loads until a sub-field is selected.
extend type Product {
  partOf: ProductMemberships!
}

type ProductMemberships {
  # The configurable this product is a variant of, if any (0..1).
  configurable: ConfigurableMembership
  # Bundles where this product appears as a selection (0..N).
  bundles: [BundleMembership!]!
  # Grouped products this product is a member of (0..N).
  groupedProducts: [GroupedMembership!]!
}

type ConfigurableMembership {
  parent: Product!
  variantMode: VariantMode
  # This variant's values for the parent's configurable-option attributes
  # (e.g. Size = 205/55 R16).
  optionValues: [ProductAttributeValue!]!
  sortOrder: Int!
  # The other variants under the same configurable parent.
  siblings: [Product!]!
}

type BundleMembership {
  bundle: Product!
  # The option group within the bundle this product sits in.
  option: BundleOption!
  quantity: Float!
  isDefault: Boolean!
  sortOrder: Int!
  # The other selections in the same option group.
  siblings: [BundleSelection!]!
}

type GroupedMembership {
  groupedProduct: Product!
  defaultQuantity: Float!
  sortOrder: Int!
  # The other members of the same grouped product.
  siblings: [GroupedMember!]!
}
