# Marketing automation flows, built as a visual node graph. `graph` is the @xyflow node/edge document (JSON); the trigger lives on the flow row. Gated on flows.view (reads) / flows.manage (writes).

type Flow {
  id:            ID!
  channelId:     ID!
  name:          String!
  triggerType:   String!
  triggerConfig: JSON!
  graph:         JSON!
  status:        String!   # draft | active | paused | archived
  # Set when the flow was deleted. Deletion is soft: the row and its runs survive, but an archived-by-deletion flow enrolls nobody and is hidden from the list unless includeDeleted is set. Distinct from status="archived", which is an operator lifecycle state.
  deletedAt:     Time
  createdAt:     Time!
  updatedAt:     Time!
}

input SaveFlowInput {
  channelId:     ID!       # ignored on update (a flow's channel is fixed)
  name:          String!
  triggerType:   String!
  triggerConfig: JSON
  graph:         JSON!
}

extend type Query {
  flows(channelId: ID!, includeDeleted: Boolean): [Flow!]!
  flow(id: ID!): Flow
  # Trigger types the composer should offer (only the wired ones).
  flowTriggerTypes: [String!]!
  # Merge tags available to flow email nodes (same set as campaigns).
  flowMergeTags: [String!]!
  # Split-condition kinds the composer should offer. Registered rather than fixed: the suite that owns a condition's data contributes it, so an install without that suite never offers a condition nothing can answer.
  flowConditionKinds: [String!]!
}

extend type Mutation {
  createFlow(input: SaveFlowInput!): Flow!
  updateFlow(id: ID!, input: SaveFlowInput!): Flow!
  # Soft delete - keeps flow_runs and their history intact. Restorable.
  deleteFlow(id: ID!): Boolean!
  restoreFlow(id: ID!): Boolean!
  setFlowStatus(id: ID!, status: String!): Flow!
}
