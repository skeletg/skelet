# Digital downloads the customer has access to (granted once an order with a downloadable product is paid or its card authorized, and expired if it is cancelled, voided or refunded). downloadUrl is the token-gated link the storefront points at; hitting it consumes one use and serves the file - streamed when it lives in our storage, redirected when it is hosted elsewhere.

type DownloadGrant {
  id:            ID!
  title:         String!
  productId:     ID!
  downloadUrl:   String!
  downloadsUsed: Int!
  maxDownloads:  Int
  expiresAt:     Time
  createdAt:     Time!
}

extend type Query {
  # The authenticated customer's download grants ("My downloads").
  myDownloads: [DownloadGrant!]!
}
